+/// Native arguments copied off the stack (prototype P1): inline up to 16.
+#[cfg(feature = "nested_callbacks")]
+mod smallvec_args {
+    use super::Value;
+    pub enum Args {
+        Inline([Value; 16], usize),
+        Heap(Vec<Value>),
+    }
+    impl Args {
+        pub fn from(src: &[Value]) -> Args {
+            if src.len() <= 16 {
+                let mut a = [Value::Unit; 16];
+                a[..src.len()].copy_from_slice(src);
+                Args::Inline(a, src.len())
+            } else {
+                Args::Heap(src.to_vec())
+            }
+        }
+        pub fn as_slice(&self) -> &[Value] {
+            match self {
+                Args::Inline(a, n) => &a[..*n],
+                Args::Heap(v) => v,
+            }
+        }
+    }
+}
