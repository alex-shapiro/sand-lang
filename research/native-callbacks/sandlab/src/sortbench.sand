// Shared by sand_stackless and sand_nested. Times only the sort; median of 5.
import time

var seed = 1
fn rnd() -> int {
    seed = (seed * 1103515245 + 12345) % 2147483648
    seed
}
let data = (0..200000).map(_ => rnd())
let expected = data.sorted()

fn bench(run: fn([int]) -> ()) -> duration {
    var times: [duration] = []
    for _ in 0..5 {
        let xs = data.copy()
        let sw = time.Stopwatch()
        run(xs)
        times.push(sw.elapsed())
        assert(xs == expected)
    }
    times.sort()
    times[2]
}

// The same bottom-up merge sort as the natives, written in Sand. Sorts `xs` in place.
fn merge_sort<T>(xs: [T], less: fn(T, T) -> bool) {
    var src = xs.copy()
    var dst = xs.copy()
    let n = xs.len()
    var width = 1
    while width < n {
        var lo = 0
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n }
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n }
            var i = lo
            var j = mid
            var k = lo
            while i < mid and j < hi {
                if less(src[j], src[i]) {
                    dst[k] = src[j]
                    j += 1
                } else {
                    dst[k] = src[i]
                    i += 1
                }
                k += 1
            }
            while i < mid {
                dst[k] = src[i]
                i += 1
                k += 1
            }
            while j < hi {
                dst[k] = src[j]
                j += 1
                k += 1
            }
            lo = hi
        }
        let t = src
        src = dst
        dst = t
        width *= 2
    }
    for i in 0..n {
        xs[i] = src[i]
    }
}
