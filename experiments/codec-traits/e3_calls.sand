// E3: the cost of one call of each kind in a loop of 1,000,000 calls.
import codec
import time

trait Get { fn get(self) -> int }
impl Get for int { fn get(self) -> int { self } }
fn direct(x: int) -> int { x }
fn generic<T: Get>(x: T) -> int { x.get() }
fn result(x: int) -> Result<int> { Ok(x) }

fn best(f: fn() -> int) -> int {
    var b = -1
    for _ in 0..5 {
        let sw = time.Stopwatch()
        let _ = f()
        let t = sw.elapsed().nanos()
        if b < 0 or t < b { b = t }
    }
    b / 1000000
}
let w = codec.Writer()
let r = codec.Reader("[" + ["1"; 1000000].join(",") + "]")
let n = 1000000
print("loop     \(best(() => { var t = 0; for i in 0..n { t += i }; t }))")
print("direct   \(best(() => { var t = 0; for i in 0..n { t += direct(i) }; t }))")
print("dict     \(best(() => { var t = 0; for i in 0..n { t += generic(i) }; t }))")
print("result?  \(best(() => { var t = 0; for i in 0..n { t += result(i).unwrap() }; t }))")
print("native   \(best(() => { var t = 0; for i in 0..n { w.null(); t += 1 }; t }))")
print("native_r \(best(() => { let rr = codec.Reader("[" + ["1"; 1000000].join(",") + "]"); rr.begin_list().unwrap(); var t = 0; for i in 0..n { let _ = rr.next_item(); t += rr.int().unwrap() }; t }))")
print("native_raw \(best(() => { let rr = codec.Reader("[" + ["1"; 1000000].join(",") + "]"); rr.begin_list().unwrap(); var t = 0; for i in 0..n { let _ = rr.next_item_raw(); t += rr.int_raw() }; t }))")
print("parse_only \(best(() => { let rr = codec.Reader("[" + ["1"; 1000000].join(",") + "]"); 0 }))")
