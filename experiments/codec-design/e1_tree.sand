// E1: cost of a Sand-level, dictionary-dispatched codec over an intermediate
// `json.Json` tree (the aeson design), compared with the native walks.
// Run: sand run e1_tree.sand -- N
import json
import time
import env

enum Status { Active, Suspended(reason: str), Banned(int, str) }
struct Address { street: str, city: str, zip: str? }
struct User { id: int, name: str, email: str, score: float, active: bool, tags: [str], address: Address, status: Status, logins: [int], meta: [str: int] }
struct Doc { users: [User] }

fn make(n: int) -> Doc {
    let users: [User] = []
    for i in 0..n {
        let status = if i % 3 == 0 { Status.Active } else if i % 3 == 1 { Status.Suspended(reason: "r\(i)") } else { Status.Banned(i, "b") }
        let zip = if i % 4 == 0 { None } else { Some("0\(i % 1000)") }
        let address = Address(street: "\(i) Main St", city: "Springfield", zip: zip)
        users.push(User(id: i, name: "user \(i)", email: "u\(i)@example.com", score: i.to_float() * 0.5, active: i % 2 == 0, tags: ["a", "b\(i % 5)"], address: address, status: status, logins: [i, i + 1, i + 2], meta: ["k": i, "j": i * 2]))
    }
    Doc(users: users)
}

fn bad(what: str) -> Error { Error("expected \(what)", kind: "parse") }

trait FromJson {
    fn from_json(j: json.Json) -> Result<Self>
}
trait ToJson {
    fn to_json(self) -> json.Json
}

impl FromJson for int {
    fn from_json(j: json.Json) -> Result<int> { Ok(j.as_int() ?? return Err(bad("int"))) }
}
impl FromJson for float {
    fn from_json(j: json.Json) -> Result<float> { Ok(j.as_float() ?? return Err(bad("float"))) }
}
impl FromJson for bool {
    fn from_json(j: json.Json) -> Result<bool> { Ok(j.as_bool() ?? return Err(bad("bool"))) }
}
impl FromJson for str {
    fn from_json(j: json.Json) -> Result<str> { Ok(j.as_str() ?? return Err(bad("str"))) }
}
impl<T: FromJson> FromJson for [T] {
    fn from_json(j: json.Json) -> Result<[T]> {
        let items = j.as_list() ?? return Err(bad("list"))
        let out: [T] = []
        for x in items {
            out.push(T.from_json(x)?)
        }
        Ok(out)
    }
}
impl<V: FromJson> FromJson for [str: V] {
    fn from_json(j: json.Json) -> Result<[str: V]> {
        let m = j.as_map() ?? return Err(bad("map"))
        let out: [str: V] = [:]
        for (k, v) in m {
            out[k] = V.from_json(v)?
        }
        Ok(out)
    }
}
impl<T: FromJson> FromJson for T? {
    fn from_json(j: json.Json) -> Result<T?> {
        if j.is_null() { Ok(None) } else { Ok(Some(T.from_json(j)?)) }
    }
}
fn field<T: FromJson>(m: [str: json.Json], k: str) -> Result<T> {
    T.from_json(m.get(k) ?? json.Json.Null)
}
impl FromJson for Address {
    fn from_json(j: json.Json) -> Result<Address> {
        let m = j.as_map() ?? return Err(bad("Address"))
        Ok(Address(street: field(m, "street")?, city: field(m, "city")?, zip: field(m, "zip")?))
    }
}
impl FromJson for Status {
    fn from_json(j: json.Json) -> Result<Status> {
        match j {
            json.Json.Str(s) if s == "Active" => Ok(Status.Active)
            json.Json.Obj(m) => {
                if let Some(p) = m.get("Suspended") {
                    let f = p.as_map() ?? return Err(bad("payload"))
                    return Ok(Status.Suspended(reason: field(f, "reason")?))
                }
                if let Some(p) = m.get("Banned") {
                    let xs = p.as_list() ?? return Err(bad("payload"))
                    return Ok(Status.Banned(int.from_json(xs[0])?, str.from_json(xs[1])?))
                }
                Err(bad("Status"))
            }
            _ => Err(bad("Status"))
        }
    }
}
impl FromJson for User {
    fn from_json(j: json.Json) -> Result<User> {
        let m = j.as_map() ?? return Err(bad("User"))
        Ok(User(id: field(m, "id")?, name: field(m, "name")?, email: field(m, "email")?, score: field(m, "score")?, active: field(m, "active")?, tags: field(m, "tags")?, address: field(m, "address")?, status: field(m, "status")?, logins: field(m, "logins")?, meta: field(m, "meta")?))
    }
}
impl FromJson for Doc {
    fn from_json(j: json.Json) -> Result<Doc> {
        let m = j.as_map() ?? return Err(bad("Doc"))
        Ok(Doc(users: field(m, "users")?))
    }
}

impl ToJson for int { fn to_json(self) -> json.Json { json.Json.Int(self) } }
impl ToJson for float { fn to_json(self) -> json.Json { json.Json.Float(self) } }
impl ToJson for bool { fn to_json(self) -> json.Json { json.Json.Bool(self) } }
impl ToJson for str { fn to_json(self) -> json.Json { json.Json.Str(self) } }
impl<T: ToJson> ToJson for [T] {
    fn to_json(self) -> json.Json { json.Json.Arr(self.map(x => x.to_json())) }
}
impl<V: ToJson> ToJson for [str: V] {
    fn to_json(self) -> json.Json {
        let out: [str: json.Json] = [:]
        for (k, v) in self { out[k] = v.to_json() }
        json.Json.Obj(out)
    }
}
impl<T: ToJson> ToJson for T? {
    fn to_json(self) -> json.Json { match self { Some(x) => x.to_json(), None => json.Json.Null } }
}
impl ToJson for Address {
    fn to_json(self) -> json.Json { json.Json.Obj(["street": self.street.to_json(), "city": self.city.to_json(), "zip": self.zip.to_json()]) }
}
impl ToJson for Status {
    fn to_json(self) -> json.Json {
        match self {
            Active => json.Json.Str("Active")
            Suspended(reason) => json.Json.Obj(["Suspended": json.Json.Obj(["reason": reason.to_json()])])
            Banned(a, b) => json.Json.Obj(["Banned": json.Json.Arr([a.to_json(), b.to_json()])])
        }
    }
}
impl ToJson for User {
    fn to_json(self) -> json.Json {
        json.Json.Obj(["id": self.id.to_json(), "name": self.name.to_json(), "email": self.email.to_json(), "score": self.score.to_json(), "active": self.active.to_json(), "tags": self.tags.to_json(), "address": self.address.to_json(), "status": self.status.to_json(), "logins": self.logins.to_json(), "meta": self.meta.to_json()])
    }
}
impl ToJson for Doc {
    fn to_json(self) -> json.Json { json.Json.Obj(["users": self.users.to_json()]) }
}

fn best(reps: int, f: fn() -> int) -> int {
    var b = -1
    for _ in 0..reps {
        let sw = time.Stopwatch()
        let _ = f()
        let t = sw.elapsed().nanos()
        if b < 0 or t < b { b = t }
    }
    b
}

let n = (env.args().get(0) ?? "5000").parse_int() ?? 5000
let doc = make(n)
let text = json.encode(doc)
let a: Doc = json.decode(text).unwrap()
let b = Doc.from_json(json.parse(text).unwrap()).unwrap()
assert(a == doc and b == doc, "decoders disagree")
assert(json.encode(doc.to_json()) == text, "encoders disagree")
let reps = 7
let native_decode = best(reps, () => { let d: Doc = json.decode(text).unwrap(); d.users.len() })
let parse_only = best(reps, () => { let p = json.parse(text).unwrap(); [p].len() })
let tree_decode = best(reps, () => Doc.from_json(json.parse(text).unwrap()).unwrap().users.len())
let native_encode = best(reps, () => json.encode(doc).len())
let native_to_json = best(reps, () => [json.to_json(doc)].len())
let tree_encode = best(reps, () => json.encode(doc.to_json()).len())
let tree_to_json = best(reps, () => [doc.to_json()].len())
print("ns per user, n=\(n)")
print("native_decode \(native_decode / n)")
print("parse_only    \(parse_only / n)")
print("tree_decode   \(tree_decode / n)")
print("native_encode \(native_encode / n)")
print("native_to_json \(native_to_json / n)")
print("tree_to_json  \(tree_to_json / n)")
print("tree_encode   \(tree_encode / n)")
