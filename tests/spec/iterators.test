=== help on iterator items
help(Iter.from_fn)
help([1].iter().map)
--- stdout
fn Iter.from_fn(f: fn() -> T?) -> Iter<T>

Constructs an iterator that calls `f()` to produce each element until
`f()` returns `None`.
fn Iter.map<U>(self, f: fn(T) -> U) -> Iter<U>

Applies `f` lazily to each element.

=== fused pipelines match unfused ones
// A pipeline written in one expression is fused into one loop; bound to a
// variable first, it runs through the adapters' closures. Both must agree.
let xs = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3]
fn check(name: str, a: [str], b: [str]) {
    if a != b {
        fail("\(name): \(a) != \(b)")
    }
}
var log: [str] = []
fn src(n: int) -> Iter<int> {
    var i = 0
    Iter.from_fn(() => {
        i += 1
        log.push("pull\(i)")
        if i <= n { Some(i) } else { None }
    })
}
let fused = src(20).inspect(x => log.push("see\(x)")).filter(x => x % 3 != 0).map(x => x * 2).skip(2).take(4).enumerate().to_list()
let a = log
log = []
let it = src(20).inspect(x => log.push("see\(x)")).filter(x => x % 3 != 0).map(x => x * 2).skip(2).take(4).enumerate()
let unfused = it.to_list()
check("pipeline", a, log)
print((fused == unfused, fused))
log = []
for x in src(10).skip_while(x => x < 3).take_while(x => x < 7).filter_map(x => if x % 2 == 0 { Some(x * 10) } else { None }) {
    log.push("body\(x)")
}
let b = log
log = []
let it2 = src(10).skip_while(x => x < 3).take_while(x => x < 7).filter_map(x => if x % 2 == 0 { Some(x * 10) } else { None })
for x in it2 {
    log.push("body\(x)")
}
check("for", b, log)
print(b)
print((xs.iter().map(x => x * 2).sum(), xs.iter().map(x => x.to_float()).sum(), xs.iter().count()))
print((xs.iter().any(x => x > 8), xs.iter().all(x => x > 1), xs.iter().find(x => x > 4), xs.iter().fold(0, (a, x) => a * 2 + x)))
log = []
src(5).take(0).each(x => log.push("never"))
print(log)
--- stdout
(true, [(0, 8), (1, 10), (2, 14), (3, 16)])
["pull1", "pull2", "pull3", "pull4", "body40", "pull5", "pull6", "body60", "pull7"]
(78, 39.0, 10)
(true, false, Some(5), 2725)
[]

=== fused loops keep break, continue and labels
let xs = [1, 2, 3, 4, 5, 6, 7, 8]
var out = []
@outer for i in 0..3 {
    for x in xs.iter().map(x => x + i).filter(x => x % 2 == 0) {
        if x == 4 { continue }
        if x > 6 { continue @outer }
        out.push((i, x))
    }
}
print(out)
var n = 0
for x in xs.iter().take(100) {
    if x > 3 { break }
    n += x
}
print(n)
--- stdout
[(0, 2), (0, 6), (1, 2), (1, 6), (2, 6)]
6

=== eager list methods with lambdas
let xs = [3, 1, 4, 1, 5]
let ys = [1, 2, 3]
// The length is read when the loop starts: elements pushed meanwhile are not visited.
print(ys.map(y => {
    ys.push(y)
    y * 10
}))
print(ys)
print((xs.count(x => x == 1), xs.take_while(x => x != 5), xs.filter_map(x => if x > 3 { Some(x) } else { None })))
print(xs.map(x => [1, 2].map(y => x * y)))
print(xs.map(x => {
    if x > 3 {
        return 0
    }
    x
}))
var t = 0
(1..=4).each(i => {
    t += i
})
print((t, (0..4).map(i => i * i), (0..10).filter(i => i % 4 == 0)))
