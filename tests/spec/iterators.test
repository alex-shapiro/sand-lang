2c
["a", "b", "z", "d"]
0 1p
1 2q
[5, 27]

=== map and set iterators keep the entries they started with
// Iterators read the entries in place; a change of the map or set first
// moves them to a copy, so none of these changes is seen.
let m = ["a": 1, "b": 2, "c": 3]
let it = m.iter()
print(it.next())
m["b"] = 20
m.remove("c")
m["d"] = 4
print(it.to_list())
print(it.next())
print(m)
// Two iterators made at different times see different entries.
let n = [1: "x", 2: "y"]
let i1 = n.iter()
n[3] = "z"
let i2 = n.iter()
n.clear()
print(i1.to_list())
print(i2.to_list())
print(n.iter().next())
// Removals that compact the entries (renumbering their slots).
let big: [int: int] = [:]
for k in 0..100 { big[k] = k }
let bi = big.iter()
var total = 0
for (k, v) in bi {
    if k == 0 {
        for j in 1..90 { big.remove(j) }
    }
    total += v
}
print(total)
print(big.len())
let s = set([1, 2, 3])
let si = s.iter()
s.remove(1)
s.add(4)
print(si.to_list())
// A map with removed entries: the iterator skips them.
let h: [int: int] = [:]
for k in 0..40 { h[k] = k }
for k in 0..30 { h.remove(k) }
print(h.iter().map(e => e.0).to_list())
--- stdout
