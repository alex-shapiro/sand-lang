=== an iterator built from another iterator
fn words(text: str) -> Iter<str> {
    let chars = text.chars_iter()
    fn next() -> str? {
        var current = ""
        for c in chars {
            if c.is_alnum() {
                current += c
            } else if not current.is_empty() {
                return Some(current)
            }
        }
        if current.is_empty() { None } else { Some(current) }
    }
    Iter { next }
}
print(words("  the quick, brown fox ").map(w => w.to_upper()).to_list())
print(words("a b c d").step_by(2).join("+"))
--- stdout
["THE", "QUICK", "BROWN", "FOX"]
a+c

