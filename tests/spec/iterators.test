3
2
1
[8, 6, 4, 2]
[2, 1]
Some(5)
[4, 3]
2

=== iterators through the traits of type parameters
struct Countdown {
    var n: int
}
impl Iterator<int> for Countdown {
    fn next(self) -> int? {
        if self.n <= 0 {
            return None
        }
        self.n -= 1
        Some(self.n + 1)
    }
}
fn total<I: Iterator<int>>(it: I) -> int {
    var s = 0
    for x in it {
        s += x
    }
    s
}
fn collect<T, I>(it: I) -> [T] where I: Iterator<T> {
    it.iter().to_list()
}
fn sum_all<T: Num, I: Iterator<T>>(it: I) -> T {
    it.iter().sum()
}
print(total(Countdown { n: 4 }))
print(total([5, 6].iter()))
print(collect(Countdown { n: 2 }))
print(collect("ab".chars_iter()))
let fs: [float] = []
print(sum_all(fs.iter()))
print(sum_all(Countdown { n: 3 }))
