=== for loops and comprehensions over iterators
for (i, w) in ["x", "y"].iter().enumerate() {
    print("\(i): \(w)")
}
print([x * 2 for x in (0..10).iter().filter(x => x % 3 == 0)])
print([w: w.len() for w in ["ab", "c"].iter()])
var total = 0
@outer for x in Iter.count_from(1) {
    for y in (0..x).iter() {
        if y == 3 { continue @outer }
        if x > 5 { break @outer }
        total += y
    }
}
print(total)
fn first_square_over(n: int) -> int {
    for x in Iter.count_from(1).map(x => x * x) {
        defer print("checked \(x)")
        if x > n { return x }
    }
    -1
}
print(first_square_over(5))
