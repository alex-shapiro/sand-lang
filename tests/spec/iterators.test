=== for loops over enumerate keep its snapshot
// `for (i, x) in xs.enumerate()` runs without building the pairs, over the
// elements as they were when `enumerate` was called.
let xs = ["a", "b", "c"]
for (i, x) in xs.enumerate() {
    if i == 0 { xs.push("d") }
    if i == 1 { xs[2] = "z" }
    if x == "b" { continue }
    print("\(i)\(x)")
}
print(xs)
for (i, (n, s)) in [(1, "p"), (2, "q")].enumerate() { print("\(i) \(n)\(s)") }
print([i * 10 + x for (i, x) in [5, 6, 7].enumerate() if i != 1])
