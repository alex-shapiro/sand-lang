=== user-defined iterators
struct Countdown {
    var n: int
}
impl Iterator<int> for Countdown {
    fn next(self) -> int? {
        if self.n <= 0 {
            return None
        }
        self.n -= 1
        Some(self.n + 1)
    }
}
for x in (Countdown { n: 3 }) {
    print(x)
}
print(Countdown { n: 4 }.iter().map(x => x * 2).to_list())
print([x for x in (Countdown { n: 2 })])
let c = Countdown { n: 5 }
print(c.next())
print(c.iter().take(2).to_list())
print(c.n)
