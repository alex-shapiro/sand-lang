=== for loops over maps and sets see the entries they started with
let m = ["a": 1, "b": 2, "c": 3]
for (k, v) in m {
    print("\(k)=\(v)")
    m.remove("c")
    m["b"] = 99
    m[k + k] = v
}
print(m)
// Nested loops over one set, changing it in the inner one.
let s = set([1, 2])
for x in s {
    for y in s {
        s.add(x * 10 + y)
    }
}
print(s.to_list())
// A loop left early, then a change, then a new loop.
let n = [1: 1, 2: 2, 3: 3]
for (k, _) in n {
    if k == 2 { break }
}
n.remove(1)
for (k, v) in n { print("\(k) \(v)") }
// Clearing while iterating.
let c = set(["p", "q"])
for x in c {
    c.clear()
    print(x)
}
print(c.len())
--- stdout
a=1
b=2
c=3
["a": 1, "b": 99, "aa": 1, "bb": 2, "cc": 3]
[1, 2, 11, 12, 21, 22, 31, 32]
2 2
3 3
p
q
0
