print((at(0)..at(3)).fold(at(7), (a, i) => a + i))
for i in (at(5)..at(7)).iter().map(i => i + 100) {
    log.push(i)
}
print((at(2)..at(8)).skip_while(i => i < at(4)))
print(log)
