=== ranges encode as objects with their bounds
import json
print(json.encode(1..4))
print(json.encode(-2..=5, indent: 2))
let r: Range = json.decode("{\"end\": 3, \"start\": 1, \"step\": 9}")?
print(r)
let i: Range = json.decode(json.encode(0..=0))?
print(i)
print(json.to_json(0..2))
let bad: Result<Range> = json.decode("{\"start\": 1}")
print(bad)
--- stdout
{"start":1,"end":4}
{
  "start": -2,
  "end": 5,
  "inclusive": true
}
1..3
0..=0
Obj(["start": Int(0), "end": Int(2)])
Err(Error { kind: "parse", message: "$: missing field `end`" })

=== map keys are strings, numbers, bools, variant names, or value types
import json
import time
enum Mode { Read, Write }
print(json.encode([1: "a", -2: "b"]))
print(json.encode([true: 1]))
print(json.encode([Mode.Read: 1, Mode.Write: 2]))
print(json.encode([2s: 1]))
print(json.encode([time.date(2024, 2, 29)?: 1]))
let m: [Mode: int] = json.decode("{\"Write\": 2}")?
print(m)
let d: [time.PlainDate: int] = json.decode("{\"2024-02-29\": 1}")?
print(d)
--- stdout
{"1":"a","-2":"b"}
{"true":1}
{"Read":1,"Write":2}
{"2000000000":1}
{"2024-02-29":1}
[Write: 2]
[2024-02-29: 1]

=== other map keys fail when encoded or decoded
import json
let empty: [(int, int): str] = json.decode("{}")?
print(empty)
let keyed: Result<[(int, int): str]> = json.decode("{\"a\": \"b\"}")
print(keyed)
print(json.encode([(1, 2): "a"]))
--- stdout
[:]
Err(Error { kind: "invalid", message: "$: cannot decode map keys of type (int, int)" })
--- fail
a JSON object key must be a string, int, duration, bool, payload-less variant, or value type

=== encode decode roundtrip
import json
struct P { x: int, y: [float], name: str, ok: bool }
let p = P { x: -5, y: [1.5, 2.0], name: "q\"", ok: true }
let back: P = json.decode(json.encode(p))?
print(back == p)
--- stdout
true

