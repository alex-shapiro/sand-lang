=== recursion that nests reflect type arguments without end aborts
import json
fn deep<reflect T: Decode>(n: int, witness: [T]) -> int {
    if n == 0 {
        let r: Result<T> = json.decode("[[1]]")
        print(r.is_ok())
        return 0
    }
    let w: [[T]] = []
    deep(n - 1, w) + 1
}
let w: [int] = []
print(deep(2, w))
print(deep(256, w))
print(deep(1000, w))
--- stdout
true
2
false
256
--- fail
limit: the description of a type argument is nested too deeply

=== long type names in messages are cut
import json
enum Wrapped<T> { Of(T) }
fn wrap<reflect T: Decode>(text: str) -> Result<Wrapped<T>> { json.decode(text) }
let direct: Result<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<int>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> = json.decode("1")
let built: Result<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<Wrapped<int>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> = wrap("1")
print(direct)
print(direct == built)
