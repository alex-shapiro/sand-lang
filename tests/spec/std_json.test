true

=== trait methods cannot be reflect
trait Load { fn load<reflect T>() -> int }
--- error
1: the type parameters of trait and impl methods cannot be `reflect`

=== local functions cannot be reflect
import json
fn outer<reflect T: Decode>(text: str) -> Result<[T]> {
    fn inner<reflect U: Decode>(t: str) -> Result<[U]> { json.decode(t) }
    fn same(t: str) -> Result<[T]> { json.decode(t) }
    let _ = same(text)
    inner(text)
}
--- error
3: local functions cannot have `reflect` type parameters; declare the function at the top level

=== functions with reflect type parameters are values
import json
fn load<reflect T: Decode>(text: str) -> Result<[T]> { json.decode(text) }
fn loader<reflect T: Decode>(x: T?) -> fn(str) -> Result<[T]> { load }
let f: fn(str) -> Result<[int]> = load
let g: fn(str) -> Result<str> = json.decode
let none: bool? = None
print(f("[1, 2]"))
print(g("\"a\""))
print(loader(none)("[true]"))
--- stdout
Ok([1, 2])
Ok("a")
Ok([true])

=== a function value needs the reflect type argument
fn size<reflect T>(x: int) -> int { x }
let f = size
--- error
2: cannot infer type for this function value; add a type annotation

=== decode cannot build sets, maps or types whose type arguments lack required traits
import json
struct Bag<T: Hash> { items: Set<T> }
struct Outer<U> { b: Bag<U> }
struct Rows { seen: Set<[int]> }
fn load<reflect T: Decode>(s: str) -> Result<Set<T>> { json.decode(s) }
fn load_hashed<reflect T: Decode + Hash>(s: str) -> Result<Set<T>> { json.decode(s) }
fn any<reflect T: Decode>(s: str) -> Result<T> { json.decode(s) }
let a: Result<Set<[int]>> = json.decode("[[1], [1]]")
let b: Result<[float: int]> = json.decode("{}")
let c: Result<Outer<[int]>> = json.decode("{\"b\": {\"items\": [[1], [1]]}}")
let d: Result<Rows> = json.decode("{\"seen\": []}")
let e: Result<Set<[int]>> = any("[]")
let f: Result<Set<int>> = load_hashed("[1]")
--- error
4: [int] does not implement `Hash` (required for the elements of Set<[int]>)
5: type parameter `T` does not implement `Hash` (required for the elements of Set<T>); add `T: Hash`
8: this call cannot build Set<[int]>: [int] does not implement `Hash` (required for the elements of Set<[int]>)
9: [float: int]: float does not implement `Hash` (required for the keys of [float: int])
10: Outer<[int]>: [int] does not implement `Hash` (required for Outer<[int]>)
12: Set<[int]>: [int] does not implement `Hash`

=== decode builds a set of hashable elements once
import json
fn load_hashed<reflect T: Decode + Hash>(s: str) -> Result<Set<T>> { json.decode(s) }
let f: Result<Set<int>> = load_hashed("[1, 1, 2]")
print(f)
