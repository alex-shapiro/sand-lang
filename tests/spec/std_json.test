=== decode fills missing fields with their constant defaults
import json
enum Mode { Read, Write }
struct All {
    u: () = ()
    b: bool = true
    n: int = -3
    x: float = -1.5
    d: duration = -2s
    s: str = "q\""
    xs: [int] = []
    m: [str: int] = [:]
    o: int? = None
    some: Mode? = Some(Mode.Write)
    mode: Mode = Mode.Read
    neg: int = --4
    r: Range = -1..3
    ri: Range = 0..=2
}
let a: All = json.decode("{}")?
print(a)
print(a == All())
--- stdout
All(u: (), b: true, n: -3, x: -1.5, d: -2s, s: "q\"", xs: [], m: [:], o: None, some: Some(Write), mode: Read, neg: 4, r: -1..3, ri: 0..=2)
true

=== decode fills missing fields with defaults built from constructors
import json
enum Shape { Circle(float), Rect(w: float, h: float), Dot }
struct Config {
    server: Server = Server()
    backup: Server = Server(port: 81, ..Server())
    shapes: [Shape] = [Shape.Rect(w: 1.0, h: 2.0), Shape.Dot]
    size: (int, int) = (80, 24)
    late: Late = Late(n: 3)
    tags: Set<str> = Set(["b", "a"])
}
struct Server { host: str = "localhost", port: int = 80, routes: [str: [int]] = ["a": [1, 2]] }
struct Late { n: int, m: (str, bool)? = Some(("x", true)) }
let c: Config = json.decode("{\"size\": [1, 2]}")?
print(c)
print(c == Config(size: (1, 2)))
--- stdout
Config(server: Server(host: "localhost", port: 80, routes: ["a": [1, 2]]), backup: Server(host: "localhost", port: 81, routes: ["a": [1, 2]]), shapes: [Rect(1.0, 2.0), Dot], size: (1, 2), late: Late(n: 3, m: Some(("x", true))), tags: Set(["b", "a"]))
true

=== decode runs the defaults that are not constants, as a construction does
import json
var calls: [str] = []
fn note(what: str, n: int) -> int {
    calls.push(what)
    n
}
struct Item { id: int = note("item.id", calls.len()), name: str }
struct Inner { a: int = note("inner.a", 1), b: str = "b" }
struct Outer {
    x: int = note("outer.x", 2)
    inner: Inner
    y: int? = Some(note("outer.y", 3))
    items: Set<Item> = Set()
    label: str = "a" + "b"
}
let o: Outer = json.decode(r#"{"inner": {}, "items": [{"name": "p"}, {"name": "q", "id": 9}, {"name": "p"}]}"#)?
print(o)
print(calls)
let bad: Result<Outer> = json.decode(r#"{"inner": {}, "items": 5}"#)
print(bad)
print(calls.len())
--- stdout
Outer(x: 2, inner: Inner(a: 1, b: "b"), y: Some(3), items: Set([Item(id: 1, name: "p"), Item(id: 9, name: "q"), Item(id: 2, name: "p")]), label: "ab")
["inner.a", "item.id", "item.id", "outer.x", "outer.y"]
Err(Error(message: "$.items: expected array", kind: "parse"))
5

=== a default that never ends fails decode as it fails a construction
import json
struct Loop { next: [Loop] = [Loop()] }
let l: Result<Loop> = json.decode("{}")
print(l)
--- fail
stack overflow

=== decode defaults can suspend their task
import json
import task
fn later(n: int) -> int {
    task.sleep(1ms)
    n
}
struct S { a: int = later(4), b: [int] = [later(5)] }
let s: [S] = json.decode("[{}, {\"a\": 1}]")?
print(s)
--- stdout
[S(a: 4, b: [5]), S(a: 1, b: [5])]

=== functions pass reflect type parameters on to json.decode
import json
struct P { x: int, y: int = 7 }
fn load<reflect T: Decode>(text: str) -> Result<T> { json.decode(text) }
fn both<reflect T: Decode>(a: str, b: str = "{\"x\": 3}", first: Result<T> = load(b)) -> Result<(T, T)> {
    let later: fn() -> Result<T> = () => load(a)
    Ok((first?, later()?))
}
let p: P = load("{\"x\": 1}")?
print(p)
let t: (P, P) = both("{\"x\": 2}")?
print(t)
let n: Result<(int, int)> = both("1", "2")
print(n)
--- stdout
P(x: 1, y: 7)
(P(x: 3, y: 7), P(x: 2, y: 7))
Ok((2, 1))

=== the type parameters of reflect type arguments must be reflect
import json
fn plain<T: Decode>(text: str) -> Result<T> { json.decode(text) }
fn mixed<reflect T: Decode, U: Decode>(text: str) -> Result<(T, [U])> { json.decode(text) }
--- error
2: this call needs a description of `T` at run time, so `T` must be a `reflect` type parameter of this function
3: this call needs a description of `(T, [U])` at run time, so `U` must be a `reflect` type parameter of this function

=== reflect type arguments build on reflect type parameters
import json
struct P { x: int, tag: str = "t\(1 + 1)" }
struct Page<T> { items: [T], next: str? = None }
enum Shape<T> { Dot, Named(label: str, value: T) }
struct Tree<T> { value: T, kids: [Tree<T>] = [] }
fn all<reflect T: Decode>(text: str) -> Result<[T]> { json.decode(text) }
fn page<reflect T: Decode>(text: str) -> Result<Page<T>> { json.decode(text) }
fn pair<reflect A: Decode + Hash, reflect B: Decode>(text: str) -> Result<(A, [str: B], Set<A>)> { json.decode(text) }
fn shape<reflect T: Decode>(text: str) -> Result<Shape<T>> { json.decode(text) }
fn tree<reflect T: Decode>(text: str) -> Result<Tree<T>> { json.decode(text) }
fn later<reflect T: Decode>(text: str) -> fn() -> Result<T?> { () => json.decode(text) }
fn pages<reflect T: Decode>(text: str) -> Result<Page<Page<T>>> { page(text) }
let a: [P] = all("[{\"x\": 1}, {\"x\": 2}]")?
print(a)
let p: Result<Page<P>> = page("{\"items\": [{\"y\": 3}]}")
print(p)
let t: (int, [str: P], Set<int>) = pair("[1, {\"k\": {\"x\": 5}}, [2, 2]]")?
print(t)
let s: Shape<P> = shape("{\"Named\": {\"label\": \"n\", \"value\": {\"x\": 9}}}")?
print(s)
let bad: Result<Shape<[P]>> = shape("{\"Other\": 1}")
print(bad)
let tr: Tree<str> = tree("{\"value\": \"a\", \"kids\": [{\"value\": \"b\", \"kids\": [{\"value\": \"c\"}]}]}")?
