=== encode rejects functions at compile time
import json
struct Job { name: str, run: fn() -> int }
print(json.encode([Job(name: "a", run: () => 1)]))
--- error
3: [Job] does not implement `Encode` because field `run` of `Job` has type `fn() -> int`

=== to_json rejects tasks at compile time
import json
let t = spawn 1
print(json.to_json(Some(t)))
--- error
3: Task<int>? does not implement `Encode` because the payload of variant `Some` of `Task<int>?` has type `Task<int>`

=== encode through a type parameter needs Encode
import json
fn dump<T>(x: T) -> str {
    json.encode(x)
}
fn bounded<T: Encode>(x: T) -> str {
    json.encode(x)
}
print(bounded(() => 1))
--- error
3: type parameter `T` does not implement `Encode`; add `T: Encode`
8: fn() -> int does not implement `Encode`

=== data implements Encode, and Num implies it
import json
struct P<T> { x: T, tags: Set<str> }
fn dump<T: Encode>(x: T) -> str {
    json.encode(x)
}
fn num<T: Num>(x: T) -> str {
    dump(x)
}
print(dump(P(x: [1..3], tags: Set(["a"]))))
print(num(1.5))
--- stdout
{"x":[{"start":1,"end":3}],"tags":["a"]}
1.5

