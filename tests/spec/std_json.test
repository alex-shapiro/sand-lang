=== integers keep every digit
import json
let j = json.parse("[9007199254740993, -9223372036854775808, 9223372036854775807, 18446744073709551616, -0, 1.0]")?
print(j)
print(json.encode(j))
print(json.parse(json.encode(j))? == j)
let xs = j.as_list().unwrap()
print(xs.map(x => x.as_int()))
print(xs.map(x => x.as_float()))
print(json.parse("1e300")?.as_int())
print(json!({"id": 9007199254740993, "ms": 1500ms}))
--- stdout
Arr([Int(9007199254740993), Int(-9223372036854775808), Int(9223372036854775807), Float(1.8446744073709552e19), Float(-0.0), Float(1.0)])
[9007199254740993,-9223372036854775808,9223372036854775807,1.8446744073709552e19,-0.0,1.0]
true
[Some(9007199254740993), Some(-9223372036854775808), Some(9223372036854775807), None, Some(0), Some(1)]
[Some(9007199254740992.0), Some(-9.223372036854776e18), Some(9.223372036854776e18), Some(1.8446744073709552e19), Some(-0.0), Some(1.0)]
None
Obj(["id": Int(9007199254740993), "ms": Int(1500000000)])

=== encode arbitrary values
import json
struct User { name: str, age: int, tags: [str], email: str? }
enum Status { Active, Banned(reason: str), Pair(int, int) }
let u = User { name: "ann", age: 30, tags: ["x"], email: None }
print(json.encode(u))
print(json.encode([Status.Active, Status.Banned("spam"), Status.Pair(1, 2)]))
print(json.encode(["k": 1.5]))
print(json.encode((1, "a", true, ())))
print(json.encode(b"hi"))
print(json.encode(set([1])))
print(json.encode([1: "a"]))
print(json.encode(Some(3)))
print(json.encode(u, indent: 2))
--- stdout
{"name":"ann","age":30,"tags":["x"],"email":null}
["Active",{"Banned":{"reason":"spam"}},{"Pair":[1,2]}]
{"k":1.5}
[1,"a",true,null]
"aGk="
[1]
{"1":"a"}
3
{
  "name": "ann",
  "age": 30,
  "tags": [
    "x"
  ],
  "email": null
}

=== decode into typed values
import json
struct Item { name: str, price: float, qty: int = 1 }
struct Order { id: int, items: [Item], note: str?, meta: [str: int] }
let text = r#"{"id": 7, "items": [{"name": "pen", "price": 1.5}, {"name": "ink", "price": 4, "qty": 3}], "meta": {"a": 1}}"#
let order: Order = json.decode(text)?
print(order.id)
print(order.items[1])
print(order.items[0].qty)
print(order.note)
print(order.meta)
let nums: [int] = json.decode("[1, 2, 3]")?
print(nums.sum())
--- stdout
7
Item { name: "ink", price: 4.0, qty: 3 }
1
None
["a": 1]
6

=== decode errors name the path
