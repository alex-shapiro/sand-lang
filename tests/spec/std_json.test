=== parse and navigate
import json
let doc = json.parse(r#"{"name": "sand", "tags": ["a", "b"], "n": 3, "pi": 3.5, "ok": true, "none": null}"#)?
print(doc.get("name"))
print(doc.get("name").unwrap().as_str())
print(doc.get("tags").unwrap().at(1))
print(doc.get("n").unwrap().as_int())
print(doc.get("pi").unwrap().as_int())
print(doc.get("pi").unwrap().as_float())
print(doc.get("ok").unwrap().as_bool())
print(doc.get("none").unwrap().is_null())
print(doc.get("missing"))
print(doc.path("tags.0"))
print(doc.get("tags").unwrap().as_list().unwrap().len())
print(doc.as_map().unwrap().keys())
--- stdout
Some(Str("sand"))
Some("sand")
Some(Str("b"))
Some(3)
None
Some(3.5)
Some(true)
true
None
Some(Str("a"))
2
["name", "tags", "n", "pi", "ok", "none"]

=== match on json values
import json
fn describe(j: json.Json) -> str {
    match j {
        Null => "null"
        Bool(b) => "bool \(b)"
        Int(i) => "int \(i)"
        Float(f) => "float \(f)"
        Str(s) => "str \(s)"
        Arr(items) => "arr of \(items.len())"
        Obj(fields) => "obj with \(fields.len())"
    }
}
for text in ["null", "true", "7", "1.5", "\"x\"", "[1,2]", "{\"a\":1}"] {
    print(describe(json.parse(text)?))
}
--- stdout
null
bool true
int 7
float 1.5
str x
arr of 2
obj with 1

