=== json with options, single-payload enums and nested variants
import json

enum Shape {
    Circle(float)
    Label(str)
    Pair(int, int)
    Nested(Shape)
    Empty
}

struct Doc {
    name: str
    tag: str?
    shape: Shape
    shapes: [Shape]
    count: int?
    flags: [bool?]
}

let d = Doc { name: "d", tag: Some("t"), shape: Shape.Nested(Shape.Circle(1.5)), shapes: [Shape.Label("x"), Shape.Pair(1, 2), Shape.Empty, Shape.Nested(Shape.Empty)], count: None, flags: [Some(true), None] }
let text = json.encode(d)
print(text)
let back: Result<Doc> = json.decode(text)
print(back)
print(back.unwrap() == d)
print(json.encode(Some(Some(3))))
print(json.encode([Shape.Circle(1.0), Shape.Label("q")]))
let j = json.parse(r#"{"a": [1, 2.5, "s", true, null, {"b": []}], "c": {"d": null}}"#).unwrap()
print(j)
print(json.encode(j))
print(json.encode(j, indent: 2))
match j {
    json.Json.Obj(m) => {
        match m["a"] {
            json.Json.Arr(items) => {
                for it in items {
                    match it {
                        json.Json.Int(i) => print("int \(i)")
                        json.Json.Float(f) => print("float \(f)")
                        json.Json.Str(s) => print("str \(s)")
                        json.Json.Bool(b) => print("bool \(b)")
                        json.Json.Null => print("null")
                        other => print("other \(other)")
                    }
                }
            }
            _ => print("?")
        }
    }
    _ => print("?")
}
let xs: Result<[int?]> = json.decode("[1, null, 3]")
print(xs)
let sh: Result<Shape> = json.decode(r#"{"Nested": [{"Circle": [2.0]}]}"#)
print(sh)
print(json.to_json(Some([1, 2])))
--- stdout
{"name":"d","tag":"t","shape":{"Nested":[{"Circle":[1.5]}]},"shapes":[{"Label":["x"]},{"Pair":[1,2]},"Empty",{"Nested":["Empty"]}],"count":null,"flags":[true,null]}
Ok(Doc { name: "d", tag: Some("t"), shape: Nested(Circle(1.5)), shapes: [Label("x"), Pair(1, 2), Empty, Nested(Empty)], count: None, flags: [Some(true), None] })
true
3
[{"Circle":[1.0]},{"Label":["q"]}]
Obj(["a": Arr([Int(1), Float(2.5), Str("s"), Bool(true), Null, Obj(["b": Arr([])])]), "c": Obj(["d": Null])])
{"a":[1,2.5,"s",true,null,{"b":[]}],"c":{"d":null}}
{
  "a": [
    1,
    2.5,
    "s",
    true,
    null,
    {
      "b": []
    }
  ],
  "c": {
    "d": null
  }
}
int 1
float 2.5
str s
bool true
null
other Obj(["b": Arr([])])
Ok([Some(1), None, Some(3)])
Ok(Nested(Circle(2.0)))
Arr([Int(1), Int(2)])

=== json macro builds nested values from JSON syntax and Sand values
import json
let rows = [["a", "b"]]
let id = 7
let missing: int? = None
let body = json!({
    "requests": [{"range": {"sheetId": id}, "fields": "bold"}],
    "values": rows,
    "note": null,
    "flags": [true, 1.5, -2, "x"],
    "missing": missing,
    "empty": {},
})
print(json.encode(body))
--- stdout
{"requests":[{"range":{"sheetId":7},"fields":"bold"}],"values":[["a","b"]],"note":null,"flags":[true,1.5,-2,"x"],"missing":null,"empty":{}}

=== json macro accepts sand map syntax for objects
import json
print(json.encode(json!(["a": 1, "b": [], "c": [:], "d": ["k": "v"]])))
--- stdout
{"a":1,"b":[],"c":{},"d":{"k":"v"}}

=== json macro needs no import and is not shadowed by a json binding
let json = "text"
let v = json!({"a": json})
print(v.get("a").and_then(x => x.as_str()))
--- stdout
Some("text")

=== json macro in a lambda captures its values
let f = (n: int) => json!({"n": n})
print(f(3).get("n").and_then(x => x.as_int()))
--- stdout
Some(3)

=== json macro object keys are strings
let a = json!({1: 2})
--- error
1: type mismatch

=== json macro object entries are separated by commas
let a = json!({"a": 1 "b": 2})
--- error
1: expected `,` or `}`
1: unexpected `}`
1: expected expression, found `)`

=== json macro calls use parentheses
let a = json!{"a": 1}
--- error
1: a macro call is written `json!(...)`

=== unknown macro
let a = yaml!({})
--- error
1: unknown macro `yaml!`; the only macro is `json!`

=== json macro value without a json form is an error
let a = json!({"f": (x: int) => x})
--- error
1: fn(int) -> int does not satisfy Encode

=== encode rejects functions at compile time
import json
struct Job { name: str, run: fn() -> int }
print(json.encode([Job { name: "a", run: () => 1 }]))
--- error
3: [Job] does not satisfy Encode because field `run` of `Job` has type `fn() -> int`

=== to_json rejects tasks at compile time
import json
let t = spawn 1
print(json.to_json(Some(t)))
--- error
3: Task<int>? does not satisfy Encode because the payload of variant `Some` of `Task<int>?` has type `Task<int>`

=== encode through a type parameter needs the bound
import json
fn dump<T>(x: T) -> str {
    json.encode(x)
}
fn bounded<T: Encode>(x: T) -> str {
    json.encode(x)
}
print(bounded(() => 1))
--- error
3: type parameter `T` does not satisfy Encode; add a bound `T: Encode`
8: fn() -> int does not satisfy Encode

=== the Encode bound holds for data and is implied by Num
import json
struct P<T> { x: T, tags: Set<str> }
fn dump<T: Encode>(x: T) -> str {
    json.encode(x)
}
fn num<T: Num>(x: T) -> str {
    dump(x)
}
print(dump(P { x: [1..3], tags: set(["a"]) }))
print(num(1.5))
--- stdout
{"x":[{"start":1,"end":3}],"tags":["a"]}
1.5

=== decode into json.Json parses untyped JSON
import json
let j: json.Json = json.decode("{\"a\": [1, 2.5, null]}")?
print(j)
let js: [json.Json] = json.decode("[true, \"x\"]")?
print(js)
--- stdout
Obj(["a": Arr([Int(1), Float(2.5), Null])])
[Bool(true), Str("x")]

=== decode fills a missing field with its variant default
import json
enum Mode { Read, Write }
struct Opened { path: str, mode: Mode = Mode.Write }
let o: Opened = json.decode("{\"path\": \"a\"}")?
print(o)
--- stdout
Opened { path: "a", mode: Write }

=== decode fills missing fields with their constant defaults
import json
enum Mode { Read, Write }
struct All {
    u: () = ()
    b: bool = true
    n: int = -3
    x: float = -1.5
    d: duration = -2s
    s: str = "q\""
    xs: [int] = []
    m: [str: int] = [:]
    o: int? = None
    mode: Mode = Mode.Read
    neg: int = --4
}
let a: All = json.decode("{}")?
print(a)
print(a == All {})
struct Computed { n: int = 1 + 1, o: int? = Some(1) }
let c: Result<Computed> = json.decode("{}")
print(c)
let o: Computed = json.decode("{\"n\": 5}")?
print(o)
--- stdout
All { u: (), b: true, n: -3, x: -1.5, d: -2s, s: "q\"", xs: [], m: [:], o: None, mode: Read, neg: 4 }
true
Err(Error { kind: "parse", message: "$: missing field `n`" })
Computed { n: 5, o: None }
