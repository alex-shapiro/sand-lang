=== string escapes roundtrip
import json
let j = json.Json.Str("quote \" backslash \\ newline \n tab \t unicode é \u{1}")
let text = json.encode(j)
print(text)
print(json.parse(text)? == j)
print(json.parse("\"\\u00e9\\ud83d\\ude00\"")?)
--- stdout
"quote \" backslash \\ newline \n tab \t unicode é \u0001"
true
Str("é😀")

