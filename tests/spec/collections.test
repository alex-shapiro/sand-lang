=== list mutation
let xs = [1, 2]
xs.push(3)
xs[0] = 100
print(xs)
print(xs.pop())
print(xs)
xs.insert(1, 7)
print(xs)
print(xs.remove(0))
print(xs)
xs.extend([8, 9])
print(xs)
xs.clear()
print(xs)
print(xs.pop())
--- stdout
[100, 2, 3]
Some(3)
[100, 2]
[100, 7, 2]
100
[7, 2]
[7, 2, 8, 9]
[]
None

=== lists are reference types
let a = [1]
let b = a
b.push(2)
print(a)
let c = a.copy()
c.push(3)
print(a)
print(c)
--- stdout
[1, 2]
[1, 2]
[1, 2, 3]

=== empty list type is inferred
let xs = []
xs.push("a")
print(xs)
--- stdout
["a"]

=== empty list with no constraint cannot be inferred
