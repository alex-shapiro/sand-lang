=== higher order functions
let xs = [1, 2, 3, 4, 5]
print(xs.map(x => x * x))
print(xs.filter(x => x % 2 == 1))
print(xs.filter_map(x => if x > 3 { Some(x * 10) } else { None }))
print(xs.flat_map(x => [x, x]).take(4))
print(xs.fold(0, (acc, x) => acc + x))
print(xs.reduce((a, b) => a * b))
print([].reduce((a: int, b: int) => a + b))
print(xs.any(x => x > 4))
print(xs.all(x => x > 0))
print(xs.find(x => x > 2))
print(xs.find_index(x => x > 2))
print(xs.count(x => x != 3))
var total = 0
xs.each(x => { total += x })
print(total)
--- stdout
[1, 4, 9, 16, 25]
[1, 3, 5]
[40, 50]
[1, 1, 2, 2]
15
Some(120)
None
true
true
Some(3)
Some(2)
4
15

