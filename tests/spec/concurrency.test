=== spawn and wait
let t = spawn 1 + 2
print(t.wait())
--- stdout
3

=== spawned tasks run concurrently with sleeps
fn worker(name: str, delay: duration) -> str {
    task.sleep(delay)
    print("done \(name)")
    name
}
let a = spawn worker("slow", 60ms)
let b = spawn worker("fast", 10ms)
print(a.wait() + b.wait())
--- stdout
done fast
done slow
slowfast

=== spawn with block
var shared = 0
let t = spawn {
    shared += 5
    shared * 2
}
print(t.wait())
print(shared)
--- stdout
10
5

=== tasks start at the next scheduling point
let t = spawn print("in task")
print("before wait")
t.wait()
--- stdout
before wait
in task

=== waiting twice returns the same value
let t = spawn [1, 2]
print(t.wait())
print(t.wait())
print(t.is_done())
--- stdout
[1, 2]
[1, 2]
true

=== task all
let ts = [3, 1, 2].map(n => spawn {
    task.sleep(n * 5ms)
    n * 10
})
print(task.all(ts))
--- stdout
[30, 10, 20]

=== task race returns first and cancels the rest
var finished = []
let a = spawn {
    task.sleep(50ms)
    finished.push("a")
    "a"
}
let b = spawn {
    task.sleep(5ms)
    finished.push("b")
    "b"
}
print(task.race([a, b]))
task.sleep(80ms)
print(finished)
print(a.is_done())
--- stdout
b
["b"]
true

=== task timeout
let fast = task.timeout(100ms, () => "quick")
let slow = task.timeout(10ms, () => {
    task.sleep(1s)
    "late"
})
print(fast)
print(slow)
--- stdout
Some("quick")
None

=== waiting on cancelled task fails
let t = spawn {
    task.sleep(1s)
    1
}
t.cancel()
print(t.wait())
--- fail
task cancelled

=== a task that cancels itself stops at the call and runs its deferred code
let ch: Channel<Task<()>> = Channel()
let t = spawn {
    defer print("deferred")
    let me = ch.recv().unwrap()
    print("before")
    me.cancel()
    print("after")
}
ch.send(t)
task.sleep(10ms)
print(t.is_done())
--- stdout
before
deferred
true

=== a task that races itself and a finished task stops at the race
let ch = Channel()
let done = spawn print("done")
let t = spawn {
    let me = ch.recv().unwrap()
    task.sleep(5ms)
    print("racing")
    task.race([me, done])
    print("after")
}
ch.send(t)
task.sleep(20ms)
print(t.is_done())
--- stdout
done
racing
true

=== a race cancels the slower tasks when its winner finishes
let slow = spawn {
    defer print("slow cancelled")
    task.sleep(1s)
    1
}
let fast = spawn {
    task.sleep(1ms)
    2
}
print(task.race([slow, fast]))
task.yield_now()
print(slow.is_done())
--- stdout
2
slow cancelled
true

=== a cancelled race leaves its tasks running when its deferred code sleeps
let a = spawn task.sleep(1h)
let r = spawn {
    defer {
        task.sleep(1ms)
        print("racer woke")
    }
    task.race([a])
}
task.sleep(5ms)
r.cancel()
task.sleep(5ms)
print(a.is_done())
--- stdout
racer woke
false

=== a cancelled race leaves its tasks running when one wakes its deferred code
let ch: Channel<int> = Channel()
let go: Channel<int> = Channel()
let a = spawn {
    go.recv()
    ch.send(1)
    print("sent")
}
let r = spawn {
    defer {
        ch.recv()
        print("racer woke")
    }
    task.race([a])
}
task.sleep(5ms)
r.cancel()
task.sleep(5ms)
go.send(1)
task.sleep(5ms)
print(a.is_done())
--- stdout
sent
racer woke
true

=== a race of only cancelled tasks fails
let a = spawn task.sleep(1h)
a.cancel()
task.race([a])
--- fail
task cancelled

=== a race of only the running task fails
let ch: Channel<Task<()>> = Channel()
let t = spawn {
    let me = ch.recv().unwrap()
    task.race([me])
}
ch.send(t)
t.wait()
--- fail
a task cannot wait for itself

=== channels
let ch = Channel()
let producer = spawn {
    for i in 0..3 {
        ch.send(i)
    }
    ch.close()
}
for v in ch {
    print(v)
}
print(ch.recv())
--- stdout
0
1
2
None

=== bounded channel applies backpressure
let ch = Channel(capacity: 1)
var log = []
let p = spawn {
    for i in 0..3 {
        ch.send(i)
        log.push("sent \(i)")
    }
}
task.sleep(10ms)
log.push("recv \(ch.recv().unwrap())")
task.sleep(10ms)
log.push("recv \(ch.recv().unwrap())")
log.push("recv \(ch.recv().unwrap())")
p.wait()
print(log)
--- stdout
["sent 0", "recv 0", "sent 1", "recv 1", "recv 2", "sent 2"]

=== channel try_recv and len
let ch: Channel<str> = Channel()
print(ch.try_recv())
ch.send("a")
ch.send("b")
print(ch.len())
print(ch.try_recv())
ch.close()
print(ch.is_closed())
print(ch.send("c"))
print(ch.recv())
print(ch.recv())
--- stdout
None
2
Some("a")
true
false
Some("b")
None

=== deadlock is detected
let ch: Channel<int> = Channel()
print(ch.recv())
--- fail
deadlock

=== busy tasks are preempted
var stop = false
let spinner = spawn {
    var n = 0
    while not stop { n += 1 }
    n > 0
}
task.sleep(20ms)
stop = true
print(spinner.wait())
--- stdout
true

=== errors in tasks abort the run
let t = spawn fail("task failed")
task.sleep(10ms)
print("unreachable")
--- fail
task failed

=== main finishing cancels other tasks
let t = spawn {
    task.sleep(10s)
    print("never")
}
print("main done")
--- stdout
main done

=== yield_now interleaves tasks
var order = []
let t = spawn {
    for i in 0..3 {
        order.push("t\(i)")
        task.yield_now()
    }
}
for i in 0..3 {
    order.push("m\(i)")
    task.yield_now()
}
t.wait()
print(order)
--- stdout
["m0", "t0", "m1", "t1", "m2", "t2"]

=== many tasks
let ts = (0..1000).map(i => spawn i * 2)
print(task.all(ts).sum())
--- stdout
999000

=== io functions suspend inside higher order functions
let results = [30ms, 10ms, 20ms].map(d => {
    task.sleep(d)
    d.millis()
})
print(results)
--- stdout
[30, 10, 20]

=== sleep timing is honored
import time
let start = time.Stopwatch()
task.sleep(30ms)
print(start.elapsed() >= 30ms)
--- stdout
true
