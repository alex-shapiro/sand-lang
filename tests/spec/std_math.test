=== constants
import math
print(math.pi)
print(math.e)
print(math.tau)
--- stdout
3.141592653589793
2.718281828459045
6.283185307179586

=== functions
import math
print(2.0.sqrt())
print(math.cbrt(27.0))
print(math.exp(0.0))
print(math.ln(math.e))
print(math.log2(8.0))
print(math.log10(1000.0))
print(math.log(81.0, 3.0))
print(math.sin(0.0))
print(math.cos(0.0))
print(math.atan2(1.0, 1.0) * 4.0)
print(math.hypot(3.0, 4.0))
print((-1.5).floor())
print((-1.5).ceil())
print(2.5.round())
print((-2.7).trunc())
print((-3.0).abs())
print(2.0.pow(10.0))
print(1.0.min(2.0))
print(1.0.max(2.0))
print(5.0.clamp(0.0, 1.0))
print(math.to_degrees(math.pi))
print(math.to_radians(180.0))
--- stdout
1.4142135623730951
3.0
1.0
1.0
3.0
3.0
4.0
0.0
1.0
3.141592653589793
5.0
-2.0
-1.0
3.0
-2.0
3.0
1024.0
1.0
2.0
1.0
180.0
