=== is_close
import math
print(math.is_close(0.1 + 0.2, 0.3))
print(math.is_close(1.0, 1.1))
print(math.is_close(1.0, 1.05, rel_tol: 0.1))
print(math.is_close(0.0, 1e-12, abs_tol: 1e-9))
--- stdout
true
false
true
true

=== integer helpers
import math
print(math.gcd(12, 18))
print(math.gcd(-4, 6))
print(math.lcm(4, 6))
print(math.isqrt(17))
--- stdout
6
2
12
4

=== isqrt of negative fails
import math
print(math.isqrt(-1))
--- fail
negative
