=== hashes
import crypto
print(crypto.sha256(b"abc").to_hex())
print(crypto.sha256(b"").to_hex())
print(crypto.sha256("a".repeat(1000).bytes()).to_hex())
print(crypto.sha1(b"abc").to_hex())
print(crypto.md5(b"abc").to_hex())
