=== hmac
import crypto
let mac = crypto.hmac_sha256(b"key", b"The quick brown fox jumps over the lazy dog")
print(mac.to_hex())
print(mac.len())
--- stdout
f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8
32

=== constant time equality
import crypto
print(crypto.constant_time_eq(b"abc", b"abc"))
print(crypto.constant_time_eq(b"abc", b"abd"))
print(crypto.constant_time_eq(b"abc", b"ab"))
--- stdout
true
false
false
