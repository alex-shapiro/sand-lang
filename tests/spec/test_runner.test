=== reject unnamed test block
test {
    assert(true)
}
--- error
1: expected a test name: `test "..." { ... }`

=== reject import inside a block
test "t" {
    import test
    test.assert_true(true)
}
--- error
2: `import` is only allowed at the top level; `test` is already in scope in test blocks

=== test blocks use the test module without an import
fn double(x: int) -> int { x * 2 }

fn assert_true(cond: bool) {
    assert(not cond, "the module's own assert_true runs")
}

test "doubles" {
    test.assert_eq(double(2), 4)
    assert_eq(double(3), 6)
    assert_err("x".parse_int().ok_or(error("no int")))
}

test "own definitions come first" {
    assert_true(false)
}
--- test
ok doubles
ok own definitions come first
2 passed, 0 failed
