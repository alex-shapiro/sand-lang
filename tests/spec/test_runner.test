=== a failed question mark fails the test
import json
import test

test "parses" {
    let v = json.parse("[1]")?
    test.assert_true(v.as_list().is_some())
}

test "does not parse" {
    let v = json.parse("[1")?
    test.assert_true(v.as_list().is_some())
}
--- test
ok parses
