=== passing and failing tests
fn add(a: int, b: int) -> int { a + b }

test "addition" {
    assert(add(1, 2) == 3)
}

test "failure" {
    assert(add(1, 1) == 3, "math is broken")
}

test "assert_eq message" {
    import_free()
}

fn import_free() {
    let xs = [1, 2]
    assert(xs.len() == 2)
}
--- test
ok addition
FAIL failure: assert: math is broken
ok assert_eq message
2 passed, 1 failed

=== test module assertions
import test

test "eq" {
    test.assert_eq(1 + 1, 2)
}

test "eq failure" {
    test.assert_eq([1, 2], [1, 3])
}

test "close" {
    test.assert_close(0.1 + 0.2, 0.3)
}

test "ne" {
    test.assert_ne("a", "b")
}

test "err" {
    let r: Result<int, str> = Err("x")
    test.assert_err(r)
}

test "fail" {
    test.fail("explicit")
}
--- test
ok eq
FAIL eq failure: assert: left == right
  left: [1, 2]
 right: [1, 3]
ok close
ok ne
ok err
FAIL fail: assert: explicit
4 passed, 2 failed

=== tests see initialized top level state and are isolated
var counter = 10

test "mutates" {
    counter += 1
    assert(counter == 11)
}

test "sees fresh value" {
    assert(counter == 10)
}
