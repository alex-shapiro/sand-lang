=== the ? operator and ?? on options and results
fn half(x: int) -> int? { if x % 2 == 0 { Some(x / 2) } else { None } }
fn quarter(x: int) -> int? { Some(half(half(x)?)? ) }
fn parse(s: str) -> Result<int, str> {
    if s == "" { return Err("empty") }
    Ok(s.len())
}
fn total(a: str, b: str) -> Result<int, str> {
    let x = parse(a)?
    let y = parse(b)?
    Ok(x + y)
}
fn noisy(x: int) -> int? {
    defer { print("deferred \(x)") }
    let h = half(x)?
    Some(h + 1)
}
print(quarter(8))
print(quarter(6))
print(total("ab", "c"))
print(total("ab", ""))
print(noisy(4))
print(noisy(3))
print(half(3) ?? -1)
print(half(4) ?? -1)
print(parse("") ?? 0)
print(parse("xyz") ?? 0)
let f = (x: int) => Some(half(x)? * 10)
print(f(4))
print(f(5))
--- stdout
Some(2)
None
Ok(3)
Err("empty")
deferred 4
Some(3)
deferred 3
None
-1
2
0
3
Some(20)
None

