=== and/or assigned to a local they read
var x = false
let y = true
x = y and x
print(x)
x = true
x = false or x
print(x)
x = false
x = y or x
print(x)
var z = true
z = (false or z) and z
print(z)
z = loop { break y and not z }
print(z)
--- stdout
false
true
true
true
false

