=== loops with deferred code and channels
fn f() -> int {
    var n = 0
    for i in 0..5 {
        defer { n += 100 }
        if i == 1 { continue }
        if i == 3 { break }
        n += i
    }
    n
}
print(f())
let ch = task.channel()
spawn {
    for i in 0..5 { ch.send(i * i) }
    ch.close()
}
var s = 0
for v in ch {
    if v == 4 { continue }
    s += v
}
print(s)
let ch2 = task.channel()
spawn {
    ch2.send((1, "a"))
    ch2.send((2, "b"))
    ch2.close()
}
for (n, name) in ch2 { print("\(n)\(name)") }
