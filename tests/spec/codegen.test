=== calls in match arms in tail position are tail calls
fn loop_m(n: int, acc: int) -> int {
    match n {
        0 => acc,
        _ => loop_m(n - 1, acc + 1),
    }
}
fn loop_l(n: int, acc: int) -> int {
    if let 0 = n { acc } else { loop_l(n - 1, acc + 2) }
}
fn loop_o(n: int?, acc: int) -> int {
    match n {
        Some(0) => acc,
        Some(k) if k % 2 == 0 => loop_o(Some(k - 1), acc + 1),
        Some(k) => loop_o(Some(k - 1), acc),
        None => -1,
    }
}
print(loop_m(100000, 0))
print(loop_l(100000, 0))
print(loop_o(Some(100000), 0))
print(loop_o(None, 0))
--- stdout
100000
200000
50000
-1

=== comparisons with constants and negative literals
fn cls(n: int) -> str {
    if n < -32768 { "tiny" } else if n <= -1 { "neg" } else if n == 0 { "zero" } else if 32767 < n { "huge" } else if n >= 100 { "big" } else { "small" }
}
for n in [-40000, -32768, -1, 0, 1, 99, 100, 32767, 32768] {
    print("\(n) \(cls(n))")
}
var i = -3
while -1 > i { i += 1 }
print(i)
let neg = -2.5
print(neg * -2.0)
print(-9223372036854775807 - 1)
--- stdout
-40000 tiny
-32768 neg
-1 neg
0 zero
1 small
99 small
100 big
32767 big
32768 huge
-1
5.0
-9223372036854775808

=== integer and range patterns
fn name(n: int) -> str {
    match n {
        -1 => "minus one",
        0 => "zero",
        1..=9 => "digit",
        -100000..=-2 => "negative",
        100000 => "big",
        40000..=99999 => "large",
        _ => "other",
    }
}
for n in [-1, 0, 5, -5, -100000, -100001, 100000, 50000, 10] {
    print(name(n))
}
--- stdout
minus one
zero
digit
negative
negative
other
big
large
other

=== the ? operator and ?? on options and results
fn half(x: int) -> int? { if x % 2 == 0 { Some(x / 2) } else { None } }
fn quarter(x: int) -> int? { Some(half(half(x)?)? ) }
fn parse(s: str) -> Result<int, str> {
    if s == "" { return Err("empty") }
    Ok(s.len())
}
fn total(a: str, b: str) -> Result<int, str> {
    let x = parse(a)?
    let y = parse(b)?
    Ok(x + y)
}
fn noisy(x: int) -> int? {
    defer { print("deferred \(x)") }
    let h = half(x)?
    Some(h + 1)
}
print(quarter(8))
print(quarter(6))
print(total("ab", "c"))
print(total("ab", ""))
print(noisy(4))
print(noisy(3))
print(half(3) ?? -1)
print(half(4) ?? -1)
print(parse("") ?? 0)
print(parse("xyz") ?? 0)
let f = (x: int) => Some(half(x)? * 10)
print(f(4))
print(f(5))
--- stdout
Some(2)
None
Ok(3)
Err("empty")
deferred 4
Some(3)
deferred 3
None
-1
2
0
3
Some(20)
None

