=== continue and break in rotated loops
var out = []
var i = 0
while i < 10 {
    i += 1
    if i % 2 == 0 { continue }
    if i > 7 { break }
    out.push(i)
}
print(out)
fn more(n: int) -> bool { n < 5 }
var j = 0
while more(j) {
    j += 1
    if j == 2 { continue }
    out.push(j * 10)
}
print(out)
var acc = []
@outer for a in 0..4 {
    for b in 0..=3 {
        if b > a { continue @outer }
        if a == 3 { break @outer }
        acc.push("\(a)\(b)")
    }
}
print(acc)
let xs = [5, 6, 7, 8]
var t = 0
while let Some(x) = xs.pop() {
    if x == 7 { continue }
    t += x
}
print(t)
var k = 0
while true {
    k += 1
    if k == 3 { break }
}
while false { print("never") }
print(k)
let q: [int?] = [Some(1), Some(2), None, Some(4)]
var m = 0
var n = 0
while let Some(v) = q[m] {
    n += v
    m += 1
}
print(n)
--- stdout
[1, 3, 5, 7]
[1, 3, 5, 7, 10, 30, 40, 50]
["00", "10", "11", "20", "21", "22"]
19
3
3

=== loops with deferred code and channels
fn f() -> int {
    var n = 0
    for i in 0..5 {
        defer { n += 100 }
        if i == 1 { continue }
        if i == 3 { break }
        n += i
    }
    n
}
print(f())
let ch = task.channel()
spawn {
    for i in 0..5 { ch.send(i * i) }
    ch.close()
}
var s = 0
for v in ch {
    if v == 4 { continue }
    s += v
}
print(s)
let ch2 = task.channel()
spawn {
    ch2.send((1, "a"))
    ch2.send((2, "b"))
    ch2.close()
}
for (n, name) in ch2 { print("\(n)\(name)") }
--- stdout
402
26
1a
2b

