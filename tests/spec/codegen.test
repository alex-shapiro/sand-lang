=== struct literals evaluate fields in source order
struct P {
    x: int
    y: int
    z: int = 9
}
fn v(s: str, n: int) -> int {
    print(s)
    n
}
let p = P { y: v("y", 2), x: v("x", 1) }
let q = P { z: v("z", 3), ..p }
let x = 5
let r = P { x, y: x + 1 }
print("\(p.x) \(p.y) \(p.z) \(q.x) \(q.y) \(q.z) \(r.x) \(r.y) \(r.z)")
