=== calls of function values, fields and trait methods in loops
trait Shape {
    fn area(self) -> int
}
struct Sq {
    s: int
}
impl Shape for Sq {
    fn area(self) -> int { self.s * self.s }
}
fn total<T: Shape>(xs: [T]) -> int {
    var t = 0
    for x in xs { t += x.area() }
    t
}
fn last<T: Shape>(xs: [T], i: int) -> int {
    if i == 0 { xs[0].area() } else { last(xs, i - 1) }
}
struct Box {
    f: fn(int) -> int
    var g: fn(int) -> int
}
let it = [1, 2, 3].iter()
var s = 0
while let Some(x) = it.next() { s += x }
print(s)
print(total([Sq { s: 2 }, Sq { s: 3 }]))
print(last([Sq { s: 4 }], 3))
let b = Box { f: x => x + 1, g: x => x * 2 }
var n = 0
for i in 0..3 {
    n = b.f(n) + b.g(n)
    b.g = x => x * 3
}
print(n)
let fs = [(x: int) => x - 1, (x: int) => x + 100]
print(fs[1](1))
fn apply(g: fn(int) -> int, v: int) -> int { g(v) }
print(apply(x => x * 7, 6))
import math
fn fapply(g: fn(float) -> float, v: float) -> float { g(v) }
print(fapply(math.cbrt, 27.0))
let h = math.cbrt
print([8.0, 64.0].map(h))
