=== integer and range patterns
fn name(n: int) -> str {
    match n {
        -1 => "minus one",
        0 => "zero",
        1..=9 => "digit",
        -100000..=-2 => "negative",
        100000 => "big",
        40000..=99999 => "large",
        _ => "other",
    }
}
for n in [-1, 0, 5, -5, -100000, -100001, 100000, 50000, 10] {
    print(name(n))
}
