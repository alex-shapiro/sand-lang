=== equality branches on strings and other values
fn kind(s: str) -> str {
    if s == "a" { "is a" } else if s != "b" { "not b" } else { "b" }
}
print([kind("a"), kind("b"), kind("c")])
var w = "xxxx"
var n = 0
while w != "" {
    w = w[1..]
    n += 1
}
print(n)
let p = (1, "z")
if p == (1, "z") and not (p != (1, "z")) { print("eq") }
match "two" {
    "one" => print(1),
    "two" => print(2),
    _ => print(0),
}
let o: int? = None
if o == None { print("none") }
--- stdout
["is a", "b", "not b"]
4
eq
2
none
