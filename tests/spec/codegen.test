=== matches with jump tables, virtual tuples and exhaustive last arms
enum T { Leaf(int), Node(T, T) }
enum Op { Add(int), Sub(int), Mul(int), Neg, Nop }
fn build(d: int) -> T { if d == 0 { T.Leaf(1) } else { T.Node(build(d - 1), build(d - 1)) } }
fn sum(t: T) -> int { match t { Leaf(v) => v, Node(l, r) => sum(l) + sum(r) } }
fn run(ops: [Op]) -> int {
    var acc = 1
    for op in ops {
        acc = match op {
            Add(k) => acc + k,
            Sub(k) => acc - k,
            Mul(k) if k > 0 => acc * k,
            Mul(_) => 0,
            Neg => -acc,
            Nop => acc,
        }
    }
    acc
}
fn day(n: int) -> str {
    match n {
        0 => "sun",
        1 | 7 => "mon",
        2 => "tue",
        3 if false => "never",
        3 => "wed",
        _ => "other",
    }
}
fn pair(a: int, b: int) -> int {
    match (a, b) {
        (0, _) => 1,
        (_, 0) => 2,
        (x, y) if x == y => 3,
        t => t.0 + t.1,
    }
}
print(sum(build(4)))
print(run([Op.Add(2), Op.Mul(3), Op.Sub(1), Op.Neg, Op.Nop, Op.Mul(-1), Op.Add(5)]))
print([0, 1, 2, 3, 7, 9, -1].map(day))
print([pair(0, 5), pair(5, 0), pair(4, 4), pair(2, 3)])
var a = 1
var b = 2
let (c, d) = (b, a)
print("\(c) \(d)")
enum Big { A, B(int), C(str), D(int, int), E }
fn big(b: Big) -> str {
    match b {
        A | E => "ae",
        B(n) if n > 10 => "big b",
        D(x, y) => "d\(x + y)",
        B(_) => "b",
        C(s) => s,
    }
}
print([Big.A, Big.B(11), Big.B(1), Big.C("c"), Big.D(1, 2), Big.E].map(big))
fn code(n: int) -> int {
    match n {
        -2 => 20,
        -1 => 10,
        0 | 2 => 0,
        1 => 1,
        x if x > 100 => 100,
        _ => -5,
    }
}
print([-3, -2, -1, 0, 1, 2, 3, 101, 1000000000000].map(code))
fn swap(p: (int, int)) -> (int, int) {
    let (a, b) = p
    let (c, d) = (b, a)
    (c, d)
}
print(swap((1, 2)))
if let (1, x) = (1, "one") { print(x) }
let opt: (int?, int?) = (Some(1), None)
match opt {
    (Some(a), Some(b)) => print(a + b),
    (Some(a), None) | (None, Some(a)) => print(a),
    (None, None) => print(0),
}
