=== closures: captures, mutable captures, self-calls and tasks
fn counter() -> fn() -> int {
    var n = 0
    () => {
        n += 1
        n
    }
}
let c = counter()
c()
print(c())
fn outer(k: int) -> int {
    let base = k * 10
    fn fact(n: int) -> int { if n <= 1 { base } else { n * fact(n - 1) } }
    let add = (x: int) => (y: int) => x + y + base
    fact(4) + add(1)(2)
}
print(outer(1))
let words = ["a", "b"]
var total = 0
let t = spawn {
    total += words.len()
    words.len() * 100
}
print(t.wait() + total)
