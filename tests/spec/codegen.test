=== match on one-character strings
fn escape(c: str) -> str {
    match c {
        "\"" => "\\\""
        "\\" => "\\\\"
        "\n" => "\\n"
        "\t" | "\r" => "ws"
        "é" => "e"
        _ if c.len() > 1 => "long"
        _ => c
    }
}
print(["a", "\"", "\\", "\n", "\t", "\r", "é", "ab", ""].map(escape))
--- stdout
["a", "\\\"", "\\\\", "\\n", "ws", "ws", "e", "long", ""]

=== match on a tuple switches on its first element
enum Op { Add, Sub, Div, Mod, Eq }
fn apply(op: Op, a: int, b: int) -> str {
    match (op, a, b) {
        (Add, x, 0) => "add zero \(x)"
        (Add, x, y) => "add \(x + y)"
        (Div, _, 0) | (Mod, _, 0) => "division by zero"
        (Div, x, y) => "div \(x / y)"
        (Sub, x, y) if x < y => "negative"
        (_, x, y) => "other \(x) \(y)"
    }
}
for (op, a, b) in [(Op.Add, 1, 0), (Op.Add, 1, 2), (Op.Div, 1, 0), (Op.Mod, 1, 0), (Op.Div, 7, 2), (Op.Sub, 1, 2), (Op.Sub, 3, 2), (Op.Eq, 1, 1)] {
    print(apply(op, a, b))
}
--- stdout
add zero 1
add 3
division by zero
division by zero
div 3
negative
other 3 2
other 1 1

