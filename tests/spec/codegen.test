=== functions returning a variant with one payload
enum Shape {
    Circle(float)
    Named(str)
}
fn half(n: int) -> int? {
    if n % 2 == 0 { return Some(n / 2) }
    None
}
fn pair(n: int) -> (int, str)? {
    if n > 0 { Some((n, "n\(n)")) } else { None }
}
fn check(n: int) -> Result<int> {
    if n < 0 { return Err(error("negative: \(n)")) }
    Ok(n)
}
fn named(s: str) -> Shape { Shape.Named(s) }
print("\(half(8)) \(half(7)) \(pair(2)) \(pair(0))")
print("\(check(4)) \(check(-1).is_err()) \(named("x")) \(Shape.Circle(1.5))")
let it = Iter.from_fn(() => Some(1)).take(3).map(x => Some(x))
print(it.to_list())
--- stdout
Some(4) None Some((2, "n2")) None
Ok(4) true Named("x") Circle(1.5)
[Some(1), Some(1), Some(1)]

