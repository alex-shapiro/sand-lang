    fn describe(self) -> str
    fn line(self) -> str { PREFIX + self.describe() }
}
impl Describe for int {
    fn describe(self) -> str {
        calls += 1
        "\(self)"
    }
}
print(1.line())
print(2.line())
print(calls)
