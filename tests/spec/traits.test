=== the traits of a type's parameters apply to its methods
trait Describe {
    fn describe(self) -> str
}
impl Describe for int {
    fn describe(self) -> str { "#\(self)" }
}
struct Labeled<T: Describe> {
    items: [T]

    fn labels(self) -> [str] { self.items.map(x => x.describe()) }
}
enum Tree<T: Ord> {
    Leaf
    Node(Tree<T>, T, Tree<T>)

    fn insert(self, x: T) -> Tree<T> {
        match self {
            Leaf => Tree.Node(Tree.Leaf, x, Tree.Leaf)
            Node(l, v, r) => if x < v { Tree.Node(l.insert(x), v, r) } else { Tree.Node(l, v, r.insert(x)) }
        }
    }

    fn items(self) -> [T] {
        match self {
            Leaf => []
            Node(l, v, r) => l.items() + [v] + r.items()
        }
    }
}
print(Labeled { items: [1, 2] }.labels())
let t: Tree<int> = Tree.Leaf
print(t.insert(3).insert(1).insert(2).items())
--- stdout
["#1", "#2"]
[1, 2, 3]

