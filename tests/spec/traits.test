=== conditional impls
trait Describe {
    fn describe(self) -> str
}
struct Point { x: int }
impl Describe for Point {
    fn describe(self) -> str { "P\(self.x)" }
}
impl<T: Describe> Describe for [T] {
    fn describe(self) -> str { "[" + self.map(x => x.describe()).join(", ") + "]" }
}
impl<T: Describe> Describe for T? {
    fn describe(self) -> str {
        match self {
            Some(x) => "Some " + x.describe()
            None => "nothing"
        }
    }
}
impl<K: Hash, V: Describe> Describe for [K: V] {
    fn describe(self) -> str { "\(self.len()) entries, first " + (self.values().first().describe()) }
}
fn show<T: Describe>(x: T) -> str { x.describe() }
let p = Point { x: 1 }
print([p, Point { x: 2 }].describe())
print([[p], []].describe())
print(show([Some(p), None]))
print(["a": p].describe())
--- stdout
[P1, P2]
[[P1], []]
[Some P1, nothing]
1 entries, first Some P1

=== impls for built-in types and tuples of each size
trait Size {
    fn size(self) -> int
}
impl Size for str {
    fn size(self) -> int { self.char_count() }
}
impl Size for bytes {
    fn size(self) -> int { self.len() }
}
impl Size for () {
    fn size(self) -> int { 0 }
}
impl Size for Range {
    fn size(self) -> int { self.len() }
}
impl<T: Hash> Size for Set<T> {
    fn size(self) -> int { self.len() }
}
impl<A: Size, B: Size> Size for (A, B) {
    fn size(self) -> int { self.0.size() + self.1.size() }
}
impl<A: Size, B: Size, C: Size> Size for (A, B, C) {
    fn size(self) -> int { self.0.size() + self.1.size() + self.2.size() }
}
impl Size for duration {
    fn size(self) -> int { self.millis() }
}
print("héllo".size())
print(b"ab".size())
print(().size())
print((0..10).size())
print(set([1, 2, 2]).size())
print(("ab", ()).size())
print(("a", b"xyz", 2s).size())
--- stdout
5
2
0
10
2
2
2004

=== generic impls for user types
trait Describe {
    fn describe(self) -> str
}
impl Describe for int {
    fn describe(self) -> str { "\(self)" }
}
enum Tree<T> {
    Leaf
    Node(left: Tree<T>, value: T, right: Tree<T>)
}
impl<T: Describe> Describe for Tree<T> {
    fn describe(self) -> str {
        match self {
            Leaf => "."
            Node(l, v, r) => "(" + l.describe() + " " + v.describe() + " " + r.describe() + ")"
        }
    }
}
struct Pair<A, B> { a: A, b: B }
impl<A, B> Describe for Pair<A, B> where A: Describe, B: Describe {
    fn describe(self) -> str { "<" + self.a.describe() + ", " + self.b.describe() + ">" }
}
let t = Tree.Node(Tree.Leaf, 1, Tree.Node(Tree.Leaf, 2, Tree.Leaf))
print(t.describe())
print(Pair { a: 1, b: t }.describe())
--- stdout
(. 1 (. 2 .))
<1, (. 1 (. 2 .))>

=== generic monoid impls
trait Monoid {
    fn empty() -> Self
    fn combine(self, other: Self) -> Self
}
impl Monoid for int {
    fn empty() -> int { 0 }
    fn combine(self, other: int) -> int { self + other }
}
impl<T> Monoid for [T] {
    fn empty() -> [T] { [] }
    fn combine(self, other: [T]) -> [T] { self + other }
}
impl<A: Monoid, B: Monoid> Monoid for (A, B) {
    fn empty() -> (A, B) { (A.empty(), B.empty()) }
    fn combine(self, other: (A, B)) -> (A, B) { (self.0.combine(other.0), self.1.combine(other.1)) }
}
impl<T: Monoid> Monoid for T? {
    fn empty() -> T? { None }
    fn combine(self, other: T?) -> T? {
        match (self, other) {
            (Some(a), Some(b)) => Some(a.combine(b))
            (a, None) => a
            (None, b) => b
        }
    }
}
fn total<T: Monoid>(xs: [T]) -> T {
    var acc = T.empty()
    for x in xs { acc = acc.combine(x) }
    acc
}
print(total([[1], [2, 3]]))
print(total([(1, ["a"]), (2, ["b"])]))
print(total([Some(1), None, Some(5)]))
let e: (int, [str]) = Monoid.empty()
print(e)
--- stdout
[1, 2, 3]
(3, ["a", "b"])
Some(6)
(0, [])

=== trait methods with their own type parameters
trait Describe {
    fn describe(self) -> str
}
impl Describe for int {
    fn describe(self) -> str { "i\(self)" }
}
trait Mapper {
    fn map_all<U: Describe>(self, f: fn(int) -> U) -> [str]
    fn first<U: Describe>(self, f: fn(int) -> U) -> str { self.map_all(f)[0] }
}
struct Nums { xs: [int] }
impl Mapper for Nums {
    fn map_all<V: Describe>(self, f: fn(int) -> V) -> [str] { self.xs.map(x => f(x).describe()) }
}
fn through_trait<M: Mapper>(m: M) -> str { m.first(x => x * 100) }
print(Nums { xs: [1, 2] }.map_all(x => x + 1))
print(through_trait(Nums { xs: [3] }))
--- stdout
["i2", "i3"]
i300

=== an iterator-style trait
trait Iter<T> {
    fn next(self) -> T?
}
struct Counter {
    var i: int
    n: int
}
impl Iter<int> for Counter {
    fn next(self) -> int? {
        if self.i >= self.n { return None }
        self.i += 1
        Some(self.i)
    }
}
fn collect<I: Iter<T>, T>(it: I) -> [T] {
    var out = []
    while let Some(x) = it.next() { out.push(x) }
    out
}
print(collect(Counter { i: 0, n: 4 }))
--- stdout
[1, 2, 3, 4]

