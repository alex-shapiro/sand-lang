/// Describes.
pub trait Describe: Eq + Ord {
    /// Required.
    fn describe(self) -> str

    fn shout(self) -> str { self.describe().to_upper() }
}

trait Into<T> {
    fn into(self) -> T
}

impl<T: Describe + Hash> Describe for [T] where T: Ord {
    fn describe(self) -> str { "list" }
}

impl Into<str> for int {
    fn into(self) -> str { "" }
}

fn f<T: Describe + geo.Shape, U: Into<[int]>>(x: T, u: U) -> str where T: Hash { x.describe() }

