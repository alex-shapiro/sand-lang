=== static methods and Self in generic impls
trait Monoid {
    fn empty() -> Self
    fn combine(self, other: Self) -> Self
}
impl<T> Monoid for [T] {
    fn empty() -> [T] { [] }
    fn combine(self, other: Self) -> Self {
        if other.is_empty() { self } else if self.is_empty() { Self.empty() + other } else { self + other }
    }
}
fn maker<T: Monoid>() -> fn() -> T { T.empty }
let mk: fn() -> [int] = maker()
print(mk())
print([1].combine([2]))
--- stdout
[]
[1, 2]

