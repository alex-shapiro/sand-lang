=== reflect natives alongside dictionaries
import json
trait Describe {
    fn describe(self) -> str
}
struct P { x: int }
impl Describe for P {
    fn describe(self) -> str {
        let again: P = json.decode(json.encode(self)).unwrap()
        "P\(again.x)"
    }
}
fn with_extra<T: Describe>(items: [T], text: str) -> str {
    let extra: [P] = json.decode(text).unwrap()
    items.map(x => x.describe()).join(",") + ";" + extra.map(p => p.describe()).join(",")
}
print(with_extra([P { x: 1 }], r#"[{"x": 2}, {"x": 3}]"#))
--- stdout
P1;P2,P3

