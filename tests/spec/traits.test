=== where clauses on methods of generic types
trait Describe {
    fn describe(self) -> str
}
impl Describe for int {
    fn describe(self) -> str { "i\(self)" }
}
struct Box<T> {
    item: T
    fn show(self) -> str where T: Describe { "Box(" + self.item.describe() + ")" }
    fn get(self) -> T { self.item }
}
extend<T> Box<T> {
    fn twice(self) -> str where T: Describe { self.show() + self.show() }
}
