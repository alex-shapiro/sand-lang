=== trait with required and default methods
trait Describe {
    fn describe(self) -> str
    fn shout(self) -> str { self.describe().to_upper() + "!" }
}
struct Point { x: int, y: int }
impl Describe for Point {
    fn describe(self) -> str { "point \(self.x),\(self.y)" }
}
struct Word { w: str }
impl Describe for Word {
    fn describe(self) -> str { self.w }
    fn shout(self) -> str { "~\(self.w)~" }
}
let p = Point { x: 1, y: 2 }
print(p.describe())
print(p.shout())
print(Word { w: "hi" }.shout())
--- stdout
point 1,2
POINT 1,2!
~hi~

=== generic function that requires a trait
trait Describe {
    fn describe(self) -> str
}
struct Point { x: int }
impl Describe for Point {
    fn describe(self) -> str { "P\(self.x)" }
}
impl Describe for int {
    fn describe(self) -> str { "int \(self)" }
}
fn twice<T: Describe>(x: T) -> str { x.describe() + " " + x.describe() }
fn all<T>(xs: [T]) -> [str] where T: Describe { xs.map(x => x.describe()) }
print(twice(Point { x: 3 }))
print(twice(7))
print(all([1, 2]))
--- stdout
P3 P3
int 7 int 7
["int 1", "int 2"]

=== several required traits including built-in ones
trait Describe {
    fn describe(self) -> str
}
impl Describe for int {
    fn describe(self) -> str { "#\(self)" }
}
impl Describe for str {
    fn describe(self) -> str { "'\(self)'" }
}
fn largest<T: Ord + Describe>(xs: [T]) -> str {
    var best = xs[0]
    for x in xs {
        if x > best { best = x }
    }
    best.describe()
}
fn keys<K>(xs: [K]) -> [K: str] where K: Hash, K: Describe {
    [x: x.describe() for x in xs]
}
print(largest([3, 9, 2]))
print(largest(["b", "a"]))
print(keys([1, 2]))
--- stdout
#9
'b'
[1: "#1", 2: "#2"]

=== static methods through types and type parameters
trait Monoid {
    fn empty() -> Self
    fn combine(self, other: Self) -> Self
}
impl Monoid for int {
    fn empty() -> int { 0 }
    fn combine(self, other: int) -> int { self + other }
}
impl Monoid for str {
    fn empty() -> Self { "" }
    fn combine(self, other: Self) -> Self { self + other }
}
fn concat_all<T: Monoid>(xs: [T]) -> T {
    xs.fold(T.empty(), (acc, x) => acc.combine(x))
}
let none: [int] = []
print(concat_all([1, 2, 3]))
print(concat_all(["a", "b", "c"]))
print(concat_all(none))
print(int.empty())
print(str.empty().len())
let s: str = Monoid.empty()
print(s.is_empty())
--- stdout
6
abc
0
0
0
true

=== default methods calling static methods through Self
trait Monoid {
    fn empty() -> Self
    fn combine(self, other: Self) -> Self
    fn twice(self) -> Self { self.combine(self) }
    fn reset(self) -> Self { Self.empty() }
}
impl Monoid for int {
    fn empty() -> int { 0 }
    fn combine(self, other: int) -> int { self + other }
}
print(21.twice())
print(5.reset())
--- stdout
42
0

=== supertraits
trait Describe {
    fn describe(self) -> str
}
trait Shape: Describe + Eq {
    fn area(self) -> float
    fn summary(self) -> str { "\(self.describe()): \(self.area())" }
}
enum Fig {
    Circle(r: float)
    Square(s: float)
}
impl Describe for Fig {
    fn describe(self) -> str {
        match self {
            Circle(_) => "circle"
            Square(_) => "square"
        }
    }
}
impl Shape for Fig {
    fn area(self) -> float {
        match self {
            Circle(r) => 3.0 * r * r
            Square(s) => s * s
        }
    }
}
fn report<T: Shape>(xs: [T]) -> [str] {
    // Supertrait methods and built-in supertraits are available through `T: Shape`.
    let first = xs[0]
    xs.map(x => "\(x.summary()) \(x.describe()) \(x == first)")
}
print(report([Fig.Circle(1.0), Fig.Square(2.0)]))
--- stdout
["circle: 3.0 circle true", "square: 4.0 square false"]

=== supertrait chains
trait A {
    fn a(self) -> str
}
trait B: A {
    fn b(self) -> str { "b" + self.a() }
}
trait C: B {
    fn c(self) -> str { "c" + self.b() }
}
impl A for int {
    fn a(self) -> str { "a\(self)" }
}
impl B for int {}
impl C for int {}
fn use_c<T: C>(x: T) -> str { x.c() + " " + x.b() + " " + x.a() }
print(use_c(1))
--- stdout
cba1 ba1 a1

