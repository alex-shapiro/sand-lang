=== lambdas, local functions and spawn capture dictionaries
trait Describe {
    fn describe(self) -> str
}
impl Describe for int {
    fn describe(self) -> str { "i\(self)" }
}
fn labels<T: Describe>(xs: [T]) -> [str] {
    fn label(x: T) -> str { "<" + x.describe() + ">" }
    let wrap = (x: T) => "[" + label(x) + "]"
    xs.map(wrap)
}
fn later<T: Describe>(x: T) -> str {
    let t = spawn x.describe()
    t.wait()
}
fn make<T: Describe>() -> fn(T) -> str { x => x.describe() + "!" }
print(labels([1, 2]))
print(later(5))
print(make()(7))
--- stdout
["[<i1>]", "[<i2>]"]
i5
i7!

=== recursion and polymorphic recursion
trait Describe {
    fn describe(self) -> str
}
impl Describe for int {
    fn describe(self) -> str { "\(self)" }
}
impl<T: Describe> Describe for [T] {
    fn describe(self) -> str { "[" + self.map(x => x.describe()).join(" ") + "]" }
}
fn nest<T: Describe>(x: T, n: int) -> str {
    if n == 0 { x.describe() } else { nest([x, x], n - 1) }
}
fn count_down<T: Describe>(x: T, n: int) -> [str] {
    if n == 0 { return [] }
    [x.describe()] + count_down(x, n - 1)
}
print(nest(1, 2))
print(count_down(4, 2))
--- stdout
[[1 1] [1 1]]
["4", "4"]

=== default arguments may use required traits
trait Monoid {
    fn empty() -> Self
    fn combine(self, other: Self) -> Self
}
impl Monoid for str {
    fn empty() -> str { "" }
    fn combine(self, other: str) -> str { self + other }
}
fn join<T: Monoid>(a: T, b: T = T.empty()) -> T { a.combine(b) }
print(join("x"))
print(join("x", "y"))
print(join("x", b: "z"))
