=== traits and impls in other modules
import "./shapes.sand"
from "./shapes.sand" import Shape
struct Circle { r: float }
impl shapes.Shape for Circle {
    fn area(self) -> float { 3.0 * self.r * self.r }
    fn name(self) -> str { "circle" }
}
fn describe<T: Shape>(x: T) -> str { "\(x.name()) \(x.area())" }
fn describe2<T: shapes.Shape>(x: T) -> str { x.name() }
print(describe(Circle { r: 1.0 }))
print(describe(shapes.Square { side: 2.0 }))
print(describe2(shapes.Square { side: 3.0 }))
print(shapes.total([Circle { r: 1.0 }, Circle { r: 2.0 }]))
print(shapes.Shape.area(Circle { r: 2.0 }))
print(shapes.Square { side: 2.0 }.area())
print(shapes.Square { side: 2.0 }.size())
--- file shapes.sand
/// Something with an area.
pub trait Shape {
    fn area(self) -> float
    fn name(self) -> str { "shape" }
}
pub struct Square { pub side: float }
impl Shape for Square {
    fn area(self) -> float { self.side * self.side }
}
pub trait Sized {
    fn size(self) -> int
}
impl Sized for Square {
    fn size(self) -> int { 4 }
}
pub fn total<T: Shape>(xs: [T]) -> float {
    xs.map(x => x.area()).sum()
}
--- stdout
circle 3.0
shape 4.0
shape
15.0
12.0
4.0
4

