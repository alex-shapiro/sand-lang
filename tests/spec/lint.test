=== clean code has no warnings
fn add(a: int, b: int) -> int { a + b }
print(add(1, 2))
--- lint

=== unused variable
fn f() -> int {
    let unused = 5
    let _ignored = 6
    1
}
print(f())
--- lint
2: unused-variable

=== unused parameter
fn f(a: int, _b: int, c: int) -> int { a }
print(f(1, 2, 3))
--- lint
1: unused-variable

=== unused import
import math
import json
print(math.pi)
--- lint
2: unused-import

=== unused private function
fn helper() -> int { 1 }
pub fn api() -> int { 2 }
fn used() -> int { 3 }
print(used())
--- lint
1: unused-function

=== functions named by help and members are used
fn documented() {}
struct Point {
    x: int
    fn norm(self) -> int { self.x }
}
fn listed() {}
fn only_in_unused() {}
fn unused() { help(only_in_unused) }
help(documented)
help(Point.norm)
print(members(listed))
print(Point(x: 1).x)
--- lint
7: unused-function
8: unused-function

=== unnecessary var
var x = 1
var y = 1
y += 1
print(x + y)
--- lint
1: unnecessary-var

=== unused result
import fs
fn f() -> Result<int> { Ok(1) }
f()
fs.write_text("x.txt", "data")
let r = f()
r.unwrap()
--- lint
3: unused-result
4: unused-result

=== unreachable code
fn f(x: int) -> int {
    return x
    print("never")
}
fn g() {
    for i in 0..3 {
        break
        print(i)
    }
}
print(f(1))
g()
--- lint
3: unreachable-code
8: unreachable-code

