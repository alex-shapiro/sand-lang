=== clean code has no warnings
fn add(a: int, b: int) -> int { a + b }
print(add(1, 2))
--- lint

=== unused variable
fn f() -> int {
    let unused = 5
    let _ignored = 6
    1
}
print(f())
--- lint
2: unused-variable

=== unused parameter
fn f(a: int, _b: int, c: int) -> int { a }
print(f(1, 2, 3))
--- lint
1: unused-variable

=== unused import
import math
import json
print(math.pi)
--- lint
2: unused-import

=== unused private function
fn helper() -> int { 1 }
pub fn api() -> int { 2 }
fn used() -> int { 3 }
print(used())
--- lint
1: unused-function

=== unnecessary var
var x = 1
var y = 1
y += 1
print(x + y)
--- lint
1: unnecessary-var

=== unused result
import fs
fn f() -> Result<int> { Ok(1) }
f()
fs.write_text("x.txt", "data")
let r = f()
r.unwrap()
--- lint
3: unused-result
4: unused-result

=== unreachable code
fn f(x: int) -> int {
    return x
    print("never")
}
fn g() {
    for i in 0..3 {
        break
        print(i)
    }
}
print(f(1))
g()
--- lint
3: unreachable-code
8: unreachable-code

=== naming conventions
struct bad_name { x: int }
enum Good { lower_variant }
fn BadFn() {}
let BadVar = 1
print(BadVar)
BadFn()
print(bad_name { x: 1 })
print(Good.lower_variant)
--- lint
1: naming
2: naming
3: naming
4: naming

=== bool comparison
let ok = true
if ok == true { print("yes") }
if false != ok { print("no") }
--- lint
2: bool-comparison
3: bool-comparison

=== self assignment
var x = 1
x = x
print(x)
--- lint
2: self-assignment

=== len zero
let xs = [1]
if xs.len() == 0 { print("empty") }
if "s".len() == 0 { print("empty") }
--- lint
2: len-zero
3: len-zero

=== empty block
let x = 1
if x > 0 {
} else {
    print("x")
}
while false {}
--- lint
2: empty-block
6: empty-block

=== todo
fn f() -> int { todo() }
print(f())
--- lint
1: todo

=== suppression comments
// lint: allow(unused-variable)
let a = 1
let b = 2
--- lint
3: unused-variable

=== file level suppression
//! lint: allow(unused-variable, naming)
let A = 1
let b = 2
--- lint

=== shadowed variable with different type
let x = 1
print(x)
let x = "one"
print(x)
--- lint
3: shadowed-variable

=== shadowing with same type is fine
let x = 1
let x = x + 1
print(x)
--- lint

=== unused variable in pattern
let (a, b) = (1, 2)
print(a)
match Some(3) {
    Some(v) => print("some")
    None => print("none")
}
--- lint
1: unused-variable
4: unused-variable

=== variables used in closures count as used
let n = 2
let f = x => x * n
print(f(1))
--- lint

=== multiple lints in one function
fn f() {
    var count = 0
    let unused = 1
    return
    print(count)
}
f()
--- lint
2: unnecessary-var
3: unused-variable
5: unreachable-code

=== shadowing in sibling scopes is not flagged
fn f(flag: bool) {
    if flag {
        let x = 1
        print(x)
    } else {
        let x = "one"
        print(x)
    }
    for i in 0..2 {
        let y = i
        print(y)
    }
    for _ in 0..2 {
        let y = "two"
        print(y)
    }
    match flag {
        true => {
            let z = 1
            print(z)
        }
        false => {
            let z = "z"
            print(z)
        }
    }
    [1].each(n => {
        let w = n
        print(w)
    })
    [1].each(_ => {
        let w = "w"
        print(w)
    })
    {
        let v = 1
        print(v)
    }
    let v = "v"
    print(v)
}
f(true)
--- lint

=== shadowing a binding that is still in scope
fn f(s: str, xs: [int]) {
    let s = s.len()
    print(s)
    for x in xs {
        let x = "item {x}"
        print(x)
    }
    let (a, b) = (1, 2)
    let a = "{a}{b}"
    print(a)
    if let Some(v) = xs.first() {
        let v = "{v}"
        print(v)
    }
    let g = (n: int) => {
        let n = "{n}"
        n.len()
    }
    print(g(1))
}
f("x", [1])
--- lint
2: shadowed-variable
5: shadowed-variable
9: shadowed-variable
12: shadowed-variable
16: shadowed-variable

=== tests and functions do not shadow top-level bindings
let x = 1
print(x)
fn f() {
    let x = "s"
    print(x)
}
f()
test "t" {
    let x = "s"
    print(x)
}
--- lint

=== unused functions are found by reachability
fn only_recursive(n: int) -> int { if n > 0 { only_recursive(n - 1) } else { 0 } }
fn ping(n: int) -> int { if n > 0 { pong(n - 1) } else { 0 } }
fn pong(n: int) -> int { ping(n) }
fn called_by_unused() -> int { 1 }
fn unused_caller() -> int { called_by_unused() }
fn piped(n: int) -> int { n + 1 }
fn as_value(n: int) -> int { n * 2 }
fn in_default() -> int { 4 }
fn with_default(n: int = in_default()) -> int { n }
fn by_test() -> int { 3 }
fn recursive_used(n: int) -> int { if n > 0 { recursive_used(n - 1) } else { 0 } }
pub fn api() -> int { 0 }
print(1 |> piped)
let f = as_value
print(f(1) + with_default() + recursive_used(2))
test "uses a helper" {
    assert(by_test() == 3)
}
--- lint
1: unused-function
2: unused-function
3: unused-function
4: unused-function
5: unused-function

=== unused methods of private types
struct Hidden {
    v: int

    fn used(self) -> int { self.v }
    fn unused(self) -> int { self.v }
    fn make() -> Hidden { Hidden { v: 1 } }
    fn unused_static() -> Hidden { Hidden { v: 2 } }
}
extend Hidden {
    fn ext_unused(self) -> int { 0 }
    fn ext_used(self) -> int { 0 }
}
enum Kind {
    A

    fn describe(self) -> str { "a" }
}
pub struct Shown {
    v: int

    fn public_api(self) -> int { self.v }
}
extend Shown {
    fn also_public(self) -> int { 0 }
}
let h = Hidden.make()
print(h.used() + h.ext_used())
print(Kind.A)
print(Shown { v: 1 }.v)
--- lint
5: unused-function
7: unused-function
10: unused-function
16: unused-function

=== unused method suppression
struct Hidden {
    v: int

    // lint: allow(unused-function)
    fn unused(self) -> int { self.v }
}
print(Hidden { v: 1 }.v)
--- lint

=== trait and impl methods are not unused functions
trait Greet {
    fn hello(self) -> str
    fn twice(self) -> str { self.hello() + self.hello() }
    fn make() -> Self
}
struct P { v: int }
impl Greet for P {
    fn hello(self) -> str { "hi" }
    fn make() -> P { P { v: 0 } }
}
fn helper() -> int { 1 }
print(P { v: 2 }.v)
--- lint
11: unused-function

=== interpolated literals
let n = 3
print("[0-9]{4}")
print("{n} {2.5:.1} {r"{4}"}")
print("{1.5}")
--- lint
2: interpolated-literal
4: interpolated-literal

=== label lints
@Rows for i in 0..3 {
    if i > 1 { break @Rows }
}
@unused for i in 0..3 {
    print(i)
}
@outer for i in 0..3 {
    @inner for j in 0..3 {
        if j > i { continue @outer }
        print(j)
    }
}
--- lint
1: naming
4: unused-label
8: unused-label

=== loops nothing breaks out of never complete
fn f() {
    @outer loop {
        loop {
            break @outer
        }
    }
    print("reachable")
    loop {
        for x in 0..3 {
            if x > 1 { break }
        }
        [1].each(x => {
            if x > 0 { return }
        })
    }
    print("unreachable")
}
f()
--- lint
16: unreachable-code

=== statements after a labeled break are unreachable
@outer for _ in 0..3 {
    for j in 0..3 {
        break @outer
        print(j)
    }
}
--- lint
4: unreachable-code

