=== import a script module
import "./geometry.sand"
print(geometry.area(2.0, 3.0))
print(geometry.UNIT)
--- file geometry.sand
pub fn area(w: float, h: float) -> float { w * h }
pub let UNIT = "m2"
--- stdout
6.0
m2

=== import without extension and with alias
import "lib/util" as u
print(u.shout("hi"))
--- file lib/util.sand
pub fn shout(s: str) -> str { s.to_upper() + "!" }
--- stdout
HI!

=== from import
from "./shapes.sand" import Shape, area
print(area(Shape.Square(3.0)))
--- file shapes.sand
pub enum Shape { Square(float), Circle(float) }
pub fn area(s: Shape) -> float {
    match s {
        Square(x) => x * x
        Circle(r) => 3.0 * r * r
    }
}
--- stdout
9.0

=== qualified types from modules
import "./model.sand"
let u = model.User { name: "ann", age: 30 }
print(u.greeting())
fn older(u: model.User) -> model.User { model.User { age: u.age + 1, ..u } }
print(older(u).age)
--- file model.sand
pub struct User {
    pub name: str
    pub age: int
    pub fn greeting(self) -> str { "hello \(self.name)" }
}
--- stdout
hello ann
31

=== fields and methods without pub are private to their module
import "./account.sand"
let a = account.open("ann")
print(a.owner)
print(a.describe())
print(a.balance)
--- file account.sand
pub struct Account {
    pub owner: str
    balance: int
    pub fn describe(self) -> str { "\(self.owner): \(self.audit())" }
    fn audit(self) -> int { self.balance }
}
pub fn open(owner: str) -> Account { Account { owner, balance: 10 } }
--- error
5: field `balance` of `account.Account` is private

=== a private field does not hide a public method of the same name
import "./doc.sand"
let d = doc.new("hi")
print(d.text())
print(d.text)
--- file doc.sand
pub struct Doc {
    text: str
    pub fn text(self) -> str { self.text }
}
pub fn new(text: str) -> Doc { Doc { text } }
--- error
4: `text` is a method; call it with `()`

=== a private method hides the built-in to_str in other modules
import "./money.sand"
print(money.cents(500).to_str())
--- file money.sand
pub struct Money {
    pub cents: int
    fn to_str(self) -> str { "$\(self.cents / 100)" }
}
pub fn cents(n: int) -> Money { Money { cents: n } }
--- error
2: method `to_str` of `money.Money` is private

=== a public field does not hide a private method of the same name
import "./box.sand"
print(box.new(2).size())
--- file box.sand
pub struct Box {
    pub size: int
    fn size(self) -> int { self.size * 2 }
}
pub fn new(size: int) -> Box { Box { size } }
--- error
2: method `size` of `box.Box` is private

=== a struct with private fields reports only the privacy error
import "./account.sand"
let a = account.Account { owner: "ann" }
--- file account.sand
pub struct Account {
    pub owner: str
    balance: int
}
--- error
2: cannot construct `account.Account` here: its field `balance` is private

=== private methods cannot be called from other modules
import "./account.sand"
print(account.open("ann").audit())
--- file account.sand
pub struct Account {
    pub owner: str
    fn audit(self) -> int { 1 }
}
pub fn open(owner: str) -> Account { Account { owner } }
--- error
2: method `audit` of `account.Account` is private

=== structs with private fields cannot be built in other modules
import "./account.sand"
let a = account.Account { owner: "ann", balance: 1 }
--- file account.sand
pub struct Account {
    pub owner: str
    balance: int = 0
}
--- error
2: cannot construct `account.Account` here: its field `balance` is private

=== private fields cannot be matched in other modules
import "./account.sand"
let a = account.open()
let account.Account { owner, .. } = a
print(owner)
match a {
    account.Account { balance, .. } => print(balance)
}
--- file account.sand
pub struct Account {
    pub owner: str
    balance: int
}
pub fn open() -> Account { Account { owner: "ann", balance: 0 } }
--- error
6: field `balance` of `account.Account` is private

=== a pattern without `..` does not name private fields
import "./account.sand"
let account.Account { owner } = account.open()
--- file account.sand
pub struct Account {
    pub owner: str
    balance: int
}
pub fn open() -> Account { Account { owner: "ann", balance: 0 } }
--- error
2: `Account` has private fields; add `..` to ignore them

=== members omit a built-in method that a private method hides
import "./money.sand"
print(members(money.cents(1)).contains("to_str"))
print(members(money.cents(1)).contains("debug"))
--- file money.sand
pub struct Money {
    pub cents: int
    fn to_str(self) -> str { "$\(self.cents / 100)" }
}
pub fn cents(n: int) -> Money { Money { cents: n } }
--- stdout
false
true

=== help reports a private method that hides a built-in one
import "./money.sand"
help(money.cents(1).to_str)
--- file money.sand
pub struct Money {
    pub cents: int
    fn to_str(self) -> str { "$\(self.cents / 100)" }
}
pub fn cents(n: int) -> Money { Money { cents: n } }
--- error
2: method `to_str` of `money.Money` is private

=== only functions take type descriptions
struct Box<reflect T> { x: T }
--- error
1: only the type parameters of a function can be `reflect`

=== private fields cannot be assigned in other modules
import "./account.sand"
let a = account.open()
a.count = 2
--- file account.sand
pub struct Account {
    var count: int
}
pub fn open() -> Account { Account { count: 0 } }
--- error
3: field `count` of `account.Account` is private

=== reflection cannot build types with private fields of other modules
import "./account.sand"
import json
print(json.encode(account.open()))
let a: Result<account.Account> = json.decode("{\"owner\": \"x\"}")
--- file account.sand
pub struct Account {
    pub owner: str
    balance: int = 0
}
pub fn open() -> Account { Account { owner: "ann" } }
--- error
4: this call cannot build `account.Account` here: its field `balance` is private

=== private items are not visible
import "./m.sand"
print(m.secret())
--- file m.sand
fn secret() -> int { 42 }
pub fn open() -> int { secret() }
--- error
2: `secret` is private

=== importing missing name
from "./m.sand" import nothing
--- file m.sand
pub fn something() {}
--- error
1: module `m` has no public item `nothing`

=== missing module file
import "./missing.sand"
--- error
1: cannot load module

=== module top level runs once in dependency order
import "./a.sand"
import "./b.sand"
print("main")
--- file a.sand
import "./b.sand"
print("a")
pub let A = 1
--- file b.sand
print("b")
pub let B = 2
--- stdout
b
a
main

=== import cycles are rejected
import "./x.sand"
--- file x.sand
import "./y.sand"
pub let X = 1
--- file y.sand
import "./x.sand"
pub let Y = 1
--- error
import cycle

=== module paths cannot escape the module root
import "../outside.sand"
--- error
1: outside the module root

=== nested relative imports resolve from the importing file
import "pkg/a.sand"
print(a.value())
--- file pkg/a.sand
import "./b.sand"
pub fn value() -> int { b.base() + 1 }
--- file pkg/b.sand
pub fn base() -> int { 41 }
--- stdout
42

=== stdlib module import and alias
import math as m
from math import cbrt
print(m.cbrt(27.0))
print(cbrt(64.0))
--- stdout
3.0
4.0

=== unknown stdlib module
import nosuchmodule
--- error
1: unknown module `nosuchmodule`

=== module vars are read only to importers
import "./state.sand"
state.count = 5
--- file state.sand
pub var count = 0
--- error
2: cannot assign

=== module functions can mutate their own vars
import "./state.sand"
state.bump()
state.bump()
print(state.count)
--- file state.sand
pub var count = 0
pub fn bump() { count += 1 }
--- stdout
2

=== type errors in imported modules are reported with file name
import "./bad.sand"
--- file bad.sand
pub let X: int = "no"
--- error
1: type mismatch

=== question mark at top level of imported module is an error
import "./q.sand"
--- file q.sand
let v = Ok(1)?
--- error
1: `?`

=== unused module name collision
import "./dup.sand"
import "./other/dup.sand"
--- file dup.sand
pub let A = 1
--- file other/dup.sand
pub let B = 1
--- error
2: `dup` is already defined

=== return is not allowed at the top level of an imported module
import "./early.sand"
print(early.X)
--- file early.sand
pub let X = 1
return
--- error
`return` is not allowed at the top level of an imported module

=== from is a keyword only in a selective import
from math import pi

fn convert(amount: float, from: str, to: str) -> str {
    "\(amount) \(from) -> \(to)"
}

let from = "x"
print(convert(pi.round(), from, "y"))
--- stdout
3.0 x -> y
