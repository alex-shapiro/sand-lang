=== a duration scales only by a Num
fn scale<T>(d: duration, k: T) -> duration {
    d * k
}
let a = 1s * "x"
let b = 1s * 2s
let c = 1s / "x"
--- error
2: type parameter `T` does not implement `Num`
4: expected Num, found str
5: expected Num, found duration
6: expected Num, found str

=== duration and int are distinct
let d: duration = 5
--- error
1: expected duration, found int

=== loops reading globals that are not initialized yet
// A loop in a function called before the global it reads is initialized.
fn sum_late(n: int) -> int {
    var t = 0
    for i in 0..n {
        if i == 3 {
            t += LATE
        }
        t += 1
    }
    t
}

// Started before `SHARED` is initialized; reads it only on its last
// iteration, after the main task has initialized it.
fn worker() -> int {
    var n = 0
    for i in 0..50 {
        if i == 49 {
            n += SHARED
        }
        task.yield_now()
    }
    n
}

fn label_pairs(pairs: [(int, str)], use_late: bool) -> str {
    var out = ""
    for (n, s) in pairs {
        let d = n * 2
        if use_late {
            out = out + "\(LATER)"
        }
        out = out + "\(s)\(d);"
    }
    out
}

print(label_pairs([(1, "a"), (2, "b")], false))
let LATER = 9
print(label_pairs([(1, "a"), (2, "b")], true))
let t = spawn { worker() }
task.yield_now()
let SHARED = 7
print(t.wait())
print(sum_late(0))
print(sum_late(3))
print(sum_late(4))
let LATE = 100
--- stdout
a2;b4;
9a2;9b4;
7
0
3
--- fail
global used before initialization: `LATE`

=== loops reached through values, dictionaries and defaults before a global they read
trait Count {
    fn count(self, n: int) -> int
}
struct Bag {}
impl Count for Bag {
    fn count(self, n: int) -> int {
        var t = 0
        for i in 0..n {
            if i == 2 {
                t += LATE
            }
            t += 1
        }
        t
    }
}
fn generic<T: Count>(x: T, n: int) -> int {
    x.count(n)
}
fn direct(n: int) -> int {
    Bag {}.count(n)
}
fn with_default(n: int, k: int = direct(n)) -> int {
    k
}
let by_value = direct
let by_lambda = (n: int) => direct(n)
print(generic(Bag {}, 2))
print(by_value(2))
print(by_lambda(2))
print(with_default(2))
let LATE = 10
print(generic(Bag {}, 3))
print(by_value(3))
print(by_lambda(3))
print(with_default(3))
--- stdout
2
2
2
2
13
13
13
13

=== never fits a whole value, not part of a type
fn run(f: fn() -> never) -> str {
    f()
}
print(run(() => 5).len())
--- error
4: type mismatch: expected never, found int

=== a list of never holds no values
let xs: [never] = [1, 2]
let s: str = xs[0]
--- error
