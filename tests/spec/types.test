=== never operands of operators and patterns
fn f(x: int) -> int {
    let a = if x > 0 { x } else { return -1 } + 1
    let b = x + (if x > 0 { 1 } else { return -2 })
    if x == (if x > 0 { x } else { fail("unreachable") }) {
        print("same")
    }
    let (p, q) = if x > 0 { (x, x) } else { fail("unreachable") }
    a + b + p + q
}
print(f(2))
print(f(0))
--- stdout
same
10
-1

=== plus on values of unknown type requires a type with plus
let add = (a, b) => a + b
print(add(true, false))
--- error
1: operator `+` is not defined for bool

=== plus on values of unknown type works for numbers, strings and lists
fn twice<T>(x: T, f: fn(T, T) -> T) -> T {
    f(x, x)
}
let add = (a, b) => a + b
print(add(1, 2))
print(twice("ab", (a, b) => a + b))
print(twice([1], (a, b) => a + b))
print(twice(1s, (a, b) => a + b))
--- stdout
3
abab
[1, 1]
2s

=== operators are not defined for types
struct V { x: float }
let a = V { x: 1.0 }
let b = a * 2.0
let c = 2.0 * a
let d = a + a
let e = a * 1s
let f = "a" - "b"
let g = 1 + 2.0
--- error
3: operator `*` is not defined for V
4: operator `*` is not defined for V
5: operator `+` is not defined for V
6: operator `*` is not defined for V
7: operator `-` is not defined for str
8: type mismatch: expected int, found float

=== plus on values of a type parameter's type requires Num
fn f<T>(x: T) -> T {
    let g = (a, b) => a + b
    g(x, x)
}
--- error
2: operator `+` is not defined for type parameter `T`; add `T: Num`

=== a method receiver of the wrong instance is reported once
struct Box<T> { v: T }
extend Box<int> {
    fn twice(self) -> int {
        self.v * 2
    }
}
let b = Box { v: "a" }
print(b.twice())
--- error
8: no method `twice` on type Box<str>

=== the receiver check does not leave partial bindings
struct Box<T> { v: T }
extend Box<([int], int)> {
    fn size(self) -> int {
        self.v.0.len()
    }
}
let xs = []
let b = Box { v: (xs, "a") }
print(b.size())
xs.push("s")
--- error
9: no method `size` on type Box<([_], str)>

