=== generic identity
fn id<T>(x: T) -> T { x }
print(id(1))
print(id("s"))
print(id([true]))
--- stdout
1
s
[true]

=== generic with bounds
fn largest<T: Ord>(xs: [T]) -> T? {
    var best = xs.first()?
    for x in xs {
        if x > best { best = x }
    }
    Some(best)
}
print(largest([3, 9, 2]))
print(largest(["b", "c", "a"]))
print(largest([1.5, 0.5]))
--- stdout
Some(9)
Some("c")
Some(1.5)

=== missing bound on generic comparison
fn bigger<T>(a: T, b: T) -> T { if a > b { a } else { b } }
--- error
1: Ord

=== bound violation at instantiation
fn key<T: Hash>(x: T) -> [T: int] { [x: 1] }
print(key(1.5))
--- error
2: float does not satisfy Hash

=== num bound arithmetic
fn sum_all<T: Num>(xs: [T], zero: T) -> T {
    var acc = zero
    for x in xs { acc = acc + x }
    acc
}
print(sum_all([1, 2, 3], 0))
print(sum_all([0.5, 0.25], 0.0))
--- stdout
6
0.75

=== sums of empty lists have the element type
let fs: [float] = []
print(fs.sum() + 1.0)
print(fs.product() * 2.0)
let ns: [int] = []
print((ns.sum(), ns.product()))
print(([0.5, 0.25].sum(), [2, 3].product()))
--- stdout
1.0
2.0
(0, 1)
(0.75, 6)

=== Num bounds provide zero and one
fn total<T: Num>(xs: [T]) -> T {
    xs.sum()
}
fn identities<T>() -> (T, T) where T: Num {
    (T.zero(), T.one())
}
let empty: [float] = []
print(total(empty) / 2.0)
print(total([4, 5]))
let p: (float, float) = identities()
let q: (int, int) = identities()
print((p, q))
--- stdout
0.0
9
((0.0, 1.0), (0, 1))

=== Num evidence through traits and generic impls
trait Shape: Num {
    fn area(self) -> float
}
impl Shape for float {
    fn area(self) -> float { self }
}
trait Measure {
    fn total(self) -> float
}
impl<T: Shape> Measure for [T] {
    fn total(self) -> float {
        let sum = self.sum()
        sum.area()
    }
}
let none: [float] = []
print(none.total())
print([1.5, 2.0].total())
struct Pair<T: Num> {
    a: T
    b: T

    fn sum_with(self, xs: [T]) -> T { xs.sum() + self.a + self.b }
}
print(Pair { a: 0.5, b: 0.25 }.sum_with([]))
print(Pair { a: 1, b: 2 }.sum_with([3]))
--- stdout
0.0
3.5
0.75
6

=== the Num evidence trait is not visible
fn f<T: Num>() -> T { T.zero() }
let s: str = f()
print(int.zero())
print(Num.one())
--- error
2: str does not satisfy Num
3: no method `zero` on type int
4: undefined name `Num`

=== arithmetic on unbounded type parameter is an error
fn add<T>(a: T, b: T) -> T { a + b }
--- error
1: Num

=== generic functions taking functions
fn map_pair<A, B>(p: (A, A), f: fn(A) -> B) -> (B, B) {
    (f(p.0), f(p.1))
}
print(map_pair((1, 2), x => x.to_str() + "!"))
--- stdout
("1!", "2!")

=== explicit equality bound
fn count<T: Eq>(xs: [T], t: T) -> int {
    xs.count(x => x == t)
}
print(count([1, 2, 1], 1))
print(count(["a"], "b"))
--- stdout
2
0

=== generic type mismatch between arguments
fn same<T>(a: T, b: T) -> bool { true }
print(same(1, "x"))
--- error
2: type mismatch

=== generic struct methods with bounds
struct Bag<T: Ord> {
    items: [T]
    fn biggest(self) -> T? { self.items.max() }
}
print(Bag { items: [4, 7, 1] }.biggest())
--- stdout
Some(7)

=== multiple bounds
fn uniq_sorted<T: Ord + Hash>(xs: [T]) -> [T] { xs.unique().sorted() }
print(uniq_sorted([3, 1, 3, 2]))
--- stdout
[1, 2, 3]

=== unknown bound is an error
fn f<T: Fancy>(x: T) -> T { x }
--- error
1: unknown bound `Fancy`

=== generic polymorphic recursion through instantiation
fn wrap<T>(x: T, n: int) -> [T] {
    if n == 0 { [x] } else { wrap(x, n - 1) + [x] }
}
print(wrap("z", 2))
--- stdout
["z", "z", "z"]

=== a recursive type does not satisfy a bound something in it does not
struct A { b: B?, x: float }
struct B { a: A? }
let ok = B { a: None } == B { a: None }
let bs = [B { a: None }: 1]
--- error
4: B does not satisfy Hash

=== built-in bounds of generic types depend on their arguments
struct Pair<K, V> { k: K, v: V }
struct Cell<T> { var t: T }
let ok = [Pair { k: 1, v: "x" }: 1]
let floats = [Pair { k: 1.5, v: "x" }: 1]
let cells = [Cell { t: 1 }: 1]
print(Pair { k: 1.5, v: [2] } == Pair { k: 1.5, v: [2] })
--- error
4: Pair<float, str> does not satisfy Hash
5: Cell<int> does not satisfy Hash

=== recursive types satisfy built-in bounds
enum Tree<T> {
    Leaf(T)
    Node(Tree<T>, Tree<T>)
}
let t = Tree.Node(Tree.Leaf(1), Tree.Leaf(2))
let keys = [t: "tree"]
print(keys[Tree.Node(Tree.Leaf(1), Tree.Leaf(2))])
print(Tree.Leaf("a") < Tree.Leaf("b"))
--- stdout
tree
true

=== a bound error names the part of the type that does not satisfy it
struct Row { var n: int }
struct Wrap<T> { items: [T] }
struct Pair<T> { both: (T, T) }
fn keys<T>(w: Wrap<T>) -> Set<Wrap<T>> {
    set([w])
}
fn pairs<T>(p: Pair<T>) -> Set<Pair<T>> {
    set([p])
}
let s = set([Row { n: 1 }])
let t = set([[1.0]])
--- error
5: Wrap<T> does not satisfy Hash because field `items` of `Wrap<T>` has type `[T]`
8: Pair<T> does not satisfy Hash because element 0 of `(T, T)` has type `T`; add a bound `T: Hash`
10: Row does not satisfy Hash because field `n` of `Row` is mutable
11: [float] does not satisfy Hash
