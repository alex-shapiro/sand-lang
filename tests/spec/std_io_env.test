=== read lines from stdin
import io
while let Some(line) = io.stdin.read_line()? {
    print("got: \(line)")
}
--- stdin
first
second
--- stdout
got: first
got: second

=== read all stdin
import io
let text = io.stdin.read_text()?
print(text.lines().len())
--- stdin
a
b
c
--- stdout
3

=== read stdin in pieces and as lines
import io
print(io.stdin.read(3)?)
for line in io.stdin.lines() {
    print(line?)
}
print(io.stdin.read()?)
--- stdin
abcdef
g
--- stdout
b"abc"
def
g
b""

=== write without newline
import io
io.stdout.write_str("a")?
io.stdout.write(b"b\n")?
io.stderr.write_str("err\n")?
io.stdout.flush()?
--- stdout
ab
--- stderr
err

=== copy stdin to stdout
import io
let n = io.copy(io.stdin, io.stdout)?
print(n)
--- stdin
one
two
--- stdout
one
two
8

=== the standard streams are readers and writers
import io
fn shout<W: io.Writer>(w: W, text: str) -> Result<()> {
    w.write_str(text.to_upper() + "\n")
}
shout(io.stdout, "hi")?
shout(io.stderr, "there")?
--- stdout
HI
--- stderr
THERE

=== eprint writes to stderr
eprint("to stderr")
print("to stdout")
--- stdout
to stdout
--- stderr
to stderr

=== environment variables
import env
print(env.get("GREETING"))
print(env.get("MISSING"))
print(env.vars())
--- env
GREETING=hello
OTHER=x
--- stdout
Some("hello")
None
["GREETING": "hello", "OTHER": "x"]

=== script arguments
import env
print(env.args())
--- args
one two
--- stdout
["one", "two"]
