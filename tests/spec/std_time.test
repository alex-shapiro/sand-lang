=== spans relative to a start
import time
from time import Span, Unit
let ny = time.TimeZone("America/New_York")?
let start = time.PlainDateTime(2024, 3, 9)?.to_zoned_datetime(ny)
print(Span(days: 2).total(Unit.Hour, relative_to: Some(start)))
print(Span(months: 1).total(Unit.Day, relative_to: Some(start)))
print(Span(hours: 47).round(largest: Some(Unit.Day), relative_to: Some(start)))
print(Span(months: 1).add(Span(days: 30), relative_to: Some(start)))
print(Span(days: 1).to_duration(relative_to: Some(start)))
print(Span(days: 1).to_duration(relative_to: Some(start.add(Span(days: 1)))))
--- stdout
47.0
31.0
P2D
P2M
1d
23h

=== spans with months require relative_to
import time
print(time.Span(months: 1).total(time.Unit.Day))
--- fail
invalid

=== span units cannot have mixed signs
import time
print(time.Span(hours: 1, minutes: -30))
--- fail
invalid: the units of a span must not have different signs

=== comparing, sorting, and hashing value types
import time
let dates = [time.PlainDate(2024, 5, 1)?, time.PlainDate(2024, 1, 31)?, time.PlainDate(2023, 12, 25)?]
print(dates.sorted())
print(dates.max())
let counts = [time.PlainDate(2024, 1, 31)?: 1]
print(counts[time.PlainDate(2024, 1, 31)?])
print(Set([time.PlainTime(9, 0)?, time.PlainTime(9, 0)?]).len())
print(time.PlainDate(2024, 1, 1)? < time.PlainDate(2024, 1, 2)?)
print(time.Span(days: 1) == time.Span(days: 1))
print([time.TimeZone("UTC")?: "utc"].contains(time.UTC))
print(time.PlainMonthDay(12, 31)? > time.PlainMonthDay(1, 1)?)
--- stdout
[2023-12-25, 2024-01-31, 2024-05-01]
Some(2024-05-01)
1
1
true
true
true
true

=== interpolation, format specifications and json
import time
import json
let d = time.PlainDate(2024, 2, 29)?
print("due \(d), at \(time.PlainTime(9, 30)?)")
print("[\(d:>12)]")
print(d.debug())
print(json.encode([d]))
struct Event {
    name: str
    at: time.ZonedDateTime
    every: time.Span
}
let e = Event(name: "standup", at: time.ZonedDateTime.parse("2024-03-11T09:00[America/New_York]")?, every: time.Span(weeks: 1))
let text = json.encode(e)
print(text)
let back: Event = json.decode(text)?
print(back == e)
let bad: Result<time.PlainDate> = json.decode("\"2024-02-30\"")
print(bad.is_err())
--- stdout
due 2024-02-29, at 09:30:00
[  2024-02-29]
2024-02-29
["2024-02-29"]
{"name":"standup","at":"2024-03-11T09:00:00-04:00[America/New_York]","every":"P1W"}
true
true

