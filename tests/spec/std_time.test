=== instants and epoch conversions
import time
from time import Instant
print(Instant.from_epoch_seconds(0))
print(Instant.from_epoch_seconds(1700000000))
print(Instant.from_epoch_seconds(-1))
print(Instant.from_epoch_millis(1500))
print(Instant.from_epoch_nanos(-1))
let t = Instant.parse("1969-12-31T23:59:59.5Z")?
print(t.epoch_seconds())
print(t.epoch_millis())
print(t.epoch_nanos())
print(Instant.parse("2024-02-29T15:05:09+02:00")?)
--- stdout
1970-01-01T00:00:00Z
2023-11-14T22:13:20Z
1969-12-31T23:59:59Z
1970-01-01T00:00:01.5Z
1969-12-31T23:59:59.999999999Z
-1
-500
-500000000
2024-02-29T13:05:09Z

=== instant arithmetic and rounding
import time
from time import Instant, Unit, RoundingMode
let t = Instant.parse("2024-02-29T13:05:09Z")?
print(t.add(36h))
print(t.subtract(1s))
print(t.add(36h).since(t))
print(t.until(t.subtract(90m)))
print(t.round(Unit.Hour))
print(t.round(Unit.Minute, increment: 15, mode: RoundingMode.Ceil))
print(t.add(36h) > t)
--- stdout
2024-03-02T01:05:09Z
2024-02-29T13:05:08Z
1.5d
-1.5h
2024-02-29T13:00:00Z
2024-02-29T13:15:00Z
true

=== epoch nanoseconds outside the range of an int
import time
print(time.Instant.parse("2300-01-01T00:00:00Z")?.epoch_seconds())
print(time.Instant.parse("2300-01-01T00:00:00Z")?.epoch_nanos())
--- stdout
10413792000
--- fail
overflow

=== instants beyond the year 9999
import time
print(time.Instant.from_epoch_seconds(1000000000000))
--- fail
overflow

=== plain dates
import time
let d = time.PlainDate(2024, 2, 29)?
print(d)
print((d.year(), d.month(), d.day()))
print((d.day_of_week(), d.day_of_year(), d.week_of_year(), d.year_of_week()))
print((d.days_in_month(), d.days_in_year(), d.in_leap_year()))
let jan1 = time.PlainDate(2021, 1, 1)?
print((jan1.week_of_year(), jan1.year_of_week()))
print(time.PlainDate(2023, 2, 29))
print(time.PlainDate(2024, 13, 1).is_err())
--- stdout
2024-02-29
(2024, 2, 29)
(4, 60, 9, 2024)
(29, 366, true)
(53, 2020)
Err(Error(message: "no such date: 2023-02-29", kind: "invalid"))
true

=== date arithmetic and end-of-month clamping
import time
from time import Span
let d = time.PlainDate(2024, 1, 31)?
print(d.add(Span(months: 1)))
print(d.add(Span(months: 1)).add(Span(months: 1)))
print(d.add(Span(years: 1, days: 1)))
print(d.subtract(Span(weeks: 5)))
print(d.add(3d))
print(d.add(47h))
print(d.with(month: 4))
print(d.with(day: 99))
print(d.with(year: 2025, day: 1))
--- stdout
2024-02-29
2024-03-29
2025-02-01
2023-12-27
2024-02-03
2024-02-01
2024-04-30
2024-01-31
2025-01-01

=== differences between dates
import time
from time import Unit, RoundingMode
let a = time.PlainDate(2024, 1, 31)?
let b = time.PlainDate(2025, 3, 1)?
print(a.until(b))
print(a.until(b, largest: Unit.Year))
print(a.until(b, largest: Unit.Month))
print(a.until(b, largest: Unit.Week))
print(b.since(a, largest: Unit.Year))
print(a.since(b, largest: Unit.Year))
print(a.until(b, smallest: Unit.Month))
print(a.until(b, smallest: Unit.Month, mode: RoundingMode.HalfExpand))
print(a.until(b).days())
--- stdout
P395D
P1Y1M1D
P13M1D
P56W3D
P1Y1M1D
-P1Y1M1D
P13M
P13M
395

=== date differences with time units
import time
let a = time.PlainDate(2024, 1, 1)?
print(a.until(a, smallest: time.Unit.Hour))
--- fail
invalid

=== plain times
import time
from time import Unit
let t = time.PlainTime(9, 30, second: 15, millisecond: 250)?
print(t)
print((t.hour(), t.minute(), t.second(), t.millisecond(), t.microsecond(), t.nanosecond()))
print(t.add(90m))
print(time.PlainTime(23, 0)?.add(2h))
print(time.PlainTime(1, 0)?.subtract(time.Span(hours: 2, days: 3)))
print(time.PlainTime(17, 0)?.since(time.PlainTime(9, 30)?))
print(time.PlainTime(9, 30)?.until(time.PlainTime(8, 0)?))
print(t.round(Unit.Minute))
print(time.PlainTime(23, 59, second: 45)?.round(Unit.Minute))
print(t.with(hour: 25, minute: -3))
print(time.PlainTime(24, 0))
print(time.PlainTime(1, 2, 3, nanosecond: 4)?)
--- stdout
09:30:15.25
(9, 30, 15, 250, 0, 0)
11:00:15.25
01:00:00
23:00:00
7.5h
-1.5h
09:30:00
00:00:00
23:00:15.25
Err(Error(message: "no such time: 24:00:00", kind: "invalid"))
01:02:03.000000004

=== plain date-times
import time
from time import Unit, Span
let dt = time.PlainDateTime(2024, 3, 10, hour: 2, minute: 30)?
print(dt)
print((dt.to_plain_date(), dt.to_plain_time()))
print(dt.add(Span(months: 1, hours: 23)))
print(dt.until(time.PlainDateTime(2024, 4, 1)?))
print(dt.until(time.PlainDateTime(2024, 4, 1)?, largest: Unit.Month))
print(dt.until(time.PlainDateTime(2024, 4, 1)?, smallest: Unit.Hour))
print(dt.round(Unit.Day))
print(dt.with(day: 31, hour: 23))
print(dt.with_plain_time(time.PlainTime(8, 15)?))
print(time.PlainDate(2024, 3, 10)?.to_plain_datetime())
print(time.PlainDate(2024, 3, 10)?.to_plain_datetime(time.PlainTime(12, 0)?))
--- stdout
2024-03-10T02:30:00
(2024-03-10, 02:30:00)
2024-04-11T01:30:00
P21DT21H30M
P21DT21H30M
P21DT21H
2024-03-10T00:00:00
2024-03-31T23:30:00
2024-03-10T08:15:00
2024-03-10T00:00:00
2024-03-10T12:00:00

=== zoned date-times follow daylight saving time
import time
from time import Span, Unit
let ny = time.TimeZone("America/New_York")?
let z = time.PlainDateTime(2024, 3, 9, hour: 12)?.to_zoned_datetime(ny)
print(z)
print(z.add(Span(days: 1)))
print(z.add(Span(hours: 24)))
print((z.hours_in_day(), z.add(Span(days: 1)).hours_in_day()))
print((z.offset(), z.add(Span(days: 1)).offset()))
print(z.until(z.add(Span(days: 1))))
print(z.until(z.add(Span(days: 1)), largest: Unit.Day))
print(z.until(z.add(Span(months: 1, hours: 3)), largest: Unit.Month))
print(z.add(Span(days: 1)).start_of_day())
print(z.next_transition())
print(z.previous_transition())
print(z.time_zone())
print(z.to_instant())
print(z.to_plain_datetime())
--- stdout
2024-03-09T12:00:00-05:00[America/New_York]
2024-03-10T12:00:00-04:00[America/New_York]
2024-03-10T13:00:00-04:00[America/New_York]
(24.0, 23.0)
(-5h, -4h)
PT23H
P1D
P1MT3H
2024-03-10T00:00:00-05:00[America/New_York]
Some(2024-03-10T03:00:00-04:00[America/New_York])
Some(2023-11-05T01:00:00-05:00[America/New_York])
America/New_York
2024-03-09T17:00:00Z
2024-03-09T12:00:00

=== zoned arithmetic takes spans, not durations
import time
let z = time.now_zoned(time.UTC)
print(z.add(1d))
--- error
3: type mismatch: expected Span, found duration

=== wall-clock times in gaps and folds
import time
from time import Disambiguation
let ny = time.TimeZone("America/New_York")?
let gap = time.PlainDateTime(2024, 3, 10, hour: 2, minute: 30)?
print(gap.to_zoned_datetime(ny))
print(gap.to_zoned_datetime(ny, disambiguation: Disambiguation.Earlier))
let fold = time.PlainDateTime(2024, 11, 3, hour: 1, minute: 30)?
print(fold.to_zoned_datetime(ny))
print(fold.to_zoned_datetime(ny, disambiguation: Disambiguation.Later))
let later = fold.to_zoned_datetime(ny, disambiguation: Disambiguation.Later)
print(later.with(minute: 45))
print(later.with(day: 4))
--- stdout
2024-03-10T03:30:00-04:00[America/New_York]
2024-03-10T01:30:00-05:00[America/New_York]
2024-11-03T01:30:00-04:00[America/New_York]
2024-11-03T01:30:00-05:00[America/New_York]
2024-11-03T01:45:00-05:00[America/New_York]
2024-11-04T01:30:00-05:00[America/New_York]

=== zones
import time
print(time.UTC)
print(time.TimeZone("europe/paris")?.id())
print(time.TimeZone("+05:30")?)
print(time.TimeZone("Mars/Olympus_Mons"))
print(time.local_zone())
let t = time.Instant.parse("2024-07-01T12:00:00Z")?
let paris = t.to_zoned_datetime(time.TimeZone("Europe/Paris")?)
print(paris)
print(paris.with_time_zone(time.TimeZone("Asia/Kolkata")?))
print(paris == t.to_zoned_datetime(time.UTC))
print(paris.to_instant() == t)
