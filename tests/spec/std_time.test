print(time.TimeZone("EST5EDT,M3.2.0,M11.1.0").is_err())
print(time.ZonedDateTime.parse("2024-01-01T00:00:00+05:30:15[+05:30:15]").is_err())
print(time.TimeZone("-08:00")?)
