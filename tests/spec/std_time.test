Europe/Paris
+05:30
Err(Error(message: "unknown time zone \"Mars/Olympus_Mons\"", kind: "not_found"))
UTC
2024-07-01T14:00:00+02:00[Europe/Paris]
2024-07-01T17:30:00+05:30[Asia/Kolkata]
false
true

=== year-months and month-days
import time
from time import Span, Unit
let ym = time.PlainYearMonth(2024, 1)?
print(ym)
print((ym.days_in_month(), ym.add(Span(months: 1)).days_in_month(), ym.in_leap_year()))
print(ym.add(Span(years: 1, months: 13)))
print(ym.until(time.PlainYearMonth(2025, 7)?))
print(ym.until(time.PlainYearMonth(2025, 7)?, largest: Unit.Month))
print(ym.since(time.PlainYearMonth(2025, 7)?))
print(ym.to_plain_date(31))
print(ym.with(month: 2).to_plain_date(31))
print(time.PlainYearMonth.parse("2024-02")?)
let md = time.PlainMonthDay(2, 29)?
print(md)
print((md.to_plain_date(2023), md.to_plain_date(2024)))
print(time.PlainMonthDay.parse("--12-25")?.with(day: 40))
print(time.PlainDate(2024, 7, 4)?.to_plain_month_day() == time.PlainMonthDay(7, 4)?)
print(time.PlainMonthDay(2, 30))
--- stdout
2024-01
(31, 29, true)
2026-02
P1Y6M
P18M
-P1Y6M
2024-01-31
2024-02-29
2024-02
02-29
(2023-02-28, 2024-02-29)
12-31
true
Err(Error(message: "no such day: 02-30", kind: "invalid"))

=== adding sub-month units to PlainYearMonth
import time
print(time.PlainYearMonth(2024, 1)?.add(time.Span(days: 1)))
--- fail
invalid: a PlainYearMonth can only add years and months

=== spans
import time
from time import Span, Unit
let s = Span(years: 1, months: 2, days: 3, hours: 4, minutes: 5, seconds: 6, milliseconds: 500)
print(s)
print((s.years(), s.months(), s.weeks(), s.days(), s.hours(), s.minutes(), s.seconds(), s.milliseconds()))
print((s.sign(), s.negated().sign(), Span().sign(), Span().is_zero()))
print(s.negated())
print(s.negated().abs() == s)
print(Span(hours: 24) == Span(days: 1))
print(s.with(years: 0, months: 0))
print(Span(hours: 25).round(largest: Some(Unit.Day)))
print(Span(minutes: 100).round(smallest: Unit.Hour))
print(Span(hours: 36).total(Unit.Day))
print(Span(days: 1, hours: 12).to_duration())
print(Span(hours: 1).add(30m))
print(Span(hours: 1).subtract(Span(minutes: 90)))
print(Span(days: 1).compare(Span(hours: 25)))
print(time.Span.parse("P1Y2M3DT4H5M6.5S")?)
print(time.Span.parse("4h 30m")?)
print(time.Span.parse("1 day ago")?)
print(time.Span.parse("soon").is_err())
