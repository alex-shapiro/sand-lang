true
true
true
-08:00

=== transitions only include offset changes
import time
let london = time.TimeZone("Europe/London")?
let z = time.PlainDateTime(1968, 1, 1)?.to_zoned_datetime(london)
let first = z.next_transition().unwrap()
print(first)
print(first.next_transition().unwrap().offset() != first.offset())
print(time.PlainDateTime(2024, 1, 1)?.to_zoned_datetime(time.TimeZone("+05:30")?).next_transition())
let fall = time.PlainDateTime(2024, 11, 3)?.to_zoned_datetime(time.TimeZone("America/New_York")?)
print(fall.hours_in_day())
--- stdout
1968-02-18T03:00:00+01:00[Europe/London]
true
None
25.0

