=== span text round-trip
import time
import json
from time import Span
for s in [Span(milliseconds: 1500), Span(nanoseconds: 1000), Span(microseconds: 2000000), Span(hours: 1, milliseconds: 1000)] {
    let back: Span = json.decode(json.encode(s))?
    print((s, Span.parse(s.to_str())? == s, back == s))
}
let counts = [Span(milliseconds: 1500): 1]
print(counts[Span(seconds: 1, milliseconds: 500)])
--- stdout
(PT1.5S, true, true)
(PT0.000001S, true, true)
(PT2S, true, true)
(PT1H1S, true, true)
1

=== decoding maps with value-type keys
import time
import json
let m = [time.PlainDate(2024, 2, 29)?: 1, time.PlainDate(2023, 1, 1)?: 2]
let back: [time.PlainDate: int] = json.decode(json.encode(m))?
print(back == m)
let dup: [time.TimeZone: int] = json.decode("{\"america/new_york\": 1, \"America/New_York\": 2}")?
print(dup)
let bad: Result<[time.PlainDate: int]> = json.decode("{\"2024-02-30\": 1}")
print(bad.is_err())
--- stdout
true
[America/New_York: 2]
true

=== unsupported time zone formats are rejected
import time
