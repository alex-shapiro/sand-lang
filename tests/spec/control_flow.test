=== break and continue in comprehensions refer to the enclosing loop
var rows = []
for i in 0..4 {
    if i == 1 { continue }
    rows.push([if x > 4 - i { break } else { x * 10 + i } for x in 0..3])
}
print(rows)
var out = []
@outer for i in 0..3 {
    out.push([if x == i { continue @outer } else { x } for x in 0..3])
}
print(out)
--- stdout
[[0, 10, 20], [2, 12, 22]]
[]


