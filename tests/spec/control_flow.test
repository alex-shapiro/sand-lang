=== let else
fn parse_pair(s: str) -> (int, int)? {
    let Some((a, b)) = s.split_once(",") else { return None }
    let Some(x) = a.parse_int() else { return None }
    let Some(y) = b.parse_int() else { return None }
    Some((x, y))
}
print(parse_pair("3,4"))
print(parse_pair("3"))
print(parse_pair("a,4"))
--- stdout
Some((3, 4))
None
None

