=== match on integers and strings
fn describe(n: int) -> str {
    match n {
        0 => "zero"
        1 | 2 => "small"
        3..=9 => "medium"
        _ => "large"
    }
}
print(describe(0))
print(describe(2))
print(describe(5))
print(describe(42))
let cmd = "go"
match cmd {
    "stop" => print("stopping")
    "go" => print("going")
    other => print("unknown \(other)")
}
--- stdout
zero
small
medium
large
going

=== match with guards
fn classify(n: int) -> str {
    match n {
        x if x < 0 => "negative"
        0 => "zero"
        x if x % 2 == 0 => "even"
        _ => "odd"
    }
}
print([-3, 0, 4, 7].map(classify))
--- stdout
["negative", "zero", "even", "odd"]

=== match arms separated by commas on one line
let v = match 2 { 1 => "a", 2 => "b", _ => "c" }
print(v)
--- stdout
b

=== return from nested loops
fn find(grid: [[int]], target: int) -> (int, int)? {
    for (r, row) in grid.enumerate() {
        for (c, v) in row.enumerate() {
            if v == target { return Some((r, c)) }
        }
    }
    None
}
print(find([[1, 2], [3, 4]], 4))
print(find([[1]], 9))
--- stdout
Some((1, 1))
None

