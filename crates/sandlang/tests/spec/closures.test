=== lambda forms
let a = x => x + 1
let b = (x, y) => x * y
let c = (s: str) => s.len()
let d = () => 42
let e = x => {
    let y = x * 2
    y + 1
}
print(a(1))
print(b(3, 4))
print(c("abc"))
print(d())
print(e(5))
--- stdout
2
12
3
42
11

=== lambda parameter types inferred from use
let f = x => x * 2
print(f(21))
--- stdout
42

=== lambda without enough type information
let f = x => x.len()
--- error
1: type annotation needed

=== capturing let bindings copies values
let n = 10
let add_n = x => x + n
print(add_n(5))
--- stdout
15

=== capturing var bindings shares them
var count = 0
let inc = () => { count += 1 }
inc()
inc()
print(count)
count = 100
inc()
print(count)
--- stdout
2
101

=== closures as counters
fn make_counter() -> fn() -> int {
    var n = 0
    () => {
        n += 1
        n
    }
}
let c1 = make_counter()
let c2 = make_counter()
print(c1())
print(c1())
print(c2())
--- stdout
1
2
1

=== closures in loops capture each iteration
let fs = []
for i in 0..3 {
    fs.push(() => i * 10)
}
print(fs.map(f => f()))
--- stdout
[0, 10, 20]

=== nested closures
fn adder(a: int) -> fn(int) -> fn(int) -> int {
    b => c => a + b + c
}
print(adder(1)(2)(3))
--- stdout
6

=== closure captured var mutated from inner lambda in loop
var total = 0
[1, 2, 3].each(x => { total += x })
print(total)
--- stdout
6

=== return inside lambda returns from lambda
fn f() -> [int] {
    [1, 2, 3].map(x => {
        if x == 2 { return 20 }
        x
    })
}
print(f())
--- stdout
[1, 20, 3]

=== question mark inside lambda uses lambda return type
let parse_all = (xs: [str]) => xs.map(s => s.parse_int()).filter_map(x => x)
print(parse_all(["1", "x", "3"]))
let first_plus_one = (xs: [int]) => {
    let v = xs.first()?
    Some(v + 1)
}
print(first_plus_one([5]))
print(first_plus_one([]))
--- stdout
[1, 3]
Some(6)
None

=== lambda with wrong argument count
let f = (a: int, b: int) => a + b
print(f(1))
--- error
2: expected 2 arguments

=== lambda type mismatch against expected
fn apply(f: fn(int) -> int) -> int { f(1) }
print(apply(s => s.len()))
--- error
2: no method `len` on type int

=== function type display
fn takes(f: fn(int, str) -> bool) {}
takes(1)
--- error
2: expected fn(int, str) -> bool, found int

=== closures capture locals passed only to inlined calls
fn add1(a: int) -> int { a + 1 }
fn adder(x: int) -> fn() -> int {
    () => add1(x)
}
print(adder(5)())
--- stdout
6
