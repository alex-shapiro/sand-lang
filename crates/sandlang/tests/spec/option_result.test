=== option methods
let a = Some(5)
let n: int? = None
print(a.is_some())
print(n.is_none())
print(a.unwrap())
print(n.unwrap_or(0))
print(a.map(x => x * 2))
print(n.map(x => x * 2))
print(a.and_then(x => if x > 3 { Some(x) } else { None }))
print(n.or_else(() => Some(9)))
print(a.ok_or("missing"))
print(n.ok_or("missing"))
print(a.filter(x => x > 10))
print(a.expect("needed"))
--- stdout
true
true
5
0
Some(10)
None
Some(5)
Some(9)
Ok(5)
Err("missing")
None
5

=== unwrap on none fails
let n: int? = None
print(n.unwrap())
--- fail
unwrap on None

=== expect on none fails with its message
let n: str? = None
print(n.expect("config value"))
--- fail
config value

=== result methods
let ok: Result<int, str> = Ok(2)
let bad: Result<int, str> = Err("nope")
print(ok.is_ok())
print(bad.is_err())
print(ok.unwrap())
print(bad.unwrap_or(0))
print(bad.unwrap_err())
print(ok.map(x => x + 1))
print(bad.map_err(e => e.len()))
print(ok.and_then(x => if x > 1 { Ok(x * 10) } else { Err("small") }))
print(ok.ok())
print(bad.ok())
print(bad.err())
--- stdout
true
true
2
0
nope
Ok(3)
Err(4)
Ok(20)
Some(2)
None
Some("nope")

=== unwrap on err fails with the error
let r: Result<int> = Err(Error("disk full"))
print(r.unwrap())
--- fail
unwrap on Err: error: disk full

=== question mark on option
fn first_even(xs: [int]) -> int? {
    let x = xs.find(x => x % 2 == 0)?
    Some(x * 100)
}
print(first_even([1, 4]))
print(first_even([1, 3]))
--- stdout
Some(400)
None

=== question mark on result
fn parse(s: str) -> Result<int, str> {
    match s.parse_int() {
        Some(v) => Ok(v)
        None => Err("not a number: \(s)")
    }
}
fn sum2(a: str, b: str) -> Result<int, str> {
    let x = parse(a)?
    let y = parse(b)?
    Ok(x + y)
}
print(sum2("1", "2"))
print(sum2("1", "x"))
--- stdout
Ok(3)
Err("not a number: x")

=== question mark error types must match
fn a() -> Result<int, str> { Ok(1) }
fn b() -> Result<int, int> {
    let v = a()?
    Ok(v)
}
--- error
3: type mismatch

=== question mark in function returning non option
fn f() -> int {
    let v = Some(1)?
    v
}
--- error
2: `?`

=== question mark at top level aborts on err
fn fails() -> Result<int> { Err(Error("bad input", kind: "parse")) }
print("start")
let v = fails()?
print("unreachable")
--- stdout
start
--- fail
parse: bad input

=== top level question mark fails with the error
let v: int = Err(Error("bad input", kind: "parse"))?
--- fail
parse: bad input

=== coalesce operator
let n: int? = None
print(n ?? 7)
print(Some(1) ?? 7)
let r: Result<str, str> = Err("e")
print(r ?? "default")
let chain: int? = None
print(chain ?? n ?? 3)
--- stdout
7
1
default
3

=== coalesce is lazy
fn boom() -> int { fail("evaluated") }
print(Some(1) ?? boom())
--- stdout
1

=== option shorthand type
fn find(xs: [str], t: str) -> int? {
    xs.index_of(t)
}
let r: int? = find(["a"], "a")
print(r)
--- stdout
Some(0)

=== nested options
let x: int?? = Some(None)
print(x)
print(x.unwrap().is_none())
--- stdout
Some(None)
true

=== error construction and fields
let e = Error("missing file", kind: "not_found")
print(e.kind)
print(e.message)
print(e)
--- stdout
not_found
missing file
not_found: missing file

=== inline and nested variant representations
enum E {
    A(int)
    B(str)
    C(E)
    D(int, int)
    F
    G(float)
    H(bool)
    I(duration)
    J(())
}

let vals = [E.A(1), E.B("x"), E.C(E.A(2)), E.C(E.F), E.C(E.C(E.F)), E.D(1, 2), E.F, E.G(1.5), E.H(true), E.I(2s), E.J(())]
for v in vals {
    print(v)
}
print(vals == [E.A(1), E.B("x"), E.C(E.A(2)), E.C(E.F), E.C(E.C(E.F)), E.D(1, 2), E.F, E.G(1.5), E.H(true), E.I(2s), E.J(())])
print(E.C(E.A(2)) == E.C(E.A(3)))
print(E.C(E.F) == E.C(E.A(1)))
print(E.A(1) == E.G(1.0))

let nested = [Some(Some(1)), Some(None), None, Some(Some(2))]
print(nested)
let deeper = [Some(Some(None)), Some(Some(Some(3))), None, Some(None)]
print(deeper)
let n2: int?? = Some(None)
print(n2 == None)
print(n2.unwrap() == None)
match Some(Some(Some(3))) {
    Some(Some(Some(x))) => print("deep \(x)")
    _ => print("no")
}
let r: Result<int?, str> = Ok(Some(4))
match r {
    Ok(Some(x)) => print("ok some \(x)")
    Ok(None) => print("ok none")
    Err(e) => print("err \(e)")
}
let e2: Result<Result<int, str>, str> = Err("outer")
print(e2)
let e3: Result<Result<int, str>, str> = Ok(Err("inner"))
print(e3)
print(e3.unwrap().unwrap_err())

// Ordering: variants order by declaration, then payload.
print([Some(3), None, Some(1), Some(-2)].sorted())
print([E.G(2.0), E.A(5), E.F, E.A(-1), E.C(E.A(1)), E.C(E.F), E.B("b"), E.B("a")].sorted())
print([Some(Some(2)), Some(None), Some(Some(1)), None].sorted())

// Hashing: inline and heap variants as keys.
let m = [Some(1): "one", None: "none", Some(2): "two"]
print(m[Some(1)])
print(m.get(Some(3)))
enum K {
    A(int)
    C(K)
    F
}
let s = Set([K.A(1), K.A(1), K.C(K.F), K.C(K.F), K.C(K.A(1)), K.C(K.A(1)), K.F])
print(s.len())
print(s.contains(K.C(K.A(1))))
print(s.contains(K.C(K.A(2))))
let mm = [Some(Some(1)): 1]
print(mm.get(Some(Some(1))))
print([Some("a"), Some("a"), None, Some("b")].unique())

// Captured, stored and passed around.
let label = Some("captured")
let f = () => label.unwrap() + "!"
print(f())
struct Box {
    v: str?
}
let b = Box(v: Some("in struct"))
print(b.v ?? "none")
fn first_even(xs: [int]) -> int? {
    for x in xs {
        if x % 2 == 0 {
            return Some(x)
        }
    }
    None
}
fn sum_evens(a: [int], b: [int]) -> int? {
    let x = first_even(a)?
    let y = first_even(b)?
    Some(x + y)
}
print(sum_evens([1, 2], [3, 4]))
print(sum_evens([1, 3], [4]))
print("\(Some(1.5)) \(Some(true)) \(Some(()))")
let okv: Result<str, str> = Ok("s")
print("\(okv) \(okv:?)")
