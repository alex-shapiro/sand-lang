//! JSON encoding and decoding (RFC 8259).
//!
//! ### Enum Representation
//!
//! - Unit variants are encoded as strings such as `"Red"`.
//! - Tuple variants are encoded as `{"Variant": [f0, f1, ...]}`.
//! - Struct variants are encoded as `{"Variant": {...}}`.
//! - `Some(x)` is encoded as `x`.
//! - `None` is encoded as `null`.
//! - `Json` values are encoded directly as their JSON data.
//!
//! ### Other Type Representations
//!
//! - `()` is encoded as `null`.
//! - `bytes` is encoded as a standard Base64 string.
//! - `duration` is encoded as an integer nanosecond count.
//! - `Range` is encoded as an object with `start`, `end`, and optional `inclusive` fields.
//! - Native value types are encoded as their canonical text forms.

extend Json {
    /// Returns the field `key` if `self` is an `Obj`, or `None` otherwise.
    pub fn get(self, key: str) -> Json? {
        match self {
            Obj(fields) => fields.get(key)
            _ => None
        }
    }

    /// Returns the element at index `i` if `self` is an `Arr` and `i` is in
    /// bounds, or `None` otherwise.
    pub fn at(self, i: int) -> Json? {
        match self {
            Arr(items) => items.get(i)
            _ => None
        }
    }

    /// Returns the string payload if `self` is `Str`, or `None` otherwise.
    pub fn as_str(self) -> str? {
        match self {
            Str(s) => Some(s)
            _ => None
        }
    }

    /// Returns the numeric value as a `float` if `self` is `Int` or `Float`, or
    /// `None` otherwise.
    pub fn as_float(self) -> float? {
        match self {
            Int(i) => Some(i.to_float())
            Float(f) => Some(f)
            _ => None
        }
    }

    /// Returns the numeric value as an `int` if `self` is `Int` or an integral
    /// `Float` within `±2^53`, or `None` otherwise.
    pub fn as_int(self) -> int? {
        match self {
            Int(i) => Some(i)
            Float(f) if f == f.floor() and f.abs() <= 9007199254740992.0 => Some(f.to_int())
            _ => None
        }
    }

    /// Returns the boolean payload if `self` is `Bool`, or `None` otherwise.
    pub fn as_bool(self) -> bool? {
        match self {
            Bool(b) => Some(b)
            _ => None
        }
    }

    /// Returns the array elements if `self` is `Arr`, or `None` otherwise.
    pub fn as_list(self) -> [Json]? {
        match self {
            Arr(items) => Some(items)
            _ => None
        }
    }

    /// Returns the object entries if `self` is `Obj`, or `None` otherwise.
    pub fn as_map(self) -> [str: Json]? {
        match self {
            Obj(fields) => Some(fields)
            _ => None
        }
    }

    /// Returns `true` if `self` is `Null`.
    pub fn is_null(self) -> bool {
        match self {
            Null => true
            _ => false
        }
    }

    /// Traverses a dot-separated path of object keys and array indices, such as
    /// `"items.0.name"`. Returns itself if the path is empty.
    pub fn path(self, p: str) -> Json? {
        if p.is_empty() {
            return Some(self)
        }
        var cur = self
        for part in p.split(".") {
            cur = match cur {
                Arr(items) => items.get(part.parse_int()?)?
                _ => cur.get(part)?
            }
        }
        Some(cur)
    }
}

/// Parses `text` as a `Json` value.
///
/// Numbers without a decimal point, exponent, or `-0` that fit in a 64-bit
/// signed integer parse as `Json.Int`; all other numbers parse as `Json.Float`.
/// Fails with kind `"parse"` if syntax is invalid or if array or object nesting
/// exceeds 512 levels.
pub native fn parse(text: str) -> Result<Json>

/// Encodes `value` as JSON text.
///
/// Emits compact output if `indent <= 0`. Pretty-prints with `indent` spaces
/// per level if `indent > 0`. Finite floats are formatted with a decimal point
/// or exponent.
///
/// Map keys are formatted as JSON object keys for these key types:
///
/// - `str`
/// - `int`
/// - `duration`
/// - `bool`
/// - unit enum variants
/// - native value types
///
/// Fails with kind `"invalid"` for a non-finite float or an unsupported map
/// key type. Fails with kind `"limit"` if nesting exceeds 512 levels.
/// Propagates any error returned by a custom `Encode.encode` implementation.
pub native fn encode<T: Encode>(value: T, indent: int = 0) -> Result<str>

/// Decodes JSON `text` into a value of type `T`.
///
/// `decode` ignores unknown struct fields. For a map, `decode` overwrites
/// earlier entries on duplicate keys. For a struct, `decode` fails with kind
/// `"parse"` on duplicate fields.
///
/// If a JSON object omits a struct field, `decode` uses the field's declared
/// default. If an omitted `Option` field lacks a declared default, `decode`
/// sets it to `None`. If a struct declares `init`, `decode` reads each `init`
/// parameter from the JSON object. It then calls `init`. Any `init` parameter
/// can be provided in the JSON object, even if the parameter has a default.
///
/// `decode` runs custom `Decode.decode` methods, `init`, and computed defaults
/// as it visits each value. `decode` executes earlier callbacks even if it
/// rejects a later value.
///
/// Fails with kind `"parse"` on invalid JSON syntax, missing required fields,
/// or type mismatches. `decode` prefixes value error messages with the JSON
/// path, such as `$.items[2].price`.
pub native fn decode<T: Decode>(text: str) -> Result<T>

/// Converts `value` into a `Json` value with the same representation as
/// `encode`.
///
/// Aborts with the error that `encode(value)` would return.
pub native fn to_json<T: Encode>(value: T) -> Json
