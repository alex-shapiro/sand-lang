//! Fetches a web page and reports its title, headings and links.
//!
//! Usage: sand run --allow-net=example.com examples/http_fetch.sand -- https://example.com/

import env
import http
import regex
import uri

struct Page {
    url: str
    status: int
    title: str?
    headings: [str]
    links: [str]
}

/// Decodes the handful of HTML entities that commonly appear in text.
fn unescape(s: str) -> str {
    s.replace("&lt;", "<")
        .replace("&gt;", ">")
        .replace("&quot;", "\"")
        .replace("&#39;", "'")
        .replace("&amp;", "&")
}

fn strip_tags(s: str) -> Result<str> {
    let tags = regex.new("<[^>]*>")?
    let spaces = regex.new(r"\s+")?
    Ok(unescape(spaces.replace_all(tags.replace_all(s, ""), " ").trim()))
}

fn parse_page(url: str, status: int, html: str) -> Result<Page> {
    let base = uri.parse(url)?
    let title_re = regex.new(r"(?is)<title[^>]*>(.*?)</title>")?
    let heading_re = regex.new(r"(?is)<h([1-3])[^>]*>(.*?)</h[1-3]>")?
    let link_re = regex.new(r#"(?i)<a\s[^>]*href\s*=\s*["']([^"']+)["']"#)?

    let title = match title_re.captures(html) {
        Some(c) => Some(strip_tags(c.text(1) ?? "")?)
        None => None
    }
    let headings = []
    for c in heading_re.captures_all(html) {
        let level = c.text(1).and_then(l => l.parse_int()) ?? 1
        headings.push("  ".repeat(level - 1) + strip_tags(c.text(2) ?? "")?)
    }
    let links = []
    let seen = set()
    for c in link_re.captures_all(html) {
        let href = unescape(c.text(1) ?? "")
        if href.starts_with("#") or href.starts_with("javascript:") or href.starts_with("mailto:") {
            continue
        }
        let resolved = base.join(href)?.to_str()
        if seen.add(resolved) {
            links.push(resolved)
        }
    }
    Ok(Page { url, status, title, headings, links })
}

fn fetch(url: str) -> Result<Page> {
    let resp = http.get(url, headers: ["user-agent": "sand-fetch/0.1"], timeout: 10s)?
    if not resp.ok() {
        return Err(error("{url} returned status {resp.status}", kind: "http"))
    }
    let content_type = resp.header("content-type") ?? "text/html"
    if not content_type.contains("html") {
        return Err(error("{url} is not HTML ({content_type})", kind: "invalid"))
    }
    parse_page(resp.url, resp.status, resp.text()?)
}

let urls = env.args()
if urls.is_empty() {
    eprint("usage: http_fetch.sand URL...")
    exit(2)
}

// Fetch all pages concurrently.
let tasks = urls.map(u => spawn fetch(u))
for (url, t) in urls.zip(tasks) {
    match t.wait() {
        Ok(page) => {
            print("{page.url} [{page.status}]")
            print("title: {page.title ?? "(none)"}")
            print("headings:")
            for h in page.headings { print("  {h}") }
            print("links ({page.links.len()}):")
            for l in page.links { print("  {l}") }
        }
        Err(e) => print("{url}: {e}")
    }
}
