//! A small text adventure. Reads commands from standard input.
//!
//! Commands: look, go DIRECTION (or n/s/e/w), take ITEM, drop ITEM,
//! use ITEM, inventory (or i), help, quit.

import io

enum Dir {
    North, South, East, West

    fn parse(s: str) -> Dir? {
        match s {
            "north" | "n" => Some(Dir.North)
            "south" | "s" => Some(Dir.South)
            "east" | "e" => Some(Dir.East)
            "west" | "w" => Some(Dir.West)
            _ => None
        }
    }

    fn name(self) -> str {
        match self {
            North => "north"
            South => "south"
            East => "east"
            West => "west"
        }
    }
}

struct Room {
    name: str
    description: str
    exits: [Dir: str]
    items: Set<str>
    var locked: Dir? = None
}

struct Game {
    rooms: [str: Room]
    var here: str
    inventory: Set<str> = Set()
    var moves: int = 0
    var won: bool = false

    fn room(self) -> Room { self.rooms[self.here] }

    fn describe(self) -> str {
        let r = self.room()
        let exits = r.exits.keys().map(d => d.name()).join(", ")
        var text = "== \(r.name) ==\n\(r.description)\nExits: \(exits)"
        if not r.items.is_empty() {
            text += "\nYou see: \(r.items.to_list().sorted().join(", "))"
        }
        text
    }

    fn go(self, d: Dir) -> str {
        let r = self.room()
        let Some(dest) = r.exits.get(d) else { return "You can't go \(d.name())." }
        if r.locked == Some(d) {
            return "The door to the \(d.name()) is locked."
        }
        self.here = dest
        self.moves += 1
        if self.here == "vault" {
            self.won = true
            return self.describe() + "\nYou found the treasure in \(self.moves) moves. You win!"
        }
        self.describe()
    }

    fn take(self, item: str) -> str {
        let r = self.room()
        if not r.items.remove(item) {
            return "There is no \(item) here."
        }
        self.inventory.add(item)
        "Taken: \(item)."
    }

    fn drop(self, item: str) -> str {
        if not self.inventory.remove(item) {
            return "You don't have \(item)."
        }
        self.room().items.add(item)
        "Dropped: \(item)."
    }

    fn use_item(self, item: str) -> str {
        if not self.inventory.contains(item) {
            return "You don't have \(item)."
        }
        let r = self.room()
        match (item, r.locked) {
            ("key", Some(d)) => {
                r.locked = None
                "You unlock the door to the \(d.name())."
            }
            _ => "Nothing happens."
        }
    }

    fn command(self, line: str) -> str? {
        let words = line.trim().to_lower().split_whitespace()
        match words {
            [] => Some("")
            ["quit"] | ["exit"] => None
            ["look"] | ["l"] => Some(self.describe())
            ["inventory"] | ["i"] => Some(if self.inventory.is_empty() {
                "You are empty-handed."
            } else {
                "You carry: \(self.inventory.to_list().sorted().join(", "))"
            })
            ["go", d] | [d] if Dir.parse(d).is_some() => Some(self.go(Dir.parse(d).unwrap()))
            ["take", item] => Some(self.take(item))
            ["drop", item] => Some(self.drop(item))
            ["use", item] => Some(self.use_item(item))
            ["help"] => Some("Commands: look, go DIR, take ITEM, drop ITEM, use ITEM, inventory, quit")
            _ => Some("I don't understand that.")
        }
    }
}

fn world() -> [str: Room] {
    [
        "hall": Room(
            name: "Great Hall",
            description: "A dusty hall with portraits on the walls.",
            exits: [Dir.North: "library", Dir.East: "kitchen"],
            items: Set(["lamp"]),
        ),
        "library": Room(
            name: "Library",
            description: "Shelves of crumbling books. A heavy door leads east.",
            exits: [Dir.South: "hall", Dir.East: "vault"],
            items: Set(["book"]),
            locked: Some(Dir.East),
        ),
        "kitchen": Room(
            name: "Kitchen",
            description: "It smells of old bread.",
            exits: [Dir.West: "hall"],
            items: Set(["key", "bread"]),
        ),
        "vault": Room(
            name: "Vault",
            description: "Gold glitters everywhere.",
            exits: [Dir.West: "library"],
            items: Set(["treasure"]),
        ),
    ]
}

let game = Game(rooms: world(), here: "hall")
print(game.describe())
while not game.won {
    io.stdout.write_str("> ")?
    let Some(line) = io.stdin.read_line()? else { break }
    match game.command(line) {
        Some(reply) => if not reply.is_empty() { print(reply) }
        None => {
            print("Goodbye.")
            break
        }
    }
}
