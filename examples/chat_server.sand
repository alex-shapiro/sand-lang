//! A line-oriented TCP chat server.
//!
//! Usage: sand run --allow='listen 127.0.0.1:7000' examples/chat_server.sand -- 7000
//!
//! Commands: `/nick NAME`, `/who`, `/quit`. Any other line is broadcast.

import env
import log
import net

struct Client {
    id: int
    var name: str
    conn: net.Conn
}

impl Close for Client {
    fn close(self) {
        self.conn.close()
    }
}

let clients: [int: Client] = [:]
var next_id = 0

fn send(c: Client, text: str) {
    // A client that has gone away is cleaned up by its own handler.
    let _ = c.conn.write_str(text + "\n")
}

fn broadcast(sender: int, text: str) {
    for (id, c) in clients {
        if id != sender {
            send(c, text)
        }
    }
}

fn handle(c: Client) {
    // However the loop below ends, the client leaves.
    defer {
        clients.remove(c.id)
        c.close()
        broadcast(c.id, "* \(c.name) left")
        log.info("client left", fields: ["name": c.name])
    }
    send(c, "welcome \(c.name)")
    broadcast(c.id, "* \(c.name) joined")
    while let Ok(Some(line)) = c.conn.read_line() {
        let text = line.trim()
        if text.is_empty() {
            continue
        }
        if let Some(nick) = text.strip_prefix("/nick ") {
            let old = c.name
            c.name = nick.trim()
            broadcast(c.id, "* \(old) is now \(c.name)")
            send(c, "you are now \(c.name)")
        } else if text == "/who" {
            send(c, "online: \(clients.values().map(x => x.name).join(", "))")
        } else if text == "/quit" {
            break
        } else {
            broadcast(c.id, "\(c.name): \(text)")
        }
    }
}

let port = match env.args().first() {
    Some(arg) => arg.parse_int().ok_or(Error("invalid port \(arg)", kind: "invalid"))?
    None => 7000
}
use listener = net.listen("127.0.0.1", port)?
print("listening on \(listener.addr())")

loop {
    let conn = listener.accept()?
    next_id += 1
    let client = Client(id: next_id, name: "guest\(next_id)", conn: conn)
    clients[client.id] = client
    log.info("client joined", fields: ["peer": "\(conn.peer_addr())"])
    spawn handle(client)
}
