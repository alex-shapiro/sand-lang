import fs
// Typo: "notfound" instead of "not_found". It compiles, lints clean, and the
// fallback never runs.
let text = match fs.read_text("missing-config.json") {
    Ok(t) => t
    Err(e) if e.kind == "notfound" => "{}"
    Err(e) => fail("cannot read config: \(e)", kind: e.kind)
}
print(text)
