import fs
// `Error.kind` is an enum (`ErrorKind { NotFound, PermissionDenied, ..., Other(str) }`),
// so a misspelled kind does not compile.
let text = match fs.read_text("missing-config.json") {
    Ok(t) => t
    Err(e) if e.kind == NotFound => "{}"
    Err(e) => fail("cannot read config: \(e)", kind: e.kind)
}
print(text)
