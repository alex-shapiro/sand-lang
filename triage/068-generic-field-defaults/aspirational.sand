import json

struct Stats<T: Num> {
    var total: T = T.zero()
    var count: int = 0

    fn add(self, x: T) {
        self.total = self.total + x
        self.count += 1
    }
}

let s: Stats<float> = Stats()
s.add(2.5)
print(s)

let d: Result<Stats<float>> = json.decode("{\"count\": 0}")
print(d)
