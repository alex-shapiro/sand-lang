import json

// Workaround: no `T.zero()` default, so every caller must go through `new()`,
// and `json.decode` cannot fill in a missing `total`.
struct Stats<T: Num> {
    var total: T
    var count: int = 0

    fn new() -> Stats<T> { Stats(total: T.zero()) }

    fn add(self, x: T) {
        self.total = self.total + x
        self.count += 1
    }
}

let s: Stats<float> = Stats.new()
s.add(2.5)
print(s)

let d: Result<Stats<float>> = json.decode("{\"count\": 0}")
print(d)
