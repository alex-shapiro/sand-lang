// Workaround: match on magic ints and add a wildcard arm that cannot happen.
import time
let a = time.Span(hours: 25)
let b = time.Span(days: 1)
let verdict = match a.compare(b) {
    -1 => "shorter"
    0 => "same"
    1 => "longer"
    _ => fail("compare returned an unexpected value")
}
print(verdict)
// A wrong constant compiles and is silently false.
print("longer (typo 2): \(a.compare(b) == 2)")
