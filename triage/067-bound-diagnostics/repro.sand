// The cause is `Set<(float, float)>` on line 3, but no error points there.
// `float` does not implement `Hash`.
fn dedupe(points: [(float, float)]) -> Set<(float, float)> {
    let seen: Set<(float, float)> = Set()
    for p in points {
        if not seen.contains(p) {
            seen.insert(p)
        }
    }
    seen
}

print(dedupe([(1.0, 2.0), (1.0, 2.0)]).len())
