import fs
// The natural walk: "not a file" means "a directory". A FIFO, socket, or device
// has `is_file == false` and `is_dir == false`, so the walk calls `list_dir` on it.
fn walk(dir: str) -> Result<()> {
    for name in fs.list_dir(dir)? {
        let path = fs.join([dir, name])
        let m = fs.metadata(path)?
        if m.is_file { print("file \(path)") } else { walk(path)? }
    }
    Ok(())
}
walk("tree")?
