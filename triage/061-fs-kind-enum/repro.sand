import fs
// Workaround: test both flags and add a third branch for "neither".
fn walk(dir: str) -> Result<()> {
    for name in fs.list_dir(dir)? {
        let path = fs.join([dir, name])
        let m = fs.metadata(path)?
        if m.is_file {
            print("file \(path)")
        } else if m.is_dir {
            walk(path)?
        } else {
            print("skip \(path)")
        }
    }
    Ok(())
}
walk("tree")?
