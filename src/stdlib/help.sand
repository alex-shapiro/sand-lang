//! Documentation of functions and modules.

/// The doc comment of a function value (`""` if it has none).
pub native fn doc<T>(f: T) -> str

/// The signature of a function value, e.g. `fn parse(text: str) -> Result<Json, Error>`.
pub native fn signature<T>(f: T) -> str

/// A summary of a standard or native module's public items, if it exists.
/// Lists signatures with the first line of their docs.
pub native fn module(name: str) -> str?

/// The names of all modules that can be imported by name.
pub native fn modules() -> [str]
