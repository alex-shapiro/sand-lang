//! Leveled logging to standard error.
//!
//! Records are written as `LEVEL message key=value ...`.

/// Logs `msg` at level `debug`.
pub native fn debug(msg: str, fields: [str: str] = [:])

/// Logs `msg` at level `info`.
pub native fn info(msg: str, fields: [str: str] = [:])

/// Logs `msg` at level `warn`.
pub native fn warn(msg: str, fields: [str: str] = [:])

/// Logs `msg` at level `error`.
pub native fn error(msg: str, fields: [str: str] = [:])

/// Sets the minimum level that is logged.
/// One of `"debug"`, `"info"` (the default), `"warn"`, `"error"` or `"off"`.
pub native fn set_level(level: str)
