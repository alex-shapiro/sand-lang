//! Structured leveled logging.
//!
//! The host receives the records. By default, it writes them to standard
//! error as `LEVEL message key=value ...`, and drops them if the policy
//! denies `Stderr`.

/// Logs `msg` and optional `fields` at level `debug`.
pub native fn debug(msg: str, fields: [str: str] = [:])

/// Logs `msg` and optional `fields` at level `info`.
pub native fn info(msg: str, fields: [str: str] = [:])

/// Logs `msg` and optional `fields` at level `warn`.
pub native fn warn(msg: str, fields: [str: str] = [:])

/// Logs `msg` and optional `fields` at level `error`.
pub native fn error(msg: str, fields: [str: str] = [:])

/// Sets the lowest level to log (`"debug"`, `"info"`, `"warn"`, `"error"`, or
/// `"off"`). The host sets the level at the start, by default `"info"`.
pub native fn set_level(level: str)
