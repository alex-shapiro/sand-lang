//! Assertions and property-based testing for `test` blocks.

import random

let PROPERTY_SEED = 20240611

/// Fails unless `actual == expected`, showing both values.
pub fn assert_eq<T: Eq>(actual: T, expected: T, msg: str = "") {
    if actual != expected {
        let head = if msg.is_empty() { "left == right" } else { msg }
        fail("\(head)\n  left: \(actual.debug())\n right: \(expected.debug())")
    }
}

/// Fails if `actual == expected`.
pub fn assert_ne<T: Eq>(actual: T, expected: T, msg: str = "") {
    if actual == expected {
        let head = if msg.is_empty() { "left != right" } else { msg }
        fail("\(head)\n  left: \(actual.debug())\n right: \(expected.debug())")
    }
}

/// Fails unless `cond` is true.
pub fn assert_true(cond: bool, msg: str = "") {
    if not cond {
        fail(if msg.is_empty() { "expected true" } else { msg })
    }
}

/// Fails unless `cond` is false.
pub fn assert_false(cond: bool, msg: str = "") {
    if cond {
        fail(if msg.is_empty() { "expected false" } else { msg })
    }
}

/// Fails unless `a` and `b` are equal within `tol`.
/// The tolerance is relative to the larger magnitude when that exceeds 1.
pub fn assert_close(a: float, b: float, tol: float = 1e-9) {
    let scale = 1.0.max(a.abs()).max(b.abs())
    if not (a == b or (a - b).abs() <= tol * scale) {
        fail("\(a) is not close to \(b) (tolerance \(tol))")
    }
}

/// Fails unless `r` is `Err`.
pub fn assert_err<T, E>(r: Result<T, E>) {
    if r.is_ok() {
        fail("expected Err, got \(r.debug())")
    }
}

/// Fails unless `r` is `Ok`.
pub fn assert_ok<T, E>(r: Result<T, E>) {
    if r.is_err() {
        fail("expected Ok, got \(r.debug())")
    }
}

/// Fails the current test with `msg` (kind `"assert"`).
pub native fn fail(msg: str) -> never

/// Checks that `prop` holds for `cases` values produced by `gen`.
/// Fails with the first failing input. The generator is seeded with `seed`
/// (fixed by default), so failures are reproducible.
pub fn property<T>(
    name: str,
    gen: fn(random.Rng) -> T,
    prop: fn(T) -> bool,
    cases: int = 100,
    seed: int = PROPERTY_SEED,
) {
    let rng = random.rng(seed)
    for _ in 0..cases {
        let input = gen(rng)
        if not prop(input) {
            fail("property `\(name)` failed for input: \(input.debug())")
        }
    }
}
