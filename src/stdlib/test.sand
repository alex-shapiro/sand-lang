//! Assertions and property-based testing for `test` blocks.

import random

let PROPERTY_SEED = 20240611

/// Panics unless `actual == expected`, showing both values.
pub fn assert_eq<T: Eq>(actual: T, expected: T, msg: str = "") {
    if actual != expected {
        let head = if msg.is_empty() { "assertion failed: left == right" } else { msg }
        panic("{head}\n  left: {actual.debug()}\n right: {expected.debug()}")
    }
}

/// Panics if `actual == expected`.
pub fn assert_ne<T: Eq>(actual: T, expected: T, msg: str = "") {
    if actual == expected {
        let head = if msg.is_empty() { "assertion failed: left != right" } else { msg }
        panic("{head}\n  left: {actual.debug()}\n right: {expected.debug()}")
    }
}

/// Panics unless `cond` is true.
pub fn assert_true(cond: bool, msg: str = "") {
    if not cond {
        panic(if msg.is_empty() { "assertion failed: expected true" } else { msg })
    }
}

/// Panics unless `cond` is false.
pub fn assert_false(cond: bool, msg: str = "") {
    if cond {
        panic(if msg.is_empty() { "assertion failed: expected false" } else { msg })
    }
}

/// Panics unless `a` and `b` are equal within `tol`.
/// The tolerance is relative to the larger magnitude when that exceeds 1.
pub fn assert_close(a: float, b: float, tol: float = 1e-9) {
    let scale = 1.0.max(a.abs()).max(b.abs())
    if not (a == b or (a - b).abs() <= tol * scale) {
        panic("assertion failed: {a} is not close to {b} (tolerance {tol})")
    }
}

/// Panics unless `r` is `Err`.
pub fn assert_err<T, E>(r: Result<T, E>) {
    if r.is_ok() {
        panic("assertion failed: expected Err, got {r.debug()}")
    }
}

/// Panics unless `r` is `Ok`.
pub fn assert_ok<T, E>(r: Result<T, E>) {
    if r.is_err() {
        panic("assertion failed: expected Ok, got {r.debug()}")
    }
}

/// Fails the current test with `msg`.
pub fn fail(msg: str) -> never {
    panic(msg)
}

/// Checks that `prop` holds for `cases` values produced by `gen`.
/// Panics with the first failing input. The generator has a fixed seed, so
/// failures are reproducible.
pub fn property<T>(name: str, gen: fn(random.Rng) -> T, prop: fn(T) -> bool, cases: int = 100) {
    let rng = random.rng(PROPERTY_SEED)
    for _ in 0..cases {
        let input = gen(rng)
        if not prop(input) {
            panic("property `{name}` failed for input: {input.debug()}")
        }
    }
}
