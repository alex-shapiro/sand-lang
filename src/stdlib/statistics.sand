//! Descriptive statistics and linear regression on numeric lists.
//!
//! Functions return `None` for empty inputs, or for inputs with fewer than two
//! elements in `variance`, `stdev`, `correlation`, and `linear_regression`,
//! except `sum`, which returns `0.0`. `NaN` values in `min`, `max`, `median`,
//! `mode`, and `quantile` are ordered after `+inf`.

/// Returns the arithmetic mean of `xs`, or `None` if `xs` is empty.
pub native fn mean(xs: [float]) -> float?

/// Returns the arithmetic mean of integer list `xs`, or `None` if `xs` is empty.
pub native fn mean_int(xs: [int]) -> float?

/// Returns the median of `xs`, averaging the two middle values for even
/// lengths, or `None` if `xs` is empty.
pub native fn median(xs: [float]) -> float?

/// Returns the most frequent value in `xs`, breaking ties by first appearance,
/// or `None` if `xs` is empty.
pub native fn mode(xs: [float]) -> float?

/// Returns the sample variance of `xs` divided by `n - 1`, or `None` if
/// `xs.len() < 2`.
pub native fn variance(xs: [float]) -> float?

/// Returns the sample standard deviation of `xs`, or `None` if `xs.len() < 2`.
pub native fn stdev(xs: [float]) -> float?

/// Returns the population variance of `xs` divided by `n`, or `None` if `xs`
/// is empty.
pub native fn pvariance(xs: [float]) -> float?

/// Returns the population standard deviation of `xs`, or `None` if `xs` is empty.
pub native fn pstdev(xs: [float]) -> float?

/// Returns the minimum value in `xs`, or `None` if `xs` is empty.
pub native fn min(xs: [float]) -> float?

/// Returns the maximum value in `xs`, or `None` if `xs` is empty.
pub native fn max(xs: [float]) -> float?

/// Returns the compensated sum of `xs`, or `0.0` if `xs` is empty.
pub native fn sum(xs: [float]) -> float

/// Returns the `q`-quantile of `xs` for `0.0 <= q <= 1.0` using linear
/// interpolation between adjacent ranks, or `None` if `xs` is empty or `q` is
/// out of range.
pub native fn quantile(xs: [float], q: float) -> float?

/// Returns the Pearson correlation coefficient of `xs` and `ys`, or `None` if
/// the lists differ in length, have fewer than two elements, or have zero
/// variance.
pub native fn correlation(xs: [float], ys: [float]) -> float?

/// Fits the ordinary least-squares line `y = slope * x + intercept` and returns
/// `(slope, intercept)`, or `None` if `xs` and `ys` differ in length, have
/// fewer than two elements, or `xs` has zero variance.
pub native fn linear_regression(xs: [float], ys: [float]) -> (float, float)?
