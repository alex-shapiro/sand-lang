let MAX_REDIRECTS = 10
let MAX_DRAINED = 64 * 1024

/// A complete HTTP response returned by `request`. Header names are normalized
/// to lowercase.
pub struct Response {
    /// HTTP status code (such as `200` or `404`).
    pub status: int
    /// Response headers in receipt order, with lowercase names.
    pub headers: [(str, str)]
    /// Response body bytes.
    pub body: bytes
    /// Final URL after any redirects.
    pub url: str

    /// Decodes the response body as UTF-8 text.
    pub fn text(self) -> Result<str> {
        self.body.to_str()
    }

    /// Parses the response body as JSON.
    pub fn json(self) -> Result<json.Json> {
        json.parse(self.text()?)
    }

    /// Returns `true` if `status` is in `200..=299`.
    pub fn ok(self) -> bool {
        self.status >= 200 and self.status <= 299
    }

    /// Returns the first value for header `name` (case-insensitive).
    pub fn header(self, name: str) -> str? {
        find_header(self.headers, name)
    }

    /// Returns all values for header `name` (case-insensitive) in receipt order.
    pub fn header_values(self, name: str) -> [str] {
        header_values(self.headers, name)
    }
}

/// An HTTP response with a streaming `Body`, returned by `open`. The underlying
/// connection remains open until the body is read to completion or the `Stream`
/// is closed.
pub struct Stream {
    /// HTTP status code (such as `200` or `404`).
    pub status: int
    /// Response headers in receipt order, with lowercase names.
    pub headers: [(str, str)]
    /// Streaming response body.
    pub body: Body
    /// Final URL after any redirects.
    pub url: str

    /// Returns `true` if `status` is in `200..=299`.
    pub fn ok(self) -> bool {
        self.status >= 200 and self.status <= 299
    }

    /// Returns the first value for header `name` (case-insensitive).
    pub fn header(self, name: str) -> str? {
        find_header(self.headers, name)
    }

    /// Returns all values for header `name` (case-insensitive) in receipt order.
    pub fn header_values(self, name: str) -> [str] {
        header_values(self.headers, name)
    }
}

impl Close for Stream {
    /// Closes the response body and underlying connection.
    fn close(self) {
        self.body.close()
    }
}

impl io.Reader for Body {
    native fn read(self, max: int) -> Result<bytes>
    native fn read_line(self) -> Result<str?>
    native fn read_all(self) -> Result<bytes>
}

impl Close for Body {
    /// Closes the body stream and releases the underlying connection.
    native fn close(self)
}

fn find_header(headers: [(str, str)], name: str) -> str? {
    let lower = name.to_lower()
    for (k, v) in headers {
        if k == lower or k.to_lower() == lower {
            return Some(v)
        }
    }
    None
}

fn header_values(headers: [(str, str)], name: str) -> [str] {
    let lower = name.to_lower()
    [v for (k, v) in headers if k == lower or k.to_lower() == lower]
}

/// Sends an HTTP `GET` request and follows redirects.
pub fn get(url: str, headers: [(str, str)] = [], timeout: duration = 30s) -> Result<Response> {
    request("GET", url, headers: headers, timeout: timeout)
}

/// Sends an HTTP `POST` request with `body` and follows redirects.
pub fn post(
    url: str,
    body: bytes,
    headers: [(str, str)] = [],
    timeout: duration = 30s,
) -> Result<Response> {
    request("POST", url, headers: headers, body: body, timeout: timeout)
}

/// Sends an HTTP `POST` request with `value` encoded as JSON.
pub fn post_json<T>(
    url: str,
    value: T,
    headers: [(str, str)] = [],
    timeout: duration = 30s,
) -> Result<Response> {
    request_json("POST", url, value, headers: headers, timeout: timeout)
}

/// Sends an HTTP `PUT` request with `value` encoded as JSON.
pub fn put_json<T>(
    url: str,
    value: T,
    headers: [(str, str)] = [],
    timeout: duration = 30s,
) -> Result<Response> {
    request_json("PUT", url, value, headers: headers, timeout: timeout)
}

/// Sends an HTTP `PATCH` request with `value` encoded as JSON.
pub fn patch_json<T>(
    url: str,
    value: T,
    headers: [(str, str)] = [],
    timeout: duration = 30s,
) -> Result<Response> {
    request_json("PATCH", url, value, headers: headers, timeout: timeout)
}

/// Sends an HTTP request with `value` encoded as JSON, setting
/// `Content-Type: application/json` if `headers` does not specify a
/// `Content-Type`.
pub fn request_json<T>(
    method: str,
    url: str,
    value: T,
    headers: [(str, str)] = [],
    timeout: duration = 30s,
    follow_redirects: bool = true,
) -> Result<Response> {
    let content_type = if find_header(headers, "content-type").is_some() {
        []
    } else {
        [("Content-Type", "application/json")]
    }
    request(
        method,
        url,
        headers: headers + content_type,
        body: json.encode(value).bytes(),
        timeout: timeout,
        follow_redirects: follow_redirects,
    )
}

/// Sends an HTTP request and reads the entire response body. Follows up to 10
/// redirects (`301`, `302`, `303`, `307`, `308`) if `follow_redirects` is
/// `true`, converting `303` redirects into bodyless `GET` requests. Non-2xx
/// status codes are returned in `Response` rather than as `Err`. Fails with
/// kind `"limit"` if the response body exceeds `max_http_body`.
pub fn request(
    method: str,
    url: str,
    headers: [(str, str)] = [],
    body: bytes = b"",
    timeout: duration = 30s,
    follow_redirects: bool = true,
) -> Result<Response> {
    use s = open(
        method,
        url,
        headers: headers,
        body: body,
        timeout: timeout,
        follow_redirects: follow_redirects,
    )?
    let data = s.body.read_all()?
    Ok(Response { status: s.status, headers: s.headers, body: data, url: s.url })
}

/// Sends an HTTP request and returns a `Stream` as soon as the response headers
/// arrive so the body can be read incrementally. Bind the returned `Stream`
/// with `use` or close it after reading.
///
/// ```
/// use resp = http.open("GET", "https://example.com/big.iso")?
/// use out = fs.open("big.iso", fs.Mode.Write)?
/// io.copy(resp.body, out)?
/// ```
pub fn open(
    method: str,
    url: str,
    headers: [(str, str)] = [],
    body: bytes = b"",
    timeout: duration = 30s,
    follow_redirects: bool = true,
) -> Result<Stream> {
    var current_url = url
    var current_method = method
    var current_headers = headers
    var current_body = body
    var redirects = 0
    loop {
        let (status, resp_headers, resp_body) = send(
            current_method,
            current_url,
            current_headers,
            current_body,
            timeout,
        )?
        let response = Stream { status, headers: resp_headers, body: resp_body, url: current_url }
        if not follow_redirects or not [301, 302, 303, 307, 308].contains(status) {
            return Ok(response)
        }
        let Some(location) = response.header("location") else { return Ok(response) }
        // Drain small redirect bodies so the connection can be reused for the next request.
        if (response.header("content-length") ?? "").parse_int().unwrap_or(MAX_DRAINED + 1)
            <= MAX_DRAINED {
            let _ = response.body.read_all()
        }
        response.close()
        if redirects == MAX_REDIRECTS {
            return Err(error("too many redirects", kind: "http"))
        }
        redirects += 1
        let next = resolve(current_url, location)?
        if not same_origin(current_url, next) {
            // Strip credentials before following a cross-origin redirect.
            current_headers = current_headers.filter(
                h => not ["authorization", "cookie", "host"].contains(h.0.to_lower()),
            )
        }
        if status == 303 and current_method != "HEAD" {
            current_method = "GET"
            current_body = b""
            current_headers = current_headers.filter(
                h => not h.0.to_lower().starts_with("content-"),
            )
        }
        current_url = next
    }
}

native fn send(
    method: str,
    url: str,
    headers: [(str, str)],
    body: bytes,
    timeout: duration,
) -> Result<(int, [(str, str)], Body)>

native fn resolve(base: str, location: str) -> Result<str>

native fn same_origin(a: str, b: str) -> bool
