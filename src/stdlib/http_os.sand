//! HTTP/1.1 client and server.
//!
//! Outgoing requests require the `Net(host:port)` capability (checked on every
//! redirect hop), and `serve` requires `NetListen(ip:port)`. `https` URLs use TLS
//! if the engine is built with the `tls` feature. Buffered response bodies
//! larger than `max_http_body` fail with kind `"limit"`; use `open` to stream
//! larger bodies incrementally.

import io
import json
import net

/// Starts an HTTP/1.1 server listening on `ip` and `port`. If `port` is `0`,
/// the operating system assigns an ephemeral port.
pub native fn serve(ip: str, port: int) -> Result<Server>

extend Server {
    /// Waits for and returns the next incoming HTTP request. Request headers
    /// are read concurrently across connections, and the request body is
    /// streamed on demand. Connections that do not send a complete request
    /// header within 30 seconds receive `408 Request Timeout`.
    pub native fn accept(self) -> Result<Request>

    /// Returns the bound local address.
    pub native fn addr(self) -> net.SocketAddr
}

impl Close for Server {
    native fn close(self)
}

extend Request {
    /// Sends a complete HTTP response with `status`, `body`, and `headers`, and
    /// closes the request.
    pub fn respond(self, status: int, body: bytes, headers: [(str, str)] = []) -> Result<()> {
        let sent = write_response(
            self.conn,
            self.exchange,
            self.body,
            status,
            body,
            headers,
            self.method != "HEAD",
        )
        self.close()
        sent
    }

    /// Begins a streaming HTTP response with `status` and `headers`, returning
    /// a `Reply` writer. Close the `Reply` or call `finish` to complete the
    /// response body.
    pub fn respond_stream(self, status: int, headers: [(str, str)] = []) -> Result<Reply> {
        Ok(Reply {
            conn: self.conn,
            body: reply_body(self.exchange, self.body, status, headers, self.method != "HEAD")?,
        })
    }

    /// Reads and returns the remaining request body as bytes.
    pub fn bytes(self) -> Result<bytes> {
        self.body.read_all()
    }

    /// Reads and decodes the remaining request body as UTF-8 text.
    pub fn text(self) -> Result<str> {
        self.body.read_text()
    }

    /// Reads and parses the remaining request body as JSON.
    pub fn json(self) -> Result<json.Json> {
        json.parse(self.text()?)
    }

    /// Returns the first value for header `name` (case-insensitive).
    pub fn header(self, name: str) -> str? {
        find_header(self.headers, name)
    }

    /// Returns all values for header `name` (case-insensitive) in receipt order.
    pub fn header_values(self, name: str) -> [str] {
        header_values(self.headers, name)
    }
}

impl Close for Request {
    /// Closes the request body and closes the client connection if a response
    /// has not been sent.
    fn close(self) {
        self.body.close()
        self.conn.close()
    }
}

/// A streaming HTTP response body returned by `Request.respond_stream`.
pub struct Reply {
    conn: net.Conn
    body: Outgoing

    /// Completes the response body, or fails if fewer bytes were written than
    /// declared by `Content-Length`.
    pub fn finish(self) -> Result<()> {
        write_body(self.conn, self.body, b"", true)
    }
}

impl io.Writer for Reply {
    fn write(self, data: bytes) -> Result<()> {
        write_body(self.conn, self.body, data, false)
    }
}

impl Close for Reply {
    /// Completes the response body, ignoring any write error.
    fn close(self) {
        let _ = self.finish()
    }
}

/// Starts a streaming HTTP request whose body is written incrementally via the
/// returned `Upload`. Redirects are not followed.
///
/// ```
/// use src = fs.open("backup.tar")?
/// use up = http.upload("PUT", "https://example.com/backup.tar")?
/// io.copy(src, up)?
/// use resp = up.finish()?
/// ```
pub native fn upload(
    method: str,
    url: str,
    headers: [(str, str)] = [],
    timeout: duration = 30s,
) -> Result<Upload>

extend Upload {
    /// Finishes the request body and waits for the response header, returning a
    /// `Stream` for reading the response body. Fails if fewer bytes were
    /// written than declared by `Content-Length`.
    pub fn finish(self) -> Result<Stream> {
        write_body(self.conn, self.body, b"", true)?
        read_response(self)
    }
}

impl io.Writer for Upload {
    fn write(self, data: bytes) -> Result<()> {
        write_body(self.conn, self.body, data, false)
    }
}

impl Close for Upload {
    fn close(self) {
        self.conn.close()
    }
}

native fn reply_body(
    exchange: Exchange,
    request_body: Body,
    status: int,
    headers: [(str, str)],
    include_body: bool,
) -> Result<Outgoing>

native fn write_body(conn: net.Conn, body: Outgoing, data: bytes, last: bool) -> Result<()>

native fn read_response(upload: Upload) -> Result<Stream>

native fn write_response(
    conn: net.Conn,
    exchange: Exchange,
    request_body: Body,
    status: int,
    body: bytes,
    headers: [(str, str)],
    include_body: bool,
) -> Result<()>
