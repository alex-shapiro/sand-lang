//! HTTP/1.1 client and server.
//!
//! Outgoing requests require `Http` and `Net(host:port)` capabilities, checked
//! on every redirect hop, as well as `NetAddr` on the resolved socket address.
//! `serve` requires `NetListen(ip:port)`. `https` URLs use TLS if the engine is
//! built with the `tls` feature. Buffered response bodies larger than
//! `max_http_body` fail with kind `"limit"`; use `open` to stream larger
//! response bodies incrementally.
//!
//! When a response body is read to completion and the connection permits
//! reuse, the client returns the connection to a per-engine pool for up to 20
//! seconds. The pool retains at most 16 idle connections in total (up to one
//! quarter of `max_open_resources`) and at most 4 per origin; each pooled
//! connection counts toward `max_open_resources` and `max_memory`, and the
//! engine evicts the oldest idle connection when a new slot or memory is
//! needed. Reusing a pooled connection re-checks `Http`, `Net`, and `NetAddr`
//! against the peer address. If a reused connection closes before any response
//! bytes arrive, `GET`, `HEAD`, `PUT`, `DELETE`, `OPTIONS`, and `TRACE`
//! requests are automatically retried once on a new connection.

import io
import json
import net

/// Starts an HTTP/1.1 server listening on `ip` and `port`.
///
/// Requires `NetListen(ip:port)`. If `port` is `0`, the operating system
/// assigns an ephemeral port, which can be queried with `Server.addr`.
pub native fn serve(ip: str, port: int) -> Result<Server>

extend Server {
    /// Waits for and returns the next incoming HTTP request.
    ///
    /// `accept` reads request headers concurrently across up to half of
    /// `max_open_resources` connections, using an 8 KiB read buffer per
    /// connection counted against `max_memory`. A connection that does not send
    /// a complete request header within 30 seconds receives `408 Request
    /// Timeout`; a malformed header or a header larger than 64 KiB receives
    /// `400 Bad Request`; a connection evicted because the server is at
    /// capacity receives `503 Service Unavailable`.
    ///
    /// If the request includes `Expect: 100-continue`, reading from
    /// `Request.body` sends `HTTP/1.1 100 Continue` before waiting for body
    /// bytes, and each body read times out after 30 seconds. After `respond` or
    /// `Reply.finish` completes, the connection is kept alive for up to 30
    /// seconds if the request permits connection reuse and the request body was
    /// fully consumed. For custom protocols or connection upgrades such as
    /// `101 Switching Protocols`, read and write `Request.conn` directly.
    pub native fn accept(self) -> Result<Request>

    /// Returns the bound local address.
    pub native fn addr(self) -> net.SocketAddr
}

impl Close for Server {
    native fn close(self)
}

extend Request {
    /// Sends a complete HTTP response with `status`, `body`, and `headers`, and
    /// closes the request.
    ///
    /// Automatically sets `Content-Length` if `headers` does not specify
    /// `Content-Length` or `Transfer-Encoding`, and omits the response body for
    /// `HEAD` requests and `1xx`, `204`, and `304` statuses.
    pub fn respond(self, status: int, body: bytes, headers: [(str, str)] = []) -> Result<()> {
        let sent = write_response(
            self.conn,
            self.exchange,
            self.body,
            status,
            body,
            headers,
            self.method != "HEAD",
        )
        self.close()
        sent
    }

    /// Begins a streaming HTTP response with `status` and `headers`, returning
    /// a `Reply` writer.
    ///
    /// Uses `Content-Length` if provided in `headers`, or chunked transfer
    /// encoding otherwise. Close the `Reply` or call `finish` to complete the
    /// response body.
    pub fn respond_stream(self, status: int, headers: [(str, str)] = []) -> Result<Reply> {
        Ok(
            Reply(
                conn: self.conn,
                body: reply_body(self.exchange, self.body, status, headers, self.method != "HEAD")?,
            ),
        )
    }

    /// Reads and returns the remaining request body as bytes, failing with kind
    /// `"limit"` if it exceeds `max_http_body`.
    pub fn bytes(self) -> Result<bytes> {
        self.body.read_all()
    }

    /// Reads and decodes the remaining request body as UTF-8 text, failing with
    /// kind `"limit"` if it exceeds `max_http_body`.
    pub fn text(self) -> Result<str> {
        self.body.read_text()
    }

    /// Reads and parses the remaining request body as JSON, failing with kind
    /// `"limit"` if it exceeds `max_http_body`.
    pub fn json(self) -> Result<json.Json> {
        json.parse(self.text()?)
    }

    /// Returns the first value for header `name`, matched case-insensitively.
    pub fn header(self, name: str) -> str? {
        find_header(self.headers, name)
    }

    /// Returns all values for header `name`, matched case-insensitively, in
    /// receipt order.
    pub fn header_values(self, name: str) -> [str] {
        header_values(self.headers, name)
    }
}

impl Close for Request {
    /// Closes the request body and closes the client connection if a response
    /// has not been sent.
    fn close(self) {
        self.body.close()
        self.conn.close()
    }
}

/// A streaming HTTP response body returned by `Request.respond_stream`.
pub struct Reply {
    conn: net.Conn
    body: Outgoing

    /// Completes the response body, or fails with kind `"invalid"` if fewer
    /// bytes were written than declared by `Content-Length`.
    pub fn finish(self) -> Result<()> {
        write_body(self.conn, self.body, b"", true)
    }
}

impl io.Writer for Reply {
    fn write(self, data: bytes) -> Result<()> {
        write_body(self.conn, self.body, data, false)
    }
}

impl Close for Reply {
    /// Completes the response body, ignoring any write error.
    fn close(self) {
        let _ = self.finish()
    }
}

/// Starts a streaming HTTP request whose body is written incrementally via the
/// returned `Upload`.
///
/// Uses `Content-Length` if provided in `headers`, or chunked transfer encoding
/// otherwise. Redirects are not followed.
///
/// ```
/// use src = fs.open("backup.tar")?
/// use up = http.upload("PUT", "https://example.com/backup.tar")?
/// io.copy(src, up)?
/// use resp = up.finish()?
/// ```
pub native fn upload(
    method: str,
    url: str,
    headers: [(str, str)] = [],
    timeout: duration = 30s,
) -> Result<Upload>

extend Upload {
    /// Finishes the request body and waits for the response header, returning a
    /// `Stream` for reading the response body. Fails with kind `"invalid"` if
    /// fewer bytes were written than declared by `Content-Length`.
    pub fn finish(self) -> Result<Stream> {
        write_body(self.conn, self.body, b"", true)?
        read_response(self)
    }
}

impl io.Writer for Upload {
    fn write(self, data: bytes) -> Result<()> {
        write_body(self.conn, self.body, data, false)
    }
}

impl Close for Upload {
    fn close(self) {
        self.conn.close()
    }
}

native fn reply_body(
    exchange: Exchange,
    request_body: Body,
    status: int,
    headers: [(str, str)],
    include_body: bool,
) -> Result<Outgoing>

native fn write_body(conn: net.Conn, body: Outgoing, data: bytes, last: bool) -> Result<()>

native fn read_response(upload: Upload) -> Result<Stream>

native fn write_response(
    conn: net.Conn,
    exchange: Exchange,
    request_body: Body,
    status: int,
    body: bytes,
    headers: [(str, str)],
    include_body: bool,
) -> Result<()>
