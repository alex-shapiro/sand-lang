//! Pseudo-random number generation (`xoshiro256**`, non-cryptographic).
//!
//! Module-level functions use the engine generator, which is seeded from host
//! entropy unless overridden by `Config::seed` or `seed`. Call `rng(seed)` to
//! create an isolated generator instance.

/// Reseeds the engine generator with `s` for deterministic output.
pub native fn seed(s: int)

/// Returns a uniformly distributed integer in `lo..hi`, or aborts if `lo >= hi`.
pub native fn int(lo: int, hi: int) -> int

/// Returns a uniformly distributed float in `[0.0, 1.0)`.
pub native fn float() -> float

/// Returns `true` or `false` with probability 0.5.
pub native fn bool() -> bool

/// Returns a uniformly selected element from `xs`, or `None` if `xs` is empty.
pub native fn choice<T>(xs: [T]) -> T?

/// Shuffles `xs` in place using the Fisher-Yates algorithm.
pub native fn shuffle<T>(xs: [T])

/// Returns `k` distinct elements from `xs` in random order (or all elements if
/// `k >= xs.len()`).
pub native fn sample<T>(xs: [T], k: int) -> [T]

/// Returns `n` pseudo-random bytes.
pub native fn bytes(n: int) -> bytes

/// Creates an independent `Rng` seeded with `seed`.
pub native fn rng(seed: int) -> Rng

/// An isolated pseudo-random number generator created with `random.rng(seed)`.
pub native type Rng

extend Rng {
    /// Returns a uniformly distributed integer in `lo..hi`, or aborts if `lo >= hi`.
    pub native fn int(self, lo: int, hi: int) -> int
    /// Returns a uniformly distributed float in `[0.0, 1.0)`.
    pub native fn float(self) -> float
    /// Returns `true` or `false` with probability 0.5.
    pub native fn bool(self) -> bool
    /// Returns a uniformly selected element from `xs`, or `None` if `xs` is empty.
    pub native fn choice<T>(self, xs: [T]) -> T?
    /// Shuffles `xs` in place.
    pub native fn shuffle<T>(self, xs: [T])
    /// Returns `k` distinct elements from `xs` in random order.
    pub native fn sample<T>(self, xs: [T], k: int) -> [T]
    /// Returns `n` pseudo-random bytes.
    pub native fn bytes(self, n: int) -> bytes
}
