//! An HTTP client, in the browser: requests go through the browser's
//! `fetch`, once the policy allows `Net(host:port)`.
//!
//! Compared with other builds: a response from another site can be read
//! only if the site allows it (CORS), and only the headers it exposes are
//! visible; the browser sets some request headers itself (`host`,
//! `cookie`, `user-agent`, ...), and sends no cookies. Redirects are not
//! followed: the browser does not say where they lead, so the policy could
//! not decide on them; a redirect fails with kind `"http"`. Host names are
//! decided as written (the browser resolves them; the addresses are not
//! checked). There is no server. Response bodies larger than the
//! `max_http_body` limit fail with kind `"limit"`.

import json

/// An HTTP response. Header names are lower-cased.
pub struct Response {
    status: int
    headers: [str: str]
    body: bytes
    /// The URL that produced this response (after redirects).
    url: str

    /// The body decoded as UTF-8.
    fn text(self) -> Result<str> {
        self.body.to_str()
    }

    /// The body parsed as JSON.
    fn json(self) -> Result<json.Json> {
        json.parse(self.text()?)
    }

    /// True for a 2xx status.
    fn ok(self) -> bool {
        self.status >= 200 and self.status <= 299
    }

    /// The value of header `name` (case-insensitive).
    fn header(self, name: str) -> str? {
        self.headers.get(name.to_lower())
    }
}

/// Sends a `GET` request, following redirects.
pub fn get(url: str, headers: [str: str] = [:], timeout: duration = 30s) -> Result<Response> {
    request("GET", url, headers: headers, timeout: timeout)
}

/// Sends a `POST` request with `body`, following redirects.
pub fn post(
    url: str,
    body: bytes,
    headers: [str: str] = [:],
    timeout: duration = 30s,
) -> Result<Response> {
    request("POST", url, headers: headers, body: body, timeout: timeout)
}

/// Sends a request. `timeout` applies to the whole exchange. Redirects are
/// not followed in the browser (`follow_redirects` is ignored): a redirect
/// fails with kind `"http"`. Non-2xx statuses are not errors.
pub fn request(
    method: str,
    url: str,
    headers: [str: str] = [:],
    body: bytes = b"",
    timeout: duration = 30s,
    follow_redirects: bool = true,
) -> Result<Response> {
    let (status, resp_headers, resp_body) = send(method, url, headers, body, timeout)?
    Ok(Response { status, headers: resp_headers, body: resp_body, url })
}

/// Performs the exchange with `fetch`: `(status, headers, body)`.
native fn send(
    method: str,
    url: str,
    headers: [str: str],
    body: bytes,
    timeout: duration,
) -> Result<(int, [str: str], bytes)>
