//! Byte streams (`Reader` and `Writer`) and the standard input, output, and
//! error handles.
//!
//! ```
//! use f = fs.open("notes.txt")?
//! while let Some(line) = f.read_line()? {
//!     io.stdout.write_str(line.to_upper() + "\n")?
//! }
//! ```

/// A readable byte stream, such as a file, socket, HTTP body, or standard input.
pub trait Reader {
    /// Reads up to `max` bytes, suspending until data is available or the
    /// stream reaches end-of-file (which returns `b""`).
    fn read(self, max: int = 65536) -> Result<bytes>

    /// Reads the next line with any trailing `\n` or `\r\n` stripped, or
    /// returns `Ok(None)` at end-of-file. Fails with kind `"invalid"` if the
    /// line is not valid UTF-8.
    fn read_line(self) -> Result<str?>

    /// Reads all remaining bytes until end-of-file.
    fn read_all(self) -> Result<bytes>

    /// Reads all remaining bytes until end-of-file as UTF-8 text, or fails with
    /// kind `"invalid"` if the stream is not valid UTF-8.
    fn read_text(self) -> Result<str> {
        self.read_all()?.to_str()
    }

    /// Returns a lazy iterator over the remaining lines of the stream. If a
    /// read fails, the iterator yields `Some(Err(e))` and then stops.
    fn lines(self) -> Iter<Result<str>> {
        var done = false
        Iter.from_fn(() => {
            if done {
                return None
            }
            match self.read_line() {
                Ok(Some(line)) => Some(Ok(line))
                Ok(None) => {
                    done = true
                    None
                }
                Err(e) => {
                    done = true
                    Some(Err(e))
                }
            }
        })
    }
}

/// A writable byte stream, such as a file, socket, or standard output.
pub trait Writer {
    /// Writes all bytes in `data` to the stream.
    fn write(self, data: bytes) -> Result<()>

    /// Writes `text` encoded as UTF-8 to the stream.
    fn write_str(self, text: str) -> Result<()> {
        self.write(text.bytes())
    }

    /// Flushes any buffered output to the underlying destination.
    fn flush(self) -> Result<()> {
        Ok(())
    }
}

/// Copies all remaining bytes from `src` to `dst` in chunks and returns the
/// total number of bytes copied.
pub fn copy<R: Reader, W: Writer>(src: R, dst: W) -> Result<int> {
    var total = 0
    loop {
        let chunk = src.read()?
        if chunk.is_empty() {
            return Ok(total)
        }
        dst.write(chunk)?
        total += chunk.len()
    }
}

impl Reader for Stdin {
    native fn read(self, max: int) -> Result<bytes>
    native fn read_line(self) -> Result<str?>
    native fn read_all(self) -> Result<bytes>
}

impl Writer for Stdout {
    native fn write(self, data: bytes) -> Result<()>
    native fn write_str(self, text: str) -> Result<()>
    native fn flush(self) -> Result<()>
}

impl Writer for Stderr {
    native fn write(self, data: bytes) -> Result<()>
    native fn write_str(self, text: str) -> Result<()>
    native fn flush(self) -> Result<()>
}

/// Standard input stream handle.
pub let stdin: Stdin = new_stdin()

/// Standard output stream handle (also written by `print`).
pub let stdout: Stdout = new_stdout()

/// Standard error stream handle (also written by `eprint`).
pub let stderr: Stderr = new_stderr()

native fn new_stdin() -> Stdin

native fn new_stdout() -> Stdout

native fn new_stderr() -> Stderr
