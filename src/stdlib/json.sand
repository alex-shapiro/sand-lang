//! JSON (RFC 8259) parsing, serialization, and typed conversion.

/// A dynamic JSON value. Plain integers that fit in a 64-bit signed `int` parse
/// as `Int`; all other numbers parse as `Float`. Object entries preserve
/// insertion order.
pub enum Json {
    /// JSON `null`.
    Null
    /// JSON boolean (`true` or `false`).
    Bool(bool)
    /// Exact 64-bit signed integer.
    Int(int)
    /// IEEE-754 floating-point number.
    Float(float)
    /// UTF-8 string.
    Str(str)
    /// JSON array.
    Arr([Json])
    /// Insertion-ordered JSON object.
    Obj([str: Json])

    /// Returns the field `key` if `self` is an `Obj`, or `None` otherwise.
    pub fn get(self, key: str) -> Json? {
        match self {
            Obj(fields) => fields.get(key)
            _ => None
        }
    }

    /// Returns the element at index `i` if `self` is an `Arr` and `i` is in
    /// bounds, or `None` otherwise.
    pub fn at(self, i: int) -> Json? {
        match self {
            Arr(items) => items.get(i)
            _ => None
        }
    }

    /// Returns the string payload if `self` is `Str`, or `None` otherwise.
    pub fn as_str(self) -> str? {
        match self {
            Str(s) => Some(s)
            _ => None
        }
    }

    /// Returns the numeric value as a `float` if `self` is `Int` or `Float`, or
    /// `None` otherwise.
    pub fn as_float(self) -> float? {
        match self {
            Int(i) => Some(i.to_float())
            Float(f) => Some(f)
            _ => None
        }
    }

    /// Returns the numeric value as an `int` if `self` is `Int` or an integral
    /// `Float` within `±2^53`, or `None` otherwise.
    pub fn as_int(self) -> int? {
        match self {
            Int(i) => Some(i)
            Float(f) if f == f.floor() and f.abs() <= 9007199254740992.0 => Some(f.to_int())
            _ => None
        }
    }

    /// Returns the boolean payload if `self` is `Bool`, or `None` otherwise.
    pub fn as_bool(self) -> bool? {
        match self {
            Bool(b) => Some(b)
            _ => None
        }
    }

    /// Returns the array elements if `self` is `Arr`, or `None` otherwise.
    pub fn as_list(self) -> [Json]? {
        match self {
            Arr(items) => Some(items)
            _ => None
        }
    }

    /// Returns the object entries if `self` is `Obj`, or `None` otherwise.
    pub fn as_map(self) -> [str: Json]? {
        match self {
            Obj(fields) => Some(fields)
            _ => None
        }
    }

    /// Returns `true` if `self` is `Null`.
    pub fn is_null(self) -> bool {
        match self {
            Null => true
            _ => false
        }
    }

    /// Traverses a dot-separated path of object keys and array indices (such as
    /// `"items.0.name"`). Returns `Some(self)` if `p` is empty.
    pub fn path(self, p: str) -> Json? {
        if p.is_empty() {
            return Some(self)
        }
        var cur = self
        for part in p.split(".") {
            cur = match cur {
                Arr(items) => items.get(part.parse_int()?)?
                _ => cur.get(part)?
            }
        }
        Some(cur)
    }
}

/// Parses `text` as a `Json` value. Fails with kind `"parse"` on invalid syntax
/// or if array/object nesting exceeds 512 levels.
pub native fn parse(text: str) -> Result<Json>

/// Serializes `value` as JSON text (compact if `indent == 0`, or pretty-printed
/// with `indent` spaces per level). Finite floats include a decimal point or
/// exponent (`2.0`), and `NaN` or infinite floats serialize as `null`. Aborts
/// if `value` contains a function, task, channel, or native resource.
pub native fn encode<T>(value: T, indent: int = 0) -> str

/// Parses `text` and converts it into type `T`. Missing struct fields use their
/// declared default or `None`; type mismatches fail with kind `"parse"` and a
/// JSON path diagnostic. A value for a part of `T` that JSON cannot represent
/// (a function, task, channel, or native object) fails with kind `"invalid"`.
pub native fn decode<reflect T>(text: str) -> Result<T>

/// Converts `value` into a `Json` value: primitives map directly, `()` and
/// `None` map to `Null`, `Some(x)` maps to `x`, lists, sets, and tuples map to
/// `Arr`, `[str: V]` maps and structs map to `Obj`, unit enum variants map to
/// `Str`, payload variants map to `{"Variant": payload}`, `bytes` maps to
/// Base64, and `duration` maps to nanoseconds.
pub native fn to_json<T>(value: T) -> Json
