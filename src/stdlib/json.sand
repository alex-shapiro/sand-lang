//! JSON encoding and decoding (RFC 8259).
//!
//! ### Enum Encodings
//!
//! - Unit enum variants map to strings like `"Red"`
//! - Tuple variants with a single payload field map to `{"Variant": payload}`
//! - Tuple variants with multiple payload fields map to `{"Variant": [f0, f1, ...]}`
//! - Struct variants map to `{"Variant": {...}}`
//!
//! ### Other Type Encodings
//!
//! - `bytes` maps to a standard Base64 string
//! - `duration` maps to an integer nanosecond count
//! - `Range` maps to `{"start": int, "end": int, "inclusive": bool}`
//! - native value types like `time.*` and `net.SocketAddr` map to their canonical text representations

extend Json {
    /// Returns the field `key` if `self` is an `Obj`, or `None` otherwise.
    pub fn get(self, key: str) -> Json? {
        match self {
            Obj(fields) => fields.get(key)
            _ => None
        }
    }

    /// Returns the element at index `i` if `self` is an `Arr` and `i` is in
    /// bounds, or `None` otherwise.
    pub fn at(self, i: int) -> Json? {
        match self {
            Arr(items) => items.get(i)
            _ => None
        }
    }

    /// Returns the string payload if `self` is `Str`, or `None` otherwise.
    pub fn as_str(self) -> str? {
        match self {
            Str(s) => Some(s)
            _ => None
        }
    }

    /// Returns the numeric value as a `float` if `self` is `Int` or `Float`, or
    /// `None` otherwise.
    pub fn as_float(self) -> float? {
        match self {
            Int(i) => Some(i.to_float())
            Float(f) => Some(f)
            _ => None
        }
    }

    /// Returns the numeric value as an `int` if `self` is `Int` or an integral
    /// `Float` within `±2^53`, or `None` otherwise.
    pub fn as_int(self) -> int? {
        match self {
            Int(i) => Some(i)
            Float(f) if f == f.floor() and f.abs() <= 9007199254740992.0 => Some(f.to_int())
            _ => None
        }
    }

    /// Returns the boolean payload if `self` is `Bool`, or `None` otherwise.
    pub fn as_bool(self) -> bool? {
        match self {
            Bool(b) => Some(b)
            _ => None
        }
    }

    /// Returns the array elements if `self` is `Arr`, or `None` otherwise.
    pub fn as_list(self) -> [Json]? {
        match self {
            Arr(items) => Some(items)
            _ => None
        }
    }

    /// Returns the object entries if `self` is `Obj`, or `None` otherwise.
    pub fn as_map(self) -> [str: Json]? {
        match self {
            Obj(fields) => Some(fields)
            _ => None
        }
    }

    /// Returns `true` if `self` is `Null`.
    pub fn is_null(self) -> bool {
        match self {
            Null => true
            _ => false
        }
    }

    /// Traverses a dot-separated path of object keys and array indices, such as
    /// `"items.0.name"`. Returns itself if the path is empty.
    pub fn path(self, p: str) -> Json? {
        if p.is_empty() {
            return Some(self)
        }
        var cur = self
        for part in p.split(".") {
            cur = match cur {
                Arr(items) => items.get(part.parse_int()?)?
                _ => cur.get(part)?
            }
        }
        Some(cur)
    }
}

/// Parses `text` as a `Json` value.
///
/// Numbers without a decimal point, exponent, or `-0` that fit in a 64-bit
/// signed integer parse as `Json.Int`; all other numbers parse as `Json.Float`.
/// Fails with kind `"parse"` if syntax is invalid or if array or object nesting
/// exceeds 512 levels.
pub native fn parse(text: str) -> Result<Json>

/// Serializes `value` as JSON text.
///
/// Emits compact output if `indent <= 0`, or pretty-prints with `indent` spaces
/// per level. Finite floats include a decimal point or exponent, and `NaN` or
/// infinite floats are serialized as `null`. Aborts with kind `"invalid"` if a
/// map key is not a `str`, `int`, `duration`, `bool`, unit enum variant, or
/// value type, or with kind `"limit"` if array or object nesting exceeds 512
/// levels.
pub native fn encode<T: Encode>(value: T, indent: int = 0) -> str

/// Decodes JSON `text` into a value of type `T`.
///
/// Unknown object fields are ignored, and duplicate keys overwrite earlier
/// values.
///
/// If a struct field is omitted from a JSON object, `decode` uses the field's
/// declared default, or `None` if the field is an `Option` without a default.
/// Constant defaults are filled inline during parsing, and non-constant default
/// expressions are evaluated in post-order after parsing succeeds.
///
/// Fails with kind `"parse"` on invalid JSON syntax, missing required fields,
/// or type mismatches, including the JSON path such as `$.items[2].price` in
/// the error message. Fails with kind `"invalid"` if a target map key type does
/// not implement `Encode`.
pub fn decode<reflect T: Decode>(text: str) -> Result<T> {
    let decoded: Decoded<T> = decode_raw(text)
    match decoded {
        Done(value) => Ok(value)
        Pending(value, fills) => {
            for fill in fills {
                fill()
            }
            Ok(value)
        }
        Failed(e) => Err(e)
    }
}

native fn decode_raw<reflect T: Decode>(text: str) -> Decoded<T>

/// Converts `value` into a `Json` value using the same representation as
/// `encode`. Aborts with kind `"invalid"` if `value` contains a map key type
/// that `encode` does not support, or with kind `"limit"` if array or object
/// nesting exceeds 512 levels. Also reuses existing `Json` values without
/// traversing them.
pub native fn to_json<T: Encode>(value: T) -> Json
