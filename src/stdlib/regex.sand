//! Linear-time regular expressions backed by the Rust `regex` engine.
//!
//! Match offsets are UTF-8 byte indices into the input string. Use raw string
//! literals (`r"\d{4}"`) for patterns with backslash escapes.

extend Captures {
    /// Returns capture group `i`, or `None` if group `i` did not participate or
    /// is out of bounds.
    pub fn get(self, i: int) -> Match? {
        if i < 0 or i >= self.len() {
            return None
        }
        let start = self.spans[2 * i]
        if start < 0 {
            return None
        }
        let end = self.spans[2 * i + 1]
        Some(Match(text: self.text[start..end], start: start, end: end))
    }

    /// Returns the capture group named `n`, or `None` if it did not participate
    /// or does not exist.
    pub fn name(self, n: str) -> Match? {
        self.get(self.regex.group_index(n)?)
    }

    /// Returns the total number of capture groups, including group `0`.
    pub fn len(self) -> int {
        self.spans.len() / 2
    }

    /// Returns the matched substring of capture group `i`, or `None` if group
    /// `i` did not match.
    pub fn text(self, i: int) -> str? {
        Some(self.get(i)?.text)
    }
}

/// Compiles `pattern` and returns `true` if it matches anywhere in `text`.
pub fn is_match(pattern: str, text: str) -> Result<bool> {
    Ok(Regex(pattern)?.is_match(text))
}

extend Regex {
    /// Compiles `pattern`. Fails with kind `"parse"` on invalid syntax or
    /// `"limit"` if the compiled automaton exceeds the size limit.
    pub native fn init(pattern: str) -> Result<Regex>

    /// Returns `true` if the pattern matches anywhere in `text`.
    pub native fn is_match(self, text: str) -> bool
    /// Returns the leftmost-first match in `text`, or `None` if absent.
    pub native fn find(self, text: str) -> Match?
    /// Returns all non-overlapping matches in `text` from left to right.
    pub native fn find_all(self, text: str) -> [Match]

    /// Returns the capture groups for the leftmost-first match in `text`.
    pub native fn captures(self, text: str) -> Captures?
    /// Returns the capture groups for all non-overlapping matches in `text`.
    pub native fn captures_all(self, text: str) -> [Captures]

    /// Replaces the leftmost-first match in `text` with `rep`, expanding `$1`
    /// or `${1}` to numbered groups, `${name}` to named groups, and `$$` to a
    /// literal `$`.
    pub native fn replace(self, text: str, rep: str) -> str
    /// Replaces all non-overlapping matches in `text` with `rep` (using the
    /// same expansion rules as `replace`).
    pub native fn replace_all(self, text: str, rep: str) -> str
    /// Splits `text` into substrings separated by non-overlapping matches.
    pub native fn split(self, text: str) -> [str]
    /// Returns the source pattern string used to compile `self`.
    pub native fn pattern(self) -> str

    native fn group_index(self, name: str) -> int?
}
