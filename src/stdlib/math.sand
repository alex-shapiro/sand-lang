//! Mathematical constants and functions on `float` and `int`.
//!
//! Rounding, `abs`, `min`, `max`, `clamp`, `sqrt`, and `pow` are also available
//! as methods on `float` and `int` (`x.sqrt()`).

/// Ratio of a circle's circumference to its diameter (`π`).
pub let pi = 3.141592653589793

/// Base of the natural logarithm (`e`).
pub let e = 2.718281828459045

/// Ratio of a circle's circumference to its radius (`2 * pi`).
pub let tau = 6.283185307179586

/// Returns the cube root of `x`.
pub native fn cbrt(x: float) -> float
/// Returns `e` raised to the power `x`.
pub native fn exp(x: float) -> float
/// Returns the natural logarithm of `x`.
pub native fn ln(x: float) -> float
/// Returns the base-2 logarithm of `x`.
pub native fn log2(x: float) -> float
/// Returns the base-10 logarithm of `x`.
pub native fn log10(x: float) -> float
/// Returns the logarithm of `x` in `base`.
pub native fn log(x: float, base: float) -> float
/// Returns the sine of `x` (in radians).
pub native fn sin(x: float) -> float
/// Returns the cosine of `x` (in radians).
pub native fn cos(x: float) -> float
/// Returns the tangent of `x` (in radians).
pub native fn tan(x: float) -> float
/// Returns the arcsine of `x` in radians.
pub native fn asin(x: float) -> float
/// Returns the arccosine of `x` in radians.
pub native fn acos(x: float) -> float
/// Returns the arctangent of `x` in radians.
pub native fn atan(x: float) -> float
/// Returns the four-quadrant arctangent of `(y, x)` in radians (`-pi..=pi`).
pub native fn atan2(y: float, x: float) -> float
/// Returns the hyperbolic sine of `x`.
pub native fn sinh(x: float) -> float
/// Returns the hyperbolic cosine of `x`.
pub native fn cosh(x: float) -> float
/// Returns the hyperbolic tangent of `x`.
pub native fn tanh(x: float) -> float
/// Returns `sqrt(x * x + y * y)` without intermediate overflow or underflow.
pub native fn hypot(x: float, y: float) -> float
/// Converts `degrees` to radians.
pub native fn to_radians(degrees: float) -> float
/// Converts `radians` to degrees.
pub native fn to_degrees(radians: float) -> float

/// Returns `true` if `a` and `b` are within relative tolerance `rel_tol`
/// (scaled by the larger magnitude) or absolute tolerance `abs_tol`. Equal
/// infinities return `true`, and `NaN` always returns `false`.
pub fn is_close(a: float, b: float, rel_tol: float = 1e-9, abs_tol: float = 0.0) -> bool {
    if a == b {
        return true
    }
    if a.is_infinite() or b.is_infinite() {
        return false
    }
    let diff = (a - b).abs()
    diff <= rel_tol * a.abs().max(b.abs()) or diff <= abs_tol
}

/// Returns the non-negative greatest common divisor of `a` and `b` (`gcd(0, 0) == 0`).
pub native fn gcd(a: int, b: int) -> int

/// Returns the non-negative least common multiple of `a` and `b` (`0` if either input is `0`).
pub native fn lcm(a: int, b: int) -> int

/// Returns the integer square root `floor(sqrt(n))`, or aborts if `n < 0`.
pub native fn isqrt(n: int) -> int
