//! File system operations on files, directories, and paths.
//!
//! Relative paths are resolved against the engine working directory, and every
//! operation is checked against the active sandbox policy.

import io
import time

/// Metadata for a file or directory.
pub struct Metadata {
    /// Size in bytes.
    size: int
    /// `true` if the entry is a regular file.
    is_file: bool
    /// `true` if the entry is a directory.
    is_dir: bool
    /// Last modification timestamp, if supported by the platform.
    modified: time.Instant?
}

/// File access mode for `open`.
pub enum Mode {
    /// Opens an existing file for reading (requires `FsRead`).
    Read
    /// Creates or truncates a file for writing from the start (requires `FsWrite`).
    Write
    /// Opens or creates a file for appending at the end (requires `FsWrite`).
    Append
    /// Creates a new file for writing, or fails with kind `"already_exists"` if
    /// the path exists (requires `FsWrite`).
    CreateNew
    /// Opens an existing file for reading and writing in place (requires `FsRead` and `FsWrite`).
    ReadWrite
}

/// Opens the regular file at `path` with `mode`. The sandbox policy is checked
/// at the time of the `open` call.
///
/// ```
/// use f = fs.open("data.csv")?
/// while let Some(line) = f.read_line()? {
///     print(line.split(","))
/// }
/// ```
pub native fn open(path: str, mode: Mode = Mode.Read) -> Result<File>

/// An open file handle returned by `open`. Reads and writes advance the file
/// cursor (`Mode.Append` always writes at the end). Bind a `File` with `use`
/// or call `close` to release the underlying descriptor; operations on a
/// closed file return an `Err` with kind `"closed"`.
pub native type File

impl io.Reader for File {
    native fn read(self, max: int) -> Result<bytes>
    native fn read_line(self) -> Result<str?>
    native fn read_all(self) -> Result<bytes>
    native fn read_text(self) -> Result<str>
}

impl io.Writer for File {
    native fn write(self, data: bytes) -> Result<()>
    native fn write_str(self, text: str) -> Result<()>
}

impl Close for File {
    native fn close(self)
}

extend File {
    /// Moves the file cursor to byte offset `pos` from the start of the file.
    pub native fn seek(self, pos: int) -> Result<()>
    /// Returns the current byte offset of the file cursor.
    pub native fn position(self) -> Result<int>

    /// Returns the size and modification timestamp of the open file.
    pub fn metadata(self) -> Result<Metadata> {
        let (size, modified) = file_stat(self)?
        Ok(to_metadata(size, true, false, modified))
    }

    /// Truncates or zero-extends the file to `len` bytes.
    pub native fn set_len(self, len: int) -> Result<()>
    /// Flushes buffered file data and metadata to persistent storage (`fsync`).
    pub native fn sync(self) -> Result<()>
    /// Returns the path string passed to `open`.
    pub native fn path(self) -> str
}

native fn file_stat(f: File) -> Result<(int, int?)>

/// Reads the entire file at `path` as UTF-8 text, or fails with kind
/// `"invalid"` if the file contains invalid UTF-8.
pub native fn read_text(path: str) -> Result<str>

/// Reads the entire file at `path` as raw bytes.
pub native fn read_bytes(path: str) -> Result<bytes>

/// Writes `text` to `path`, creating or truncating the file.
pub native fn write_text(path: str, text: str) -> Result<()>

/// Writes `data` to `path`, creating or truncating the file.
pub native fn write_bytes(path: str, data: bytes) -> Result<()>

/// Returns `true` if a file or directory exists at `path`.
pub native fn exists(path: str) -> Result<bool>

/// Returns `true` if `path` resolves to a regular file.
pub native fn is_file(path: str) -> Result<bool>

/// Returns `true` if `path` resolves to a directory.
pub native fn is_dir(path: str) -> Result<bool>

/// Returns the entry names in directory `path` in sorted order.
pub native fn list_dir(path: str) -> Result<[str]>

/// Creates a directory at `path`. If `recursive` is `true`, creates missing
/// parent directories and succeeds if the directory already exists.
pub native fn create_dir(path: str, recursive: bool = false) -> Result<()>

/// Removes the file or symbolic link at `path`.
pub native fn remove_file(path: str) -> Result<()>

/// Removes an empty directory at `path`, or removes the directory and all of
/// its contents if `recursive` is `true`. Checks every entry against the
/// sandbox policy before deletion and removes symbolic links without following
/// them.
pub fn remove_dir(path: str, recursive: bool = false) -> Result<()> {
    if recursive { remove_tree(path) } else { remove_empty_dir(path) }
}

/// Renames or moves `src` to `dst`, replacing `dst` if it is an existing file.
/// Fails if any path inside `src` or `dst` is denied by the sandbox policy.
pub native fn rename(src: str, dst: str) -> Result<()>

/// Copies the contents of regular file `src` to `dst`.
pub native fn copy(src: str, dst: str) -> Result<()>

/// Returns metadata for the file or directory at `path`.
pub fn metadata(path: str) -> Result<Metadata> {
    let (size, is_file, is_dir, modified) = stat(path)?
    Ok(to_metadata(size, is_file, is_dir, modified))
}

fn to_metadata(size: int, is_file: bool, is_dir: bool, modified: int?) -> Metadata {
    Metadata { size, is_file, is_dir, modified: modified.map(time.Instant.from_epoch_nanos) }
}

native fn stat(path: str) -> Result<(int, bool, bool, int?)>

/// Joins path segments using the platform path separator. An absolute segment
/// replaces all preceding segments.
pub native fn join(parts: [str]) -> str

/// Returns the final component of `path`, or `""` if `path` has none.
pub native fn basename(path: str) -> str

/// Returns `path` without its final component, or `""` if `path` has a single
/// component.
pub native fn dirname(path: str) -> str

/// Returns the file extension of `path` without the leading dot, or `None` if
/// the final component does not have an extension.
pub native fn extension(path: str) -> str?

native fn remove_empty_dir(path: str) -> Result<()>

native fn remove_tree(path: str) -> Result<()>
