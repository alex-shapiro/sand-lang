//! File system operations on files, directories, and paths.
//!
//! Relative paths are resolved against the engine working directory, and every
//! file system operation is checked against the active sandbox policy.
//!
//! `/` is accepted as a path separator on all platforms, and `\` is also
//! accepted on Windows. Paths longer than 4096 bytes or containing a NUL byte
//! fail with kind `"invalid"`. On Windows, paths with a component that is a
//! reserved device name (`CON`, `PRN`, `AUX`, `NUL`, `COM1`–`COM9`,
//! `LPT1`–`LPT9`, with or without an extension) or that ends with `.` or a
//! space also fail with kind `"invalid"`. `join`, `basename`, `dirname`, and
//! `extension` are lexical operations that do not access the file system or
//! require a capability.
//!
//! `read_text`, `read_bytes`, `exists`, `is_file`, `is_dir`, `list_dir`, and
//! `metadata` require `FsRead`. `write_text`, `write_bytes`, `create_dir`,
//! `remove_file`, `remove_dir`, and `rename` require `FsWrite`. `copy` requires
//! `FsRead` on `src` and `FsWrite` on `dst`. Reading, writing, opening, and
//! copying accept regular files only and fail with kind `"invalid"` on
//! directories or special files.
//!
//! On the host file system, most operations follow symbolic links and check the
//! policy on the resolved target path. If a symbolic link is dangling,
//! `exists`, `is_file`, and `is_dir` return `Ok(false)`, while other operations
//! fail with kind `"permission_denied"`. `remove_file`, `remove_dir`, and
//! `rename` operate on the directory entry itself without following a final
//! symbolic link.
//!
//! If the engine is configured with an in-memory file system (`MemFs`), paths
//! are normalized lexically relative to `/`, entry names are case-sensitive
//! UTF-8 strings, and writes that exceed the configured capacity fail with kind
//! `"limit"`.

import io

/// Opens the regular file at `path` with `mode`.
///
/// `open` checks `FsRead`, `FsWrite`, or both according to `mode` at the time
/// of the call. Subsequent operations on the returned `File` do not re-check
/// the policy. Each open `File` counts toward `max_open_resources` until it is
/// closed or garbage-collected.
///
/// ```
/// use f = fs.open("data.csv")?
/// while let Some(line) = f.read_line()? {
///     print(line.split(","))
/// }
/// ```
pub native fn open(path: str, mode: Mode = Mode.Read) -> Result<File>

impl io.Reader for File {
    native fn read(self, max: int) -> Result<bytes>
    native fn read_line(self) -> Result<str?>
    native fn read_all(self) -> Result<bytes>
    native fn read_text(self) -> Result<str>
}

impl io.Writer for File {
    native fn write(self, data: bytes) -> Result<()>
    native fn write_str(self, text: str) -> Result<()>
}

impl Close for File {
    native fn close(self)
}

extend File {
    /// Moves the file cursor to byte offset `pos` from the start of the file.
    ///
    /// Seeking past the end of the file is permitted; a subsequent write at
    /// that position extends the file and fills the gap with zero bytes. Fails
    /// with kind `"invalid"` if `pos` is negative.
    pub native fn seek(self, pos: int) -> Result<()>
    /// Returns the current byte offset of the file cursor.
    pub native fn position(self) -> Result<int>

    /// Returns the size and modification timestamp of the open file.
    pub native fn metadata(self) -> Result<Metadata>

    /// Truncates or zero-extends the file to `len` bytes.
    ///
    /// Fails with kind `"invalid"` if `len` is negative or if `self` was opened
    /// with `Mode.Read`.
    pub native fn set_len(self, len: int) -> Result<()>
    /// Flushes buffered file data and metadata to persistent storage (`fsync`).
    pub native fn sync(self) -> Result<()>
    /// Returns the path string passed to `open`.
    pub native fn path(self) -> str
}

/// Reads the entire regular file at `path` as UTF-8 text, or fails with kind
/// `"invalid"` if the file contains invalid UTF-8.
pub native fn read_text(path: str) -> Result<str>

/// Reads the entire regular file at `path` as raw bytes.
pub native fn read_bytes(path: str) -> Result<bytes>

/// Writes `text` to `path`, creating or truncating the file.
pub native fn write_text(path: str, text: str) -> Result<()>

/// Writes `data` to `path`, creating or truncating the file.
pub native fn write_bytes(path: str, data: bytes) -> Result<()>

/// Returns `true` if a file or directory exists at `path`.
pub native fn exists(path: str) -> Result<bool>

/// Returns `true` if `path` resolves to a regular file.
pub native fn is_file(path: str) -> Result<bool>

/// Returns `true` if `path` resolves to a directory.
pub native fn is_dir(path: str) -> Result<bool>

/// Returns the entry names in directory `path` in sorted order, excluding `.`
/// and `..`.
pub native fn list_dir(path: str) -> Result<[str]>

/// Creates a directory at `path`. If `recursive` is `true`, creates missing
/// parent directories, checks `FsWrite` for each directory it creates, and
/// succeeds if the target directory already exists.
pub native fn create_dir(path: str, recursive: bool = false) -> Result<()>

/// Removes the file or symbolic link at `path` without following a final
/// symbolic link.
pub native fn remove_file(path: str) -> Result<()>

/// Removes an empty directory at `path`, or removes the directory and all of
/// its contents if `recursive` is `true`.
///
/// Recursive removal checks `FsWrite` for every entry in the directory tree and
/// removes symbolic links without following them. If any entry is denied by the
/// policy or requires a permission prompt, `remove_dir` fails with kind
/// `"permission_denied"`.
pub fn remove_dir(path: str, recursive: bool = false) -> Result<()> {
    if recursive { remove_tree(path) } else { remove_empty_dir(path) }
}

/// Renames or moves `src` to `dst`, replacing `dst` if it is an existing file.
///
/// Operates on the directory entry at `src` without following a final symbolic
/// link. If `src` is a directory, checks `FsWrite` on every entry inside `src`
/// and at its new location under `dst`, failing with kind `"permission_denied"`
/// if any entry is denied or requires a permission prompt.
pub native fn rename(src: str, dst: str) -> Result<()>

/// Copies the contents of regular file `src` to `dst`, creating or truncating
/// `dst` with default permissions.
pub native fn copy(src: str, dst: str) -> Result<()>

/// Returns metadata for the file or directory at `path`.
pub native fn metadata(path: str) -> Result<Metadata>

/// Joins path segments using the platform path separator. An absolute segment
/// replaces all preceding segments.
pub native fn join(parts: [str]) -> str

/// Returns the final component of `path`, or `""` if `path` has none.
pub native fn basename(path: str) -> str

/// Returns `path` without its final component, or `""` if `path` has a single
/// component.
pub native fn dirname(path: str) -> str

/// Returns the file extension of `path` without the leading dot, or `None` if
/// the final component does not have an extension.
pub native fn extension(path: str) -> str?

native fn remove_empty_dir(path: str) -> Result<()>

native fn remove_tree(path: str) -> Result<()>
