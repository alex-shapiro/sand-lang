//! URI parsing, resolution, percent-encoding, and query string handling (RFC 3986).

extend Uri {
    /// Formats the URI as a string according to RFC 3986 §5.3.
    pub fn to_str(self) -> str {
        var s = self.scheme + ":"
        if let Some(a) = self.authority() {
            s += "//" + a
        }
        s += self.path
        if let Some(q) = self.query {
            s += "?" + q
        }
        if let Some(f) = self.fragment {
            s += "#" + f
        }
        s
    }

    /// Resolves a relative or absolute URI `reference` against `self` as the
    /// base URI according to RFC 3986 §5.2.
    pub native fn join(self, reference: str) -> Result<Uri>

    /// Decodes `self.query` into `(key, value)` pairs using `parse_query`.
    pub fn query_pairs(self) -> [(str, str)] {
        match self.query {
            Some(q) => parse_query(q)
            None => []
        }
    }

    /// Formats the authority component as `userinfo@host:port`, or returns
    /// `None` if `self.host` is `None`.
    pub fn authority(self) -> str? {
        let host = self.host?
        var s = if host.contains(":") { "[" + host + "]" } else { host }
        if let Some(u) = self.userinfo {
            s = u + "@" + s
        }
        if let Some(p) = self.port {
            s += ":" + p.to_str()
        }
        Some(s)
    }

    /// Returns the default port for known schemes (`80` for `http` and `ws`,
    /// `443` for `https` and `wss`, `21` for `ftp`), or `None` for other
    /// schemes.
    pub fn default_port(self) -> int? {
        match self.scheme {
            "http" | "ws" => Some(80)
            "https" | "wss" => Some(443)
            "ftp" => Some(21)
            _ => None
        }
    }
}

/// Parses an absolute URI string with a scheme into a `Uri`. Fails with kind
/// `"parse"` on invalid syntax, characters, or port numbers.
pub native fn parse(text: str) -> Result<Uri>

/// Percent-encodes all bytes in `s` except RFC 3986 unreserved characters
/// (`A-Z`, `a-z`, `0-9`, `-`, `.`, `_`, `~`).
pub native fn encode_component(s: str) -> str

/// Percent-encodes all bytes in `s` except RFC 3986 unreserved characters and `/`.
pub native fn encode_path(s: str) -> str

/// Decodes `%XX` percent-escapes in `s`, leaving `+` unchanged. Fails with
/// kind `"parse"` on malformed escapes or invalid UTF-8.
pub native fn decode_component(s: str) -> Result<str>

/// Splits a URL query string on `&` and `=` into `(key, value)` pairs,
/// decoding `+` as a space and `%XX` percent-escapes lossily.
pub native fn parse_query(q: str) -> [(str, str)]

/// Encodes `(key, value)` pairs as a percent-encoded `&`-separated query string.
pub fn build_query(pairs: [(str, str)]) -> str {
    pairs.map(p => encode_component(p.0) + "=" + encode_component(p.1)).join("&")
}
