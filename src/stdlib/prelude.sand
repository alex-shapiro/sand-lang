//! Built-in types, traits, and functions that are in scope in every module.

/// An optional value (`Some(value)` or `None`), also written `T?`.
pub enum Option<T> {
    /// Present value of type `T`.
    Some(T)
    /// Absence of a value.
    None

    /// Returns `true` if `self` is `Some`.
    pub fn is_some(self) -> bool {
        match self {
            Some(_) => true
            None => false
        }
    }

    /// Returns `true` if `self` is `None`.
    pub fn is_none(self) -> bool {
        match self {
            Some(_) => false
            None => true
        }
    }

    /// Returns the inner value of `Some`, or aborts if `self` is `None`.
    pub fn unwrap(self) -> T {
        match self {
            Some(x) => x
            None => fail("unwrap on None", kind: "unwrap")
        }
    }

    /// Returns the inner value of `Some`, or aborts with `msg` if `self` is `None`.
    pub fn expect(self, msg: str) -> T {
        match self {
            Some(x) => x
            None => fail(msg, kind: "unwrap")
        }
    }

    /// Returns the inner value of `Some`, or `default` if `self` is `None`.
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Some(x) => x
            None => default
        }
    }

    /// Applies `f` to the inner value if `self` is `Some`.
    pub fn map<U>(self, f: fn(T) -> U) -> U? {
        match self {
            Some(x) => Some(f(x))
            None => None
        }
    }

    /// Returns `f(x)` if `self` is `Some(x)`, or `None` if `self` is `None`.
    pub fn and_then<U>(self, f: fn(T) -> U?) -> U? {
        match self {
            Some(x) => f(x)
            None => None
        }
    }

    /// Returns `self` if it is `Some`, or calls `f()` if `self` is `None`.
    pub fn or_else(self, f: fn() -> T?) -> T? {
        match self {
            Some(x) => Some(x)
            None => f()
        }
    }

    /// Converts `Some(x)` to `Ok(x)` and `None` to `Err(err)`.
    pub fn ok_or<E>(self, err: E) -> Result<T, E> {
        match self {
            Some(x) => Ok(x)
            None => Err(err)
        }
    }

    /// Returns `Some(x)` if `self` is `Some(x)` and `f(x)` is `true`, or `None`
    /// otherwise.
    pub fn filter(self, f: fn(T) -> bool) -> T? {
        match self {
            Some(x) if f(x) => Some(x)
            _ => None
        }
    }
}

/// The outcome of a fallible operation (`Ok(value)` or `Err(error)`).
/// `Result<T>` is shorthand for `Result<T, Error>`.
pub enum Result<T, E> {
    /// Successful result containing a value of type `T`.
    Ok(T)
    /// Failed result containing an error of type `E`.
    Err(E)

    /// Returns `true` if `self` is `Ok`.
    pub fn is_ok(self) -> bool {
        match self {
            Ok(_) => true
            Err(_) => false
        }
    }

    /// Returns `true` if `self` is `Err`.
    pub fn is_err(self) -> bool {
        match self {
            Ok(_) => false
            Err(_) => true
        }
    }

    /// Returns the `Ok` value, or aborts if `self` is `Err`.
    pub fn unwrap(self) -> T {
        match self {
            Ok(x) => x
            Err(e) => fail("unwrap on Err: \(e)", kind: "unwrap")
        }
    }

    /// Returns the `Ok` value, or aborts with `msg` if `self` is `Err`.
    pub fn expect(self, msg: str) -> T {
        match self {
            Ok(x) => x
            Err(e) => fail("\(msg): \(e)", kind: "unwrap")
        }
    }

    /// Returns the `Ok` value, or `default` if `self` is `Err`.
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Ok(x) => x
            Err(_) => default
        }
    }

    /// Returns the `Err` value, or aborts if `self` is `Ok`.
    pub fn unwrap_err(self) -> E {
        match self {
            Ok(x) => fail("unwrap_err on Ok: \(x.debug())", kind: "unwrap")
            Err(e) => e
        }
    }

    /// Applies `f` to the `Ok` value, leaving `Err` unchanged.
    pub fn map<U>(self, f: fn(T) -> U) -> Result<U, E> {
        match self {
            Ok(x) => Ok(f(x))
            Err(e) => Err(e)
        }
    }

    /// Applies `f` to the `Err` value, leaving `Ok` unchanged.
    pub fn map_err<F>(self, f: fn(E) -> F) -> Result<T, F> {
        match self {
            Ok(x) => Ok(x)
            Err(e) => Err(f(e))
        }
    }

    /// Returns `f(x)` if `self` is `Ok(x)`, or propagates `Err(e)`.
    pub fn and_then<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Ok(x) => f(x)
            Err(e) => Err(e)
        }
    }

    /// Converts `Ok(x)` to `Some(x)` and `Err(_)` to `None`.
    pub fn ok(self) -> T? {
        match self {
            Ok(x) => Some(x)
            Err(_) => None
        }
    }

    /// Converts `Err(e)` to `Some(e)` and `Ok(_)` to `None`.
    pub fn err(self) -> E? {
        match self {
            Ok(_) => None
            Err(e) => Some(e)
        }
    }
}

/// Standard error record with a machine-readable `kind` tag and human-readable
/// `message`.
pub struct Error {
    /// Machine-readable category tag (such as `"not_found"` or `"permission_denied"`).
    kind: str
    /// Human-readable error description.
    message: str
}

/// Constructs an `Error` with `message` and `kind`.
pub fn error(message: str, kind: str = "error") -> Error {
    Error { kind, message }
}

/// Handle to a concurrent task started with `spawn`.
pub native type Task<T>

extend<T> Task<T> {
    /// Suspends the calling task until `self` completes and returns its result.
    pub native fn wait(self) -> T
    /// Returns `true` if `self` has completed or been cancelled.
    pub native fn is_done(self) -> bool
    /// Cancels `self` if it is still running.
    pub native fn cancel(self)
}

/// FIFO message queue for communicating between tasks (created with `task.channel`).
pub native type Channel<T>

extend<T> Channel<T> {
    /// Sends `value` into the channel, suspending while a bounded channel is
    /// full. Returns `false` if the channel is closed.
    pub native fn send(self, value: T) -> bool
    /// Receives the next value from the channel, suspending while empty.
    /// Returns `None` once the channel is closed and drained.
    pub native fn recv(self) -> T?
    /// Receives the next queued value without suspending, or returns `None` if
    /// the channel is empty.
    pub native fn try_recv(self) -> T?
    /// Closes the channel so subsequent `send` calls return `false` and
    /// receivers yield `None` after draining queued messages.
    pub native fn close(self)
    /// Returns the number of messages currently queued in the channel.
    pub native fn len(self) -> int
    /// Returns `true` if `close` has been called on the channel.
    pub native fn is_closed(self) -> bool

    /// Returns a lazy iterator that receives values from the channel until it
    /// is closed and drained.
    pub fn iter(self) -> Iter<T> {
        Iter { next: () => self.recv() }
    }
}

/// A resource handle (such as an open file or network socket) that can be
/// closed deterministically with `use`:
///
/// ```
/// use f = fs.open("data.txt")?
/// ```
pub trait Close {
    /// Releases the underlying resource. Closing an already closed resource is
    /// a no-op; subsequent operations on a closed resource fail with kind
    /// `"closed"`.
    fn close(self)
}

impl<T: Close> Close for T? {
    /// Closes the inner resource if `self` is `Some`.
    fn close(self) {
        if let Some(x) = self {
            x.close()
        }
    }
}

impl<T: Close> Close for [T] {
    /// Closes every element in reverse order.
    fn close(self) {
        for x in self.reversed() {
            x.close()
        }
    }
}

/// Prints the display representation of `x` followed by a newline to standard output.
pub native fn print<T>(x: T)

/// Prints the display representation of `x` followed by a newline to standard error.
pub native fn eprint<T>(x: T)

/// Aborts execution immediately with an uncaught runtime error.
pub native fn fail(message: str, kind: str = "error") -> never

/// Aborts execution with `message` (kind `"assert"`) if `cond` is `false`.
pub fn assert(cond: bool, message: str = "condition is false") {
    if not cond {
        fail(message, kind: "assert")
    }
}

/// Aborts execution with kind `"todo"` to mark unimplemented code.
pub fn todo() -> never {
    fail("not yet implemented", kind: "todo")
}

/// Terminates the program immediately with exit status `code`.
pub native fn exit(code: int) -> never

/// Constructs a `Set<T>` containing the unique elements of `items` in insertion order.
pub native fn set<T: Hash>(items: [T] = []) -> Set<T>

/// Prints documentation for `x` (a module, type, trait, function, method, or
/// string path).
pub native fn help<T>(x: T)

/// Returns the sorted member names accessible after `x.`, or the names in scope
/// if called as `members()`.
pub native fn members<T>(x: T) -> [str]

trait Num {
    fn zero() -> Self
    fn one() -> Self
}

impl Num for int {
    fn zero() -> int { 0 }

    fn one() -> int { 1 }
}

impl Num for float {
    fn zero() -> float { 0.0 }

    fn one() -> float { 1.0 }
}

/// Boolean truth values (`true` and `false`).
extend bool {}

/// 64-bit signed two's-complement integers. Arithmetic is checked and aborts on
/// overflow or division by zero.
extend int {
    /// Returns the absolute value of `self`.
    pub fn abs(self) -> int {
        if self < 0 { -self } else { self }
    }

    /// Returns `self` raised to the non-negative exponent `e`.
    pub fn pow(self, e: int) -> int {
        self ** e
    }

    /// Returns the smaller of `self` and `other`.
    pub fn min(self, other: int) -> int {
        if self < other { self } else { other }
    }

    /// Returns the larger of `self` and `other`.
    pub fn max(self, other: int) -> int {
        if self > other { self } else { other }
    }

    /// Clamps `self` to the inclusive range `lo..=hi`.
    pub fn clamp(self, lo: int, hi: int) -> int {
        if self < lo { lo } else if self > hi { hi } else { self }
    }

    /// Returns `-1` if negative, `0` if zero, or `1` if positive.
    pub fn sign(self) -> int {
        if self > 0 { 1 } else if self < 0 { -1 } else { 0 }
    }

    /// Returns `true` if `self` is divisible by `2`.
    pub fn is_even(self) -> bool {
        self % 2 == 0
    }

    /// Returns `true` if `self` is not divisible by `2`.
    pub fn is_odd(self) -> bool {
        self % 2 != 0
    }

    /// Converts `self` to the nearest `float` (exact up to `±2^53`).
    pub native fn to_float(self) -> float
    /// Formats `self` in base `radix` (`2..=36`).
    pub native fn to_str_radix(self, radix: int) -> str
    /// Converts a Unicode scalar value to a single-character `str`, or returns
    /// `None` if `self` is not a valid scalar value.
    pub native fn to_char(self) -> str?

    /// Returns the maximum 64-bit signed integer (`2^63 - 1`).
    pub fn max_value() -> int {
        9223372036854775807
    }

    /// Returns the minimum 64-bit signed integer (`-2^63`).
    pub fn min_value() -> int {
        -9223372036854775808
    }
}

/// IEEE-754 double-precision (64-bit) floating-point numbers.
extend float {
    /// Returns the absolute value of `self`.
    pub native fn abs(self) -> float
    /// Returns the largest integer value less than or equal to `self`.
    pub native fn floor(self) -> float
    /// Returns the smallest integer value greater than or equal to `self`.
    pub native fn ceil(self) -> float
    /// Rounds `self` to the nearest integer, rounding half-way cases away from zero.
    pub native fn round(self) -> float
    /// Rounds `self` toward zero to an integer value.
    pub native fn trunc(self) -> float
    /// Returns the square root of `self` (`NaN` if `self < 0.0`).
    pub native fn sqrt(self) -> float
    /// Returns `self` raised to the power `e`.
    pub native fn pow(self, e: float) -> float
    /// Returns the smaller of `self` and `other`, ignoring `NaN`.
    pub native fn min(self, other: float) -> float
    /// Returns the larger of `self` and `other`, ignoring `NaN`.
    pub native fn max(self, other: float) -> float
    /// Returns `true` if `self` is `NaN`.
    pub native fn is_nan(self) -> bool
    /// Returns `true` if `self` is finite (neither infinite nor `NaN`).
    pub native fn is_finite(self) -> bool
    /// Returns `true` if `self` is positive or negative infinity.
    pub native fn is_infinite(self) -> bool
    /// Truncates `self` toward zero to an `int`, or aborts if `self` is `NaN`
    /// or out of the 64-bit integer range.
    pub native fn to_int(self) -> int
    /// Formats `self` with `digits` digits after the decimal point.
    pub native fn to_str_fixed(self, digits: int) -> str

    /// Clamps `self` to the inclusive range `lo..=hi`.
    pub fn clamp(self, lo: float, hi: float) -> float {
        self.max(lo).min(hi)
    }
}

/// Immutable UTF-8 strings. Lengths and slice offsets are measured in UTF-8
/// bytes; `chars()` returns Unicode scalar values as single-character strings.
extend str {
    /// Returns the length of `self` in UTF-8 bytes.
    pub native fn len(self) -> int
    /// Returns `true` if `self` has byte length `0`.
    pub native fn is_empty(self) -> bool
    /// Returns the Unicode scalar values of `self` as single-character strings.
    pub native fn chars(self) -> [str]
    /// Returns the number of Unicode scalar values in `self`.
    pub native fn char_count(self) -> int
    /// Returns the Unicode scalar values of `self` as integer code points.
    pub native fn codepoints(self) -> [int]
    /// Returns the UTF-8 byte representation of `self`.
    pub native fn bytes(self) -> bytes
    /// Returns `true` if `sub` occurs anywhere in `self`.
    pub native fn contains(self, sub: str) -> bool
    /// Returns `true` if `self` begins with `prefix`.
    pub native fn starts_with(self, prefix: str) -> bool
    /// Returns `true` if `self` ends with `suffix`.
    pub native fn ends_with(self, suffix: str) -> bool
    /// Returns the byte offset of the first occurrence of `sub`, or `None` if absent.
    pub native fn find(self, sub: str) -> int?
    /// Returns the byte offset of the last occurrence of `sub`, or `None` if absent.
    pub native fn rfind(self, sub: str) -> int?
    /// Replaces all non-overlapping occurrences of `pattern` with `replacement`.
    pub native fn replace(self, pattern: str, replacement: str) -> str
    /// Splits `self` around each occurrence of non-empty delimiter `sep`.
    pub native fn split(self, sep: str) -> [str]
    /// Splits `self` on the first occurrence of `sep` into `(before, after)`,
    /// or returns `None` if `sep` is absent.
    pub native fn split_once(self, sep: str) -> (str, str)?
    /// Splits `self` on runs of Unicode whitespace, omitting empty substrings.
    pub native fn split_whitespace(self) -> [str]
    /// Splits `self` into lines on `\n` or `\r\n`, without a trailing empty
    /// element after a final newline.
    pub native fn lines(self) -> [str]
    /// Removes leading and trailing Unicode whitespace.
    pub native fn trim(self) -> str
    /// Removes leading Unicode whitespace.
    pub native fn trim_start(self) -> str
    /// Removes trailing Unicode whitespace.
    pub native fn trim_end(self) -> str
    /// Returns `self` with leading `prefix` removed, or `None` if `self` does
    /// not start with `prefix`.
    pub native fn strip_prefix(self, prefix: str) -> str?
    /// Returns `self` with trailing `suffix` removed, or `None` if `self` does
    /// not end with `suffix`.
    pub native fn strip_suffix(self, suffix: str) -> str?
    /// Converts `self` to uppercase using Unicode case mapping.
    pub native fn to_upper(self) -> str
    /// Converts `self` to lowercase using Unicode case mapping.
    pub native fn to_lower(self) -> str
    /// Repeats `self` `n` times, or aborts if `n < 0`.
    pub native fn repeat(self, n: int) -> str
    /// Pads `self` on the left with `fill` to at least `width` characters.
    pub native fn pad_start(self, width: int, fill: str = " ") -> str
    /// Pads `self` on the right with `fill` to at least `width` characters.
    pub native fn pad_end(self, width: int, fill: str = " ") -> str
    /// Parses `self` as a signed integer in base `radix` (`2..=36`), or returns
    /// `None` on invalid input.
    pub native fn parse_int(self, radix: int = 10) -> int?
    /// Parses `self` as a `float` (including `"inf"`, `"-inf"`, and `"nan"`),
    /// or returns `None` on invalid input.
    pub native fn parse_float(self) -> float?
    /// Returns `true` if `self` is non-empty and all characters are ASCII digits.
    pub native fn is_digit(self) -> bool
    /// Returns `true` if `self` is non-empty and all characters are Unicode alphabetic.
    pub native fn is_alpha(self) -> bool
    /// Returns `true` if `self` is non-empty and all characters are Unicode alphanumeric.
    pub native fn is_alnum(self) -> bool
    /// Returns `true` if `self` is non-empty and all characters are Unicode whitespace.
    pub native fn is_space(self) -> bool
    /// Returns `true` if `self` is non-empty and all characters are Unicode uppercase.
    pub native fn is_upper(self) -> bool
    /// Returns `true` if `self` is non-empty and all characters are Unicode lowercase.
    pub native fn is_lower(self) -> bool
    /// Returns the single-character string starting at UTF-8 byte offset `i`,
    /// or `None` if `i` is not a character boundary.
    pub native fn char_at(self, i: int) -> str?
    /// Returns the Unicode scalar value of a single-character string.
    pub native fn ord(self) -> int
    /// Returns `self` with its Unicode scalar values in reverse order.
    pub native fn reversed(self) -> str

    /// Returns a lazy iterator over the Unicode scalar values of `self` as
    /// single-character strings.
    pub fn chars_iter(self) -> Iter<str> {
        Iter { next: self.chars_iter_next() }
    }

    native fn chars_iter_next(self) -> fn() -> str?
}

/// Immutable byte sequences, written `b"..."`.
extend bytes {
    /// Returns the number of bytes in `self`.
    pub native fn len(self) -> int
    /// Returns `true` if `self` has length `0`.
    pub native fn is_empty(self) -> bool
    /// Returns the byte at index `i` (`0..=255`), or `None` if `i` is out of bounds.
    pub native fn get(self, i: int) -> int?
    /// Returns the bytes of `self` as a list of integers in `0..=255`.
    pub native fn to_list(self) -> [int]
    /// Decodes `self` as UTF-8 text, or fails with kind `"invalid"` if `self`
    /// is not valid UTF-8.
    pub native fn to_str(self) -> Result<str, Error>
    /// Decodes `self` as UTF-8 text, replacing invalid sequences with `U+FFFD`.
    pub native fn to_str_lossy(self) -> str
    /// Encodes `self` as lowercase hexadecimal text (two hex digits per byte).
    pub native fn to_hex(self) -> str
    /// Returns `true` if `needle` occurs as a contiguous subsequence of `self`.
    pub native fn contains(self, needle: bytes) -> bool
    /// Returns the start index of the first occurrence of `needle`, or `None` if absent.
    pub native fn find(self, needle: bytes) -> int?
    /// Constructs a `bytes` value from a list of integers in `0..=255`.
    pub native fn from_list(items: [int]) -> bytes
    /// Decodes a hexadecimal string (two hex digits per byte, case-insensitive)
    /// into `bytes`, or returns `None` on invalid input.
    pub native fn from_hex(text: str) -> bytes?
}

/// Signed elapsed durations with nanosecond precision, written `250ms`, `1.5s`,
/// or `2h`.
extend duration {
    /// Returns the total duration in nanoseconds.
    pub native fn nanos(self) -> int
    /// Returns whole microseconds, truncated toward zero.
    pub native fn micros(self) -> int
    /// Returns whole milliseconds, truncated toward zero.
    pub native fn millis(self) -> int
    /// Returns the duration in seconds as a `float`.
    pub native fn secs(self) -> float
    /// Returns the absolute value of `self`.
    pub native fn abs(self) -> duration
    /// Constructs a `duration` of `n` nanoseconds.
    pub native fn from_nanos(n: int) -> duration
    /// Constructs a `duration` of `n` milliseconds, or aborts on overflow.
    pub native fn from_millis(n: int) -> duration
    /// Constructs a `duration` of `s` seconds truncated to nanoseconds, or
    /// aborts on `NaN` or overflow.
    pub native fn from_secs(s: float) -> duration
}

/// Growable list (`[1, 2, 3]`). `[T]` is shorthand for `List<T>`. Lists are
/// mutable reference types.
extend<T> [T] {
    /// Returns the number of elements in the list.
    pub native fn len(self) -> int
    /// Returns `true` if the list contains zero elements.
    pub native fn is_empty(self) -> bool
    /// Appends `x` to the end of the list.
    pub native fn push(self, x: T)
    /// Removes and returns the last element, or `None` if the list is empty.
    pub native fn pop(self) -> T?
    /// Inserts `x` at index `i` (`0..=len()`), shifting subsequent elements to
    /// the right.
    pub native fn insert(self, i: int, x: T)
    /// Removes and returns the element at index `i`, shifting subsequent
    /// elements to the left.
    pub native fn remove(self, i: int) -> T
    /// Appends all elements of `items` to the list.
    pub native fn extend(self, items: [T])
    /// Removes all elements from the list.
    pub native fn clear(self)
    /// Returns the element at index `i`, or `None` if `i` is out of bounds.
    pub native fn get(self, i: int) -> T?
    /// Returns the first element, or `None` if the list is empty.
    pub native fn first(self) -> T?
    /// Returns the last element, or `None` if the list is empty.
    pub native fn last(self) -> T?
    /// Returns `true` if the list contains an element equal to `x`.
    pub native fn contains(self, x: T) -> bool where T: Eq
    /// Returns the index of the first element equal to `x`, or `None` if absent.
    pub native fn index_of(self, x: T) -> int? where T: Eq
    /// Reverses the list in place.
    pub native fn reverse(self)
    /// Returns a new list with the elements in reverse order.
    pub native fn reversed(self) -> [T]
    /// Sorts the list in place in ascending order (stable).
    pub native fn sort(self) where T: Ord
    /// Returns a new list sorted in ascending order (stable).
    pub native fn sorted(self) -> [T] where T: Ord
    /// Returns a shallow copy of the list.
    pub native fn copy(self) -> [T]
    /// Swaps the elements at indices `i` and `j`.
    pub native fn swap(self, i: int, j: int)
    /// Returns up to the first `n` elements in a new list.
    pub native fn take(self, n: int) -> [T]
    /// Returns the elements after the first `n` elements in a new list.
    pub native fn skip(self, n: int) -> [T]
    /// Splits the list into non-overlapping chunks of up to `n` elements
    /// (`n > 0`).
    pub native fn chunks(self, n: int) -> [[T]]
    /// Returns overlapping sliding windows of `n` consecutive elements (`n > 0`).
    pub native fn windows(self, n: int) -> [[T]]
    /// Returns `(index, element)` pairs starting from `0`.
    pub native fn enumerate(self) -> [(int, T)]
    /// Pairs elements of `self` and `other` at matching indices up to the
    /// shorter length.
    pub native fn zip<U>(self, other: [U]) -> [(T, U)]
    /// Returns a new list with consecutive duplicate elements removed.
    pub native fn dedup(self) -> [T] where T: Eq
    /// Returns a new list containing the first occurrence of each distinct element.
    pub native fn unique(self) -> [T] where T: Hash
    /// Collects the distinct elements into a `Set<T>` in order of first appearance.
    pub native fn to_set(self) -> Set<T> where T: Hash
    native fn sum_from(self, init: T) -> T
    native fn product_from(self, init: T) -> T
    /// Returns the minimum element, or `None` if the list is empty.
    pub native fn min(self) -> T? where T: Ord
    /// Returns the maximum element, or `None` if the list is empty.
    pub native fn max(self) -> T? where T: Ord
    native fn sort_by_keys<K>(self, keys: [K])

    /// Returns a lazy iterator over the elements of the list.
    pub fn iter(self) -> Iter<T> {
        Iter { next: self.iter_next() }
    }

    native fn iter_next(self) -> fn() -> T?

    /// Returns the sum of all elements (`T.zero()` if empty).
    pub fn sum(self) -> T where T: Num {
        self.sum_from(T.zero())
    }

    /// Returns the product of all elements (`T.one()` if empty).
    pub fn product(self) -> T where T: Num {
        self.product_from(T.one())
    }

    /// Applies `f` to each element and returns the results in a new list.
    pub fn map<U>(self, f: fn(T) -> U) -> [U] {
        let out = []
        for x in self {
            out.push(f(x))
        }
        out
    }

    /// Returns a new list containing the elements for which `f` returns `true`.
    pub fn filter(self, f: fn(T) -> bool) -> [T] {
        let out = []
        for x in self {
            if f(x) {
                out.push(x)
            }
        }
        out
    }

    /// Applies `f` to each element and collects the `Some` values into a new list.
    pub fn filter_map<U>(self, f: fn(T) -> U?) -> [U] {
        let out = []
        for x in self {
            if let Some(y) = f(x) {
                out.push(y)
            }
        }
        out
    }

    /// Applies `f` to each element and concatenates the resulting lists.
    pub fn flat_map<U>(self, f: fn(T) -> [U]) -> [U] {
        let out = []
        for x in self {
            out.extend(f(x))
        }
        out
    }

    /// Calls `f` on each element in order.
    pub fn each(self, f: fn(T)) {
        for x in self {
            f(x)
        }
    }

    /// Folds the elements from left to right starting from `init`.
    pub fn fold<A>(self, init: A, f: fn(A, T) -> A) -> A {
        var acc = init
        for x in self {
            acc = f(acc, x)
        }
        acc
    }

    /// Folds the elements from left to right using the first element as the
    /// initial accumulator, or returns `None` if the list is empty.
    pub fn reduce(self, f: fn(T, T) -> T) -> T? {
        var acc = self.first()?
        var first = true
        for x in self {
            if first {
                first = false
            } else {
                acc = f(acc, x)
            }
        }
        Some(acc)
    }

    /// Returns `true` if `f` returns `true` for any element.
    pub fn any(self, f: fn(T) -> bool) -> bool {
        for x in self {
            if f(x) {
                return true
            }
        }
        false
    }

    /// Returns `true` if `f` returns `true` for every element.
    pub fn all(self, f: fn(T) -> bool) -> bool {
        for x in self {
            if not f(x) {
                return false
            }
        }
        true
    }

    /// Returns the first element for which `f` returns `true`, or `None` if
    /// none match.
    pub fn find(self, f: fn(T) -> bool) -> T? {
        for x in self {
            if f(x) {
                return Some(x)
            }
        }
        None
    }

    /// Returns the index of the first element for which `f` returns `true`, or
    /// `None` if none match.
    pub fn find_index(self, f: fn(T) -> bool) -> int? {
        var i = 0
        for x in self {
            if f(x) {
                return Some(i)
            }
            i += 1
        }
        None
    }

    /// Returns the number of elements for which `f` returns `true`.
    pub fn count(self, f: fn(T) -> bool) -> int {
        var n = 0
        for x in self {
            if f(x) {
                n += 1
            }
        }
        n
    }

    /// Returns the longest prefix of elements for which `f` returns `true`.
    pub fn take_while(self, f: fn(T) -> bool) -> [T] {
        let out = []
        for x in self {
            if not f(x) {
                break
            }
            out.push(x)
        }
        out
    }

    /// Returns the remaining elements after dropping the longest prefix for
    /// which `f` returns `true`.
    pub fn skip_while(self, f: fn(T) -> bool) -> [T] {
        let out = []
        var skipping = true
        for x in self {
            if skipping and f(x) {
                continue
            }
            skipping = false
            out.push(x)
        }
        out
    }

    /// Groups elements into a map keyed by `key(element)` in order of first
    /// appearance.
    pub fn group_by<K: Hash>(self, key: fn(T) -> K) -> [K: [T]] {
        let out: [K: [T]] = [:]
        for x in self {
            let k = key(x)
            match out.get(k) {
                Some(group) => group.push(x)
                None => {
                    out[k] = [x]
                }
            }
        }
        out
    }

    /// Splits the list into `(matching, non_matching)` according to `f`.
    pub fn partition(self, f: fn(T) -> bool) -> ([T], [T]) {
        let yes = []
        let no = []
        for x in self {
            if f(x) {
                yes.push(x)
            } else {
                no.push(x)
            }
        }
        (yes, no)
    }

    /// Returns the first element with the minimum value of `key(element)`, or
    /// `None` if the list is empty.
    pub fn min_by<K: Ord>(self, key: fn(T) -> K) -> T? {
        var best = self.first()?
        var best_key = key(best)
        var first = true
        for x in self {
            if first {
                first = false
                continue
            }
            let k = key(x)
            if k < best_key {
                best = x
                best_key = k
            }
        }
        Some(best)
    }

    /// Returns the first element with the maximum value of `key(element)`, or
    /// `None` if the list is empty.
    pub fn max_by<K: Ord>(self, key: fn(T) -> K) -> T? {
        var best = self.first()?
        var best_key = key(best)
        var first = true
        for x in self {
            if first {
                first = false
                continue
            }
            let k = key(x)
            if k > best_key {
                best = x
                best_key = k
            }
        }
        Some(best)
    }

    /// Sorts the list in place by `key(element)` (stable).
    pub fn sort_by<K: Ord>(self, key: fn(T) -> K) {
        self.sort_by_keys(self.map(key))
    }

    /// Returns a new list sorted by `key(element)` (stable).
    pub fn sorted_by<K: Ord>(self, key: fn(T) -> K) -> [T] {
        let out = self.copy()
        out.sort_by_keys(out.map(key))
        out
    }
}

extend [str] {
    /// Concatenates the strings in `self` separated by `sep`.
    pub native fn join(self, sep: str = "") -> str
}

/// Insertion-ordered hash map (`["a": 1]`, or `[:]` if empty). `[K: V]` is
/// shorthand for `Map<K, V>`. Maps are mutable reference types, and keys must
/// implement `Hash`.
extend<K: Hash, V> [K: V] {
    /// Returns the number of key-value entries in the map.
    pub native fn len(self) -> int
    /// Returns `true` if the map contains zero entries.
    pub native fn is_empty(self) -> bool
    /// Returns the value associated with `key`, or `None` if `key` is absent.
    pub native fn get(self, key: K) -> V?
    /// Returns the value associated with `key`, or `default` if `key` is absent.
    pub native fn get_or(self, key: K, default: V) -> V
    /// Returns `true` if `key` is present in the map.
    pub native fn contains(self, key: K) -> bool
    /// Sets `key` to `value` and returns the previous value, if any.
    pub native fn insert(self, key: K, value: V) -> V?
    /// Removes `key` from the map and returns its previous value, if any.
    pub native fn remove(self, key: K) -> V?
    /// Returns the keys of the map in insertion order.
    pub native fn keys(self) -> [K]
    /// Returns the values of the map in insertion order.
    pub native fn values(self) -> [V]
    /// Returns the `(key, value)` pairs of the map in insertion order.
    pub native fn entries(self) -> [(K, V)]
    /// Removes all entries from the map.
    pub native fn clear(self)
    /// Returns a shallow copy of the map.
    pub native fn copy(self) -> [K: V]
    /// Inserts all entries from `other`, overwriting existing values for matching keys.
    pub native fn extend(self, other: [K: V])
    /// Returns the existing value for `key`, or inserts `default` and returns it.
    pub native fn get_or_insert(self, key: K, default: V) -> V

    /// Returns a lazy iterator over a snapshot of the `(key, value)` entries in
    /// insertion order.
    pub fn iter(self) -> Iter<(K, V)> {
        Iter { next: self.iter_next() }
    }

    native fn iter_next(self) -> fn() -> (K, V)?

    /// Returns a new map with `f` applied to each value.
    pub fn map_values<W>(self, f: fn(V) -> W) -> [K: W] {
        let out: [K: W] = [:]
        for (k, v) in self {
            out[k] = f(v)
        }
        out
    }

    /// Returns a new map containing the entries for which `f(key, value)`
    /// returns `true`.
    pub fn filter(self, f: fn(K, V) -> bool) -> [K: V] {
        let out: [K: V] = [:]
        for (k, v) in self {
            if f(k, v) {
                out[k] = v
            }
        }
        out
    }
}

/// Insertion-ordered hash set constructed with `set([...])`. Sets are mutable
/// reference types, and elements must implement `Hash`.
extend<T: Hash> Set<T> {
    /// Returns the number of elements in the set.
    pub native fn len(self) -> int
    /// Returns `true` if the set contains zero elements.
    pub native fn is_empty(self) -> bool
    /// Inserts `x` into the set and returns `true` if `x` was not already present.
    pub native fn add(self, x: T) -> bool
    /// Removes `x` from the set and returns `true` if `x` was present.
    pub native fn remove(self, x: T) -> bool
    /// Returns `true` if `x` is in the set.
    pub native fn contains(self, x: T) -> bool
    /// Returns the elements of the set in insertion order as a list.
    pub native fn to_list(self) -> [T]
    /// Returns a new set containing elements present in `self` or `other`.
    pub native fn union(self, other: Set<T>) -> Set<T>
    /// Returns a new set containing elements present in both `self` and `other`.
    pub native fn intersection(self, other: Set<T>) -> Set<T>
    /// Returns a new set containing elements in `self` that are not in `other`.
    pub native fn difference(self, other: Set<T>) -> Set<T>
    /// Returns `true` if every element of `self` is also in `other`.
    pub native fn is_subset(self, other: Set<T>) -> bool
    /// Returns a shallow copy of the set.
    pub native fn copy(self) -> Set<T>
    /// Removes all elements from the set.
    pub native fn clear(self)

    /// Returns a lazy iterator over a snapshot of the elements in insertion order.
    pub fn iter(self) -> Iter<T> {
        Iter { next: self.iter_next() }
    }

    native fn iter_next(self) -> fn() -> T?
}

/// Half-open (`a..b`) or inclusive (`a..=b`) integer ranges.
extend Range {
    /// Returns the inclusive start bound.
    pub native fn start(self) -> int
    /// Returns the exclusive end bound, or aborts on `int` overflow.
    pub native fn end(self) -> int
    /// Returns the number of integers in the range, or aborts on `int` overflow.
    pub native fn len(self) -> int
    /// Returns `true` if the range contains zero integers.
    pub native fn is_empty(self) -> bool
    /// Returns `true` if `i` lies within the range.
    pub native fn contains(self, i: int) -> bool
    /// Returns the first integer in the range, or `None` if empty.
    pub native fn first(self) -> int?
    /// Returns the last integer in the range, or `None` if empty.
    pub native fn last(self) -> int?
    /// Returns the smallest integer in the range, or `None` if empty.
    pub native fn min(self) -> int?
    /// Returns the largest integer in the range, or `None` if empty.
    pub native fn max(self) -> int?
    /// Returns the sum of the integers in the range (`0` if empty).
    pub native fn sum(self) -> int
    /// Returns the product of the integers in the range (`1` if empty).
    pub native fn product(self) -> int
    /// Collects the integers in the range into a list.
    pub native fn to_list(self) -> [int]
    /// Returns every `step`-th integer starting from `start()` (`step > 0`).
    pub native fn step_by(self, step: int) -> [int]
    /// Returns the integers in the range in descending order.
    pub native fn reversed(self) -> [int]

    /// Returns a lazy iterator over the integers in the range.
    pub fn iter(self) -> Iter<int> {
        Iter { next: self.iter_next() }
    }

    native fn iter_next(self) -> fn() -> int?

    /// Applies `f` to every integer in the range and collects the results.
    pub fn map<U>(self, f: fn(int) -> U) -> [U] {
        let out = []
        for i in self {
            out.push(f(i))
        }
        out
    }

    /// Returns the integers in the range for which `f` returns `true`.
    pub fn filter(self, f: fn(int) -> bool) -> [int] {
        let out = []
        for i in self {
            if f(i) {
                out.push(i)
            }
        }
        out
    }

    /// Applies `f` to every integer in the range and collects the `Some` results.
    pub fn filter_map<U>(self, f: fn(int) -> U?) -> [U] {
        let out = []
        for i in self {
            if let Some(y) = f(i) {
                out.push(y)
            }
        }
        out
    }

    /// Applies `f` to every integer in the range and concatenates the resulting lists.
    pub fn flat_map<U>(self, f: fn(int) -> [U]) -> [U] {
        let out = []
        for i in self {
            out.extend(f(i))
        }
        out
    }

    /// Calls `f` on every integer in the range.
    pub fn each(self, f: fn(int)) {
        for i in self {
            f(i)
        }
    }

    /// Folds the integers in the range from left to right starting from `init`.
    pub fn fold<A>(self, init: A, f: fn(A, int) -> A) -> A {
        var acc = init
        for i in self {
            acc = f(acc, i)
        }
        acc
    }

    /// Folds the integers in the range from left to right, or returns `None` if empty.
    pub fn reduce(self, f: fn(int, int) -> int) -> int? {
        var acc = self.first()?
        var first = true
        for i in self {
            if first {
                first = false
            } else {
                acc = f(acc, i)
            }
        }
        Some(acc)
    }

    /// Returns `true` if `f` returns `true` for any integer in the range.
    pub fn any(self, f: fn(int) -> bool) -> bool {
        for i in self {
            if f(i) {
                return true
            }
        }
        false
    }

    /// Returns `true` if `f` returns `true` for every integer in the range.
    pub fn all(self, f: fn(int) -> bool) -> bool {
        for i in self {
            if not f(i) {
                return false
            }
        }
        true
    }

    /// Returns the first integer in the range for which `f` returns `true`.
    pub fn find(self, f: fn(int) -> bool) -> int? {
        for i in self {
            if f(i) {
                return Some(i)
            }
        }
        None
    }

    /// Returns the 0-based offset of the first integer for which `f` returns `true`.
    pub fn find_index(self, f: fn(int) -> bool) -> int? {
        var n = 0
        for i in self {
            if f(i) {
                return Some(n)
            }
            n += 1
        }
        None
    }

    /// Returns the number of integers in the range for which `f` returns `true`.
    pub fn count(self, f: fn(int) -> bool) -> int {
        var n = 0
        for i in self {
            if f(i) {
                n += 1
            }
        }
        n
    }

    /// Returns the longest prefix of integers for which `f` returns `true`.
    pub fn take_while(self, f: fn(int) -> bool) -> [int] {
        let out = []
        for i in self {
            if not f(i) {
                break
            }
            out.push(i)
        }
        out
    }

    /// Returns the remaining integers after dropping the longest prefix for
    /// which `f` returns `true`.
    pub fn skip_while(self, f: fn(int) -> bool) -> [int] {
        let out = []
        var skipping = true
        for i in self {
            if skipping and f(i) {
                continue
            }
            skipping = false
            out.push(i)
        }
        out
    }

    /// Groups integers in the range by `key(i)` in order of first appearance.
    pub fn group_by<K: Hash>(self, key: fn(int) -> K) -> [K: [int]] {
        let out: [K: [int]] = [:]
        for i in self {
            let k = key(i)
            match out.get(k) {
                Some(group) => group.push(i)
                None => {
                    out[k] = [i]
                }
            }
        }
        out
    }

    /// Splits the integers in the range into `(matching, non_matching)`.
    pub fn partition(self, f: fn(int) -> bool) -> ([int], [int]) {
        let yes = []
        let no = []
        for i in self {
            if f(i) {
                yes.push(i)
            } else {
                no.push(i)
            }
        }
        (yes, no)
    }

    /// Returns the first integer with the minimum value of `key(i)`, or `None` if empty.
    pub fn min_by<K: Ord>(self, key: fn(int) -> K) -> int? {
        var best = self.first()?
        var best_key = key(best)
        var first = true
        for i in self {
            if first {
                first = false
                continue
            }
            let k = key(i)
            if k < best_key {
                best = i
                best_key = k
            }
        }
        Some(best)
    }

    /// Returns the first integer with the maximum value of `key(i)`, or `None` if empty.
    pub fn max_by<K: Ord>(self, key: fn(int) -> K) -> int? {
        var best = self.first()?
        var best_key = key(best)
        var first = true
        for i in self {
            if first {
                first = false
                continue
            }
            let k = key(i)
            if k > best_key {
                best = i
                best_key = k
            }
        }
        Some(best)
    }
}

/// Sequential element source supporting `for` loops and lazy `Iter<T>` pipelines.
pub trait Iterator<T> {
    /// Advances the iterator and returns the next element, or `None` if exhausted.
    fn next(self) -> T?

    /// Wraps `self` in a lazy `Iter<T>` that provides adapter and consumer methods.
    fn iter(self) -> Iter<T> {
        Iter { next: () => self.next() }
    }
}

/// A single-pass lazy iterator backed by a `next` closure. Adapters (`map`,
/// `filter`, `take`) construct new `Iter<T>` values without advancing the
/// source, and consumers (`to_list`, `fold`, `sum`, or `for` loops) pull
/// elements on demand.
pub struct Iter<T> {
    /// Closure that produces the next element or `None` once exhausted.
    next: fn() -> T?

    /// Constructs an iterator that calls `f()` to produce each element until
    /// `f()` returns `None`.
    pub fn from_fn(f: fn() -> T?) -> Iter<T> {
        Iter { next: f }
    }

    /// Constructs an empty iterator that immediately yields `None`.
    pub fn empty() -> Iter<T> {
        Iter { next: () => None }
    }

    /// Constructs an iterator that yields `x` once and then `None`.
    pub fn once(x: T) -> Iter<T> {
        var done = false
        fn next() -> T? {
            if done {
                return None
            }
            done = true
            Some(x)
        }
        Iter { next }
    }

    /// Constructs an infinite iterator that yields `x` on every step.
    pub fn repeat(x: T) -> Iter<T> {
        Iter { next: () => Some(x) }
    }

    /// Constructs an iterator starting from `first` where each subsequent
    /// element is computed by applying `f` to the previous element.
    pub fn successors(first: T?, f: fn(T) -> T?) -> Iter<T> {
        var cur = first
        fn next() -> T? {
            let r = cur
            if let Some(x) = r {
                cur = f(x)
            }
            r
        }
        Iter { next }
    }

    /// Applies `f` lazily to each element.
    pub fn map<U>(self, f: fn(T) -> U) -> Iter<U> {
        let next = self.next
        fn step() -> U? {
            match next() {
                Some(x) => Some(f(x))
                None => None
            }
        }
        Iter { next: step }
    }

    /// Yields only the elements for which `f` returns `true`.
    pub fn filter(self, f: fn(T) -> bool) -> Iter<T> {
        let next = self.next
        fn step() -> T? {
            loop {
                let r = next()
                match r {
                    Some(x) => if f(x) {
                        return r
                    }
                    None => return None
                }
            }
        }
        Iter { next: step }
    }

    /// Applies `f` to each element and yields the `Some` results.
    pub fn filter_map<U>(self, f: fn(T) -> U?) -> Iter<U> {
        let next = self.next
        fn step() -> U? {
            while let Some(x) = next() {
                let r = f(x)
                if r.is_some() {
                    return r
                }
            }
            None
        }
        Iter { next: step }
    }

    /// Applies `f` to each element and flattens the resulting iterators in order.
    pub fn flat_map<U>(self, f: fn(T) -> Iter<U>) -> Iter<U> {
        let next = self.next
        var inner: fn() -> U? = () => None
        fn step() -> U? {
            loop {
                let r = inner()
                if r.is_some() {
                    return r
                }
                let Some(x) = next() else { return None }
                inner = f(x).next
            }
        }
        Iter { next: step }
    }

    /// Yields `(index, element)` pairs starting from index `0`.
    pub fn enumerate(self) -> Iter<(int, T)> {
        let next = self.next
        var i = -1
        fn step() -> (int, T)? {
            let x = next()?
            i += 1
            Some((i, x))
        }
        Iter { next: step }
    }

    /// Yields pairs of elements from `self` and `other` until either iterator is exhausted.
    pub fn zip<U>(self, other: Iter<U>) -> Iter<(T, U)> {
        let a = self.next
        let b = other.next
        fn step() -> (T, U)? {
            let x = a()?
            let y = b()?
            Some((x, y))
        }
        Iter { next: step }
    }

    /// Yields all elements of `self` followed by all elements of `other`.
    pub fn chain(self, other: Iter<T>) -> Iter<T> {
        let a = self.next
        let b = other.next
        var first = true
        fn step() -> T? {
            if first {
                let r = a()
                if r.is_some() {
                    return r
                }
                first = false
            }
            b()
        }
        Iter { next: step }
    }

    /// Yields at most the first `n` elements.
    pub fn take(self, n: int) -> Iter<T> {
        let next = self.next
        var left = n
        fn step() -> T? {
            if left <= 0 {
                return None
            }
            left -= 1
            next()
        }
        Iter { next: step }
    }

    /// Skips the first `n` elements and yields the rest.
    pub fn skip(self, n: int) -> Iter<T> {
        let next = self.next
        var left = n
        fn step() -> T? {
            while left > 0 {
                left -= 1
                let _ = next()?
            }
            next()
        }
        Iter { next: step }
    }

    /// Yields elements while `f` returns `true`, stopping at the first `false`.
    pub fn take_while(self, f: fn(T) -> bool) -> Iter<T> {
        let next = self.next
        var done = false
        fn step() -> T? {
            if done {
                return None
            }
            let r = next()
            match r {
                Some(x) if f(x) => r
                _ => {
                    done = true
                    None
                }
            }
        }
        Iter { next: step }
    }

    /// Drops elements while `f` returns `true` and then yields all remaining elements.
    pub fn skip_while(self, f: fn(T) -> bool) -> Iter<T> {
        let next = self.next
        var skipping = true
        fn step() -> T? {
            if skipping {
                skipping = false
                loop {
                    let r = next()
                    match r {
                        Some(x) if f(x) => {}
                        _ => return r
                    }
                }
            }
            next()
        }
        Iter { next: step }
    }

    /// Yields the first element and every `step`-th element thereafter (`step > 0`).
    pub fn step_by(self, step: int) -> Iter<T> {
        if step <= 0 {
            fail("step must be positive, found \(step)", kind: "invalid")
        }
        let next = self.next
        var first = true
        fn advance() -> T? {
            if first {
                first = false
            } else {
                for _ in 1..step {
                    let _ = next()?
                }
            }
            next()
        }
        Iter { next: advance }
    }

    /// Calls `f` on each element before yielding it.
    pub fn inspect(self, f: fn(T)) -> Iter<T> {
        let next = self.next
        fn step() -> T? {
            let r = next()
            if let Some(x) = r {
                f(x)
            }
            r
        }
        Iter { next: step }
    }

    /// Collects all remaining elements into a list.
    pub fn to_list(self) -> [T] {
        let out = []
        for x in self {
            out.push(x)
        }
        out
    }

    /// Collects all remaining elements into a `Set<T>`.
    pub fn to_set(self) -> Set<T> where T: Hash {
        let out: Set<T> = set()
        for x in self {
            out.add(x)
        }
        out
    }

    /// Calls `f` on every remaining element.
    pub fn each(self, f: fn(T)) {
        for x in self {
            f(x)
        }
    }

    /// Folds the remaining elements from left to right starting from `init`.
    pub fn fold<A>(self, init: A, f: fn(A, T) -> A) -> A {
        var acc = init
        for x in self {
            acc = f(acc, x)
        }
        acc
    }

    /// Folds the remaining elements from left to right, or returns `None` if empty.
    pub fn reduce(self, f: fn(T, T) -> T) -> T? {
        var acc = self.next()?
        for x in self {
            acc = f(acc, x)
        }
        Some(acc)
    }

    /// Returns the sum of the remaining elements (`T.zero()` if empty).
    pub fn sum(self) -> T where T: Num {
        var acc = T.zero()
        for x in self {
            acc = acc + x
        }
        acc
    }

    /// Returns the product of the remaining elements (`T.one()` if empty).
    pub fn product(self) -> T where T: Num {
        var acc = T.one()
        for x in self {
            acc = acc * x
        }
        acc
    }

    /// Consumes the iterator and returns the number of remaining elements.
    pub fn count(self) -> int {
        var n = 0
        for _ in self {
            n += 1
        }
        n
    }

    /// Returns `true` if `f` returns `true` for any remaining element, stopping
    /// at the first match.
    pub fn any(self, f: fn(T) -> bool) -> bool {
        for x in self {
            if f(x) {
                return true
            }
        }
        false
    }

    /// Returns `true` if `f` returns `true` for every remaining element,
    /// stopping at the first `false`.
    pub fn all(self, f: fn(T) -> bool) -> bool {
        for x in self {
            if not f(x) {
                return false
            }
        }
        true
    }

    /// Returns the first remaining element for which `f` returns `true`.
    pub fn find(self, f: fn(T) -> bool) -> T? {
        for x in self {
            if f(x) {
                return Some(x)
            }
        }
        None
    }

    /// Returns the 0-based offset of the first remaining element for which `f`
    /// returns `true`.
    pub fn find_index(self, f: fn(T) -> bool) -> int? {
        var i = 0
        for x in self {
            if f(x) {
                return Some(i)
            }
            i += 1
        }
        None
    }

    /// Advances the iterator once and returns the next element.
    pub fn first(self) -> T? {
        self.next()
    }

    /// Consumes the iterator and returns the final element.
    pub fn last(self) -> T? {
        var last = None
        for x in self {
            last = Some(x)
        }
        last
    }

    /// Consumes `n` elements and returns the `n`-th remaining element (0-based).
    pub fn nth(self, n: int) -> T? {
        if n < 0 {
            return None
        }
        self.skip(n).next()
    }

    /// Consumes the iterator and returns the minimum element, or `None` if empty.
    pub fn min(self) -> T? where T: Ord {
        var best = self.next()?
        for x in self {
            if x < best {
                best = x
            }
        }
        Some(best)
    }

    /// Consumes the iterator and returns the maximum element, or `None` if empty.
    pub fn max(self) -> T? where T: Ord {
        var best = self.next()?
        for x in self {
            if x > best {
                best = x
            }
        }
        Some(best)
    }

    /// Consumes the iterator and returns the first element with the minimum
    /// value of `key(element)`.
    pub fn min_by<K: Ord>(self, key: fn(T) -> K) -> T? {
        var best = self.next()?
        var best_key = key(best)
        for x in self {
            let k = key(x)
            if k < best_key {
                best = x
                best_key = k
            }
        }
        Some(best)
    }

    /// Consumes the iterator and returns the first element with the maximum
    /// value of `key(element)`.
    pub fn max_by<K: Ord>(self, key: fn(T) -> K) -> T? {
        var best = self.next()?
        var best_key = key(best)
        for x in self {
            let k = key(x)
            if k > best_key {
                best = x
                best_key = k
            }
        }
        Some(best)
    }
}

impl<T> Iterator<T> for Iter<T> {
    fn next(self) -> T? {
        self.next()
    }

    fn iter(self) -> Iter<T> {
        self
    }
}

extend Iter<int> {
    /// Constructs an infinite arithmetic sequence `start`, `start + step`,
    /// `start + 2 * step`, and so on.
    pub fn count_from(start: int, step: int = 1) -> Iter<int> {
        var i = start
        var started = false
        fn next() -> int? {
            if started {
                i += step
            }
            started = true
            Some(i)
        }
        Iter { next }
    }
}

extend Iter<str> {
    /// Concatenates all remaining strings separated by `sep`.
    pub fn join(self, sep: str = "") -> str {
        self.to_list().join(sep)
    }
}

extend<K: Hash, V> Iter<(K, V)> {
    /// Collects all remaining `(key, value)` pairs into a map (later pairs
    /// overwrite earlier ones for duplicate keys).
    pub fn to_map(self) -> [K: V] {
        let out: [K: V] = [:]
        for (k, v) in self {
            out[k] = v
        }
        out
    }
}
