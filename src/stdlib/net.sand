//! TCP listeners and client connections (including TLS).
//!
//! Outgoing connections require the `Net(host:port)` capability, and listeners
//! require `NetListen(ip:port)`. Open sockets and in-flight connection
//! attempts count toward `max_open_resources` until closed. Bind sockets with
//! `use` to close them at block exit:
//!
//! ```
//! use conn = net.connect("example.com", 80)?
//! conn.write_str("GET / HTTP/1.0\r\n\r\n")?
//! print(conn.read_text()?)
//! ```

import io

/// Binds a TCP listener to `ip` and `port` (such as `"127.0.0.1"` or `"::"`).
/// If `port` is `0`, the operating system assigns an ephemeral port. An IPv6
/// listener accepts only IPv6 connections.
pub native fn listen(ip: str, port: int) -> Result<Listener>

/// Opens a TCP connection to `host` (a hostname or unbracketed IP address) and
/// `port`, or fails with kind `"timeout"` if the connection does not complete
/// within `timeout`.
pub native fn connect(host: str, port: int, timeout: duration = 30s) -> Result<Conn>

/// Opens a TLS-encrypted TCP connection to `host` and `port`, and verifies the
/// server certificate against the bundled Web PKI roots and any custom host
/// roots (requires the `tls` feature). Fails with kind `"timeout"` if the TCP
/// connection and TLS handshake do not complete within `timeout`.
pub native fn connect_tls(host: str, port: int, timeout: duration = 30s) -> Result<Conn>

/// Parses `"host:port"` or `"[ipv6]:port"` into an unbracketed host and port,
/// or fails with kind `"parse"`.
///
/// ```
/// let (host, port) = net.split_host_port("example.com:80")?
/// ```
pub native fn split_host_port(text: str) -> Result<(str, int)>

/// An IP address and port, formatted as `127.0.0.1:8080` or `[::1]:8080`.
pub native type SocketAddr

extend SocketAddr {
    /// Returns the IP address string (such as `"127.0.0.1"` or `"::1"`).
    pub native fn ip(self) -> str
    /// Returns the port number.
    pub native fn port(self) -> int
}

/// A listening TCP socket returned by `listen`.
pub native type Listener

extend Listener {
    /// Waits for and returns the next incoming TCP connection.
    pub native fn accept(self) -> Result<Conn>
    /// Returns the bound local address.
    pub native fn addr(self) -> SocketAddr
}

impl Close for Listener {
    /// Closes the listener. In-flight and subsequent `accept` calls fail with
    /// kind `"closed"`.
    native fn close(self)
}

/// An open TCP or TLS stream connection. Separate tasks can read and write
/// concurrently on the same `Conn`.
pub native type Conn

impl io.Reader for Conn {
    /// Reads up to `max` bytes as soon as data is available (up to the 8 KiB
    /// read buffer), or returns `b""` at end-of-stream.
    native fn read(self, max: int) -> Result<bytes>
    native fn read_line(self) -> Result<str?>
    /// Reads all remaining bytes until the remote peer closes its write half.
    native fn read_all(self) -> Result<bytes>
}

impl io.Writer for Conn {
    native fn write(self, data: bytes) -> Result<()>
    native fn write_str(self, text: str) -> Result<()>
}

impl Close for Conn {
    /// Closes the connection. In-flight and subsequent operations fail with
    /// kind `"closed"`.
    native fn close(self)
}

extend Conn {
    /// Returns the remote peer address.
    pub native fn peer_addr(self) -> SocketAddr
}
