//! Cryptographic digests, HMAC authentication, and constant-time comparison.
//!
//! SHA-1 and MD5 are provided only for legacy interoperability and are not
//! collision-resistant.

/// Returns the 32-byte SHA-256 digest of `data`.
pub native fn sha256(data: bytes) -> bytes

/// Returns the 20-byte SHA-1 digest of `data`.
pub native fn sha1(data: bytes) -> bytes

/// Returns the 32-byte HMAC-SHA256 tag of `data` authenticated with `key`.
pub native fn hmac_sha256(key: bytes, data: bytes) -> bytes

/// Returns the 16-byte MD5 digest of `data`.
pub native fn md5(data: bytes) -> bytes

/// Compares `a` and `b` in time proportional only to their lengths. Use this
/// function to verify MAC tags and secret tokens.
pub native fn constant_time_eq(a: bytes, b: bytes) -> bool
