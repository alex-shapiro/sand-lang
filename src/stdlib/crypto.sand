//! Cryptographic hash functions and message authentication.
//!
//! SHA-1 and MD5 are provided for interoperability only; they are not
//! collision resistant.

/// The SHA-256 digest of `data` (32 bytes).
pub native fn sha256(data: bytes) -> bytes

/// The SHA-1 digest of `data` (20 bytes).
pub native fn sha1(data: bytes) -> bytes

/// HMAC-SHA256 of `data` under `key` (32 bytes).
pub native fn hmac_sha256(key: bytes, data: bytes) -> bytes

/// The MD5 digest of `data` (16 bytes).
pub native fn md5(data: bytes) -> bytes

/// Compares two byte strings in time that depends only on their lengths,
/// not on their contents. Use it to compare MACs and tokens.
pub native fn constant_time_eq(a: bytes, b: bytes) -> bool
