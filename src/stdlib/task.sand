//! Task coordination and timers, always in scope as `task`.

/// Suspends the calling task for duration `d`.
/// A zero or negative duration returns immediately.
pub native fn sleep(d: duration)

/// Yields execution of the calling task so other ready tasks can run.
pub native fn yield_now()

/// Waits for all tasks in `tasks` to finish and returns their results in order.
/// If the caller is cancelled, the tasks keep running.
pub fn all<T>(tasks: [Task<T>]) -> [T] {
    tasks.map(t => t.wait())
}

/// Waits for the first task in `tasks` to finish, cancels the other tasks, and
/// returns the winning result. A cancelled task cannot win. The race continues
/// while another task can finish. If the caller is cancelled, the tasks keep
/// running.
///
/// Aborts in these cases:
///
/// - `"invalid"` if `tasks` is empty.
/// - `"cancelled"` if every task other than the caller is cancelled.
/// - `"deadlock"` if the caller is the only task.
pub native fn race<T>(tasks: [Task<T>]) -> T

/// Runs `f` in a spawned task and returns `Some(result)` if it finishes within
/// duration `d`. Otherwise, cancels the task and returns `None`. If the caller
/// is cancelled, also cancels the task.
pub fn timeout<T>(d: duration, f: fn() -> T) -> T? {
    let work = spawn Some(f())
    let timer = spawn {
        sleep(d)
        None
    }
    defer {
        work.cancel()
        timer.cancel()
    }
    race([work, timer])
}
