//! Task coordination, timers, and channels (always in scope as `task`).

/// Suspends the calling task for duration `d`.
pub native fn sleep(d: duration)

/// Yields execution of the calling task so other ready tasks can run.
pub native fn yield_now()

/// Waits for all tasks in `tasks` to complete and returns their results in order.
pub fn all<T>(tasks: [Task<T>]) -> [T] {
    tasks.map(t => t.wait())
}

/// Waits for the first task in `tasks` to complete, cancels the remaining
/// tasks, and returns the winning result.
pub native fn race<T>(tasks: [Task<T>]) -> T

/// Runs `f` in a spawned task and returns `Some(result)` if it completes within
/// duration `d`, or cancels the task and returns `None`.
pub fn timeout<T>(d: duration, f: fn() -> T) -> T? {
    let work = spawn Some(f())
    let timer = spawn {
        sleep(d)
        None
    }
    race([work, timer])
}

/// Creates a message channel (`capacity == 0` creates an unbounded channel).
pub native fn channel<T>(capacity: int = 0) -> Channel<T>
