//! Process environment variables and command-line arguments.

/// Returns the value of environment variable `name` if it is set and permitted
/// by the `Env(name)` capability, or `None` if unset or denied.
pub native fn get(name: str) -> str?

/// Returns the command-line arguments passed to the script.
pub native fn args() -> [str]

/// Returns all environment variables in a map sorted by variable name if the
/// `Env("*")` capability is granted, or an empty map if denied.
pub native fn vars() -> [str: str]
