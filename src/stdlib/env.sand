//! The script's environment: variables and arguments.

/// The value of environment variable `name`, if it is set and readable.
/// Requires the `Env(name)` capability; a denial yields `None`.
pub native fn get(name: str) -> str?

/// The arguments the host passed to the script.
pub native fn args() -> [str]

/// All environment variables.
/// Requires the `Env("*")` capability; the map is empty if it is denied.
pub native fn vars() -> [str: str]
