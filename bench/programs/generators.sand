// Generator-style streaming: stateful producers (Fibonacci mod m, primes by trial division,
// Collatz sequences, a random stream) composed with merge, moving-sum, chunking and run-length
// transformers into lazy pipelines that are built first and consumed later. Stresses closures
// over captured `var`s, iterator adapters, a user `Iterator` impl and per-element Options.

let FIB_COUNT = 300_000
let WINDOW = 16
let PRIME_LIMIT = 300_000
let CHUNK = 8
let COLLATZ_SEEDS = 12_000
let RANDOM_COUNT = 300_000
let MOD = 1_000_000_007

fn fib_mod(m: int) -> Iter<int> {
    var a = 0
    var b = 1
    Iter.from_fn(() => {
        let x = a
        a = b
        b = (x + b) % m
        Some(x)
    })
}

fn random_stream(seed: int) -> Iter<int> {
    var state = seed
    Iter.from_fn(() => {
        state = (state * 1103515245 + 12345) % 2147483648
        Some(state / 65536)
    })
}

/// Primes in increasing order, each tested by trial division against the primes found so far.
struct Primes {
    found: [int] = []
    var candidate: int = 1
}

impl Iterator<int> for Primes {
    fn next(self) -> int? {
        loop {
            self.candidate += 1
            let n = self.candidate
            if self.found.iter().take_while(p => p * p <= n).all(p => n % p != 0) {
                self.found.push(n)
                return Some(n)
            }
        }
    }
}

fn collatz(seed: int) -> Iter<int> {
    Iter.successors(Some(seed), n => {
        if n == 1 {
            None
        } else if n % 2 == 0 {
            Some(n / 2)
        } else {
            Some(3 * n + 1)
        }
    })
}

/// Merges two ascending streams into one ascending stream.
fn merge(left: Iter<int>, right: Iter<int>) -> Iter<int> {
    var a = left.next()
    var b = right.next()
    Iter.from_fn(() => {
        match (a, b) {
            (Some(x), Some(y)) if x <= y => {
                a = left.next()
                Some(x)
            }
            (_, Some(y)) => {
                b = right.next()
                Some(y)
            }
            (Some(x), None) => {
                a = left.next()
                Some(x)
            }
            (None, None) => None
        }
    })
}

/// Sums of the last `width` elements (fewer at the start).
fn moving_sum(source: Iter<int>, width: int) -> Iter<int> {
    let window = [0; width]
    var i = 0
    var total = 0
    Iter.from_fn(() => {
        let x = source.next()?
        total += x - window[i]
        window[i] = x
        i = (i + 1) % width
        Some(total)
    })
}

fn chunks(source: Iter<int>, size: int) -> Iter<[int]> {
    Iter.from_fn(() => {
        let chunk = source.take(size).to_list()
        if chunk.is_empty() { None } else { Some(chunk) }
    })
}

/// Runs of equal consecutive elements as `(value, length)` pairs.
fn run_lengths(source: Iter<int>) -> Iter<(int, int)> {
    var current = source.next()
    Iter.from_fn(() => {
        let value = current?
        var length = 1
        loop {
            current = source.next()
            if current != Some(value) { break }
            length += 1
        }
        Some((value, length))
    })
}

fn digest(acc: int, x: int) -> int {
    (acc * 31 + x) % MOD
}

fn fibonacci_windows() {
    let sums = moving_sum(fib_mod(1000).take(FIB_COUNT), WINDOW)
    let odd = sums.filter(s => s % 2 == 1)
    let checksum = odd.fold(0, digest)
    let peak = moving_sum(fib_mod(1000).take(FIB_COUNT), WINDOW).enumerate()
        .max_by(p => p.1)
        .unwrap()
    let calm = moving_sum(random_stream(3).map(x => x % 1000), WINDOW)
        .skip(WINDOW)
        .take_while(s => s >= 3300)
        .count()
    print("fib: checksum \(checksum), peak \(peak.1) at \(peak.0), \(calm) random sums above 3300")
}

fn prime_streams() {
    let squares = Iter.count_from(1).map(n => n * n)
    let merged = merge(Primes {}.iter(), squares).take_while(x => x < PRIME_LIMIT)
    let groups = chunks(merged, CHUNK)
    let group_sums = groups.map(g => g.sum())
    let checksum = group_sums.fold(0, digest)
    let pairs = Primes {}.iter().zip(Primes {}.iter().skip(1)).take_while(p => p.1 < PRIME_LIMIT)
    let twins = pairs.filter(p => p.1 - p.0 == 2).count()
    let gaps = Primes {}.iter()
        .take_while(p => p < PRIME_LIMIT)
        .step_by(100)
        .map(p => p % 1000)
    print("primes: merged checksum \(checksum), twins \(twins)")
    print("primes: sampled \(gaps.take(12).to_list())")
}

fn collatz_streams() {
    let lengths = Iter.count_from(1).take(COLLATZ_SEEDS).map(seed => (collatz(seed).count(), seed))
    let (steps, seed) = lengths.max().unwrap()
    let all_values = Iter.count_from(1).take(COLLATZ_SEEDS).flat_map(collatz)
    let checksum = all_values.enumerate()
        .filter(p => p.0 % 7 == 0)
        .map(p => p.1)
        .fold(0, digest)
    let peak = Iter.count_from(1, step: 3).take(COLLATZ_SEEDS / 3).flat_map(collatz).max().unwrap()
    print("collatz: longest \(steps) from \(seed), peak \(peak), checksum \(checksum)")
}

fn random_runs() {
    let symbols = random_stream(42).map(x => x % 3).take(RANDOM_COUNT)
    let tail = random_stream(7).map(x => x % 2).take(RANDOM_COUNT / 10)
    let runs = run_lengths(symbols.chain(tail))
    let histogram = [0; 10]
    var count = 0
    var longest = (0, 0)
    for (value, length) in runs {
        histogram[length.min(9)] += 1
        count += 1
        if length > longest.1 { longest = (value, length) }
    }
    print("runs: \(count) runs, longest \(longest.1) of \(longest.0), histogram \(histogram[1..])")
}

fibonacci_windows()
prime_streams()
collatz_streams()
random_runs()
