// Hand-written JSON parser and serializer: generate a document, then repeatedly parse it
// with a character-by-character recursive-descent parser, walk the tree, encode it back
// and check the round trip. Stresses string scanning, slicing and joining, enum trees,
// Result propagation, map iteration and string building.

let RECORDS = 2000
let ITERATIONS = 3

enum J {
    Null
    Bool(bool)
    Num(float)
    Str(str)
    Arr([J])
    Obj([str: J])
}

struct Rng {
    var state: int

    fn next(self, n: int) -> int {
        self.state = (self.state * 1103515245 + 12345) % 2147483648
        self.state % n
    }
}

let FIRST_NAMES = ["Ada", "Zoë", "José", "Renée", "Linus", "Grace", "Bjørn", "Ming"]
let CITIES = ["Montréal", "São Paulo", "Zürich", "Tokyo", "Berlin", "Lagos", "Kraków"]
let TAGS = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta"]

fn decimal(rng: Rng, max_cents: int) -> str {
    let cents = rng.next(max_cents)
    "\(cents / 100).\(cents % 100:02)"
}

fn record(rng: Rng, id: int) -> str {
    let name = FIRST_NAMES[rng.next(FIRST_NAMES.len())]
    let city = CITIES[rng.next(CITIES.len())]
    let active = if rng.next(2) == 0 { "true" } else { "false" }
    let score = decimal(rng, 100000)
    let balance = decimal(rng, 5000000)
    let rating = decimal(rng, 1000)
    let manager = if rng.next(4) == 0 { "null" } else { rng.next(id + 1).to_str() }
    let tags = ["\"\(TAGS[rng.next(TAGS.len())])\"" for _ in 0..rng.next(4)]
    let lat = decimal(rng, 18000)
    let lon = decimal(rng, 36000)
    let history = []
    for _ in 0..rng.next(5) {
        let ts = 1700000000 + rng.next(10000000)
        let amount = decimal(rng, 100000)
        let ok = if rng.next(3) == 0 { "false" } else { "true" }
        history.push("{\"ts\": \(ts), \"amount\": -\(amount), \"ok\": \(ok)}")
    }
    "  {\"id\": \(id), \"name\": \"\(name) \\\"#\(id)\\\"\", "
        + "\"email\": \"\(name.to_lower()).\(id)@example.com\", \"active\": \(active), "
        + "\"score\": \(score), \"balance\": -\(balance), \"rating\": \(rating)e1, "
        + "\"tags\": [\(tags.join(", "))], "
        + "\"address\": {\"city\": \"\(city)\", \"street\": \"\(rng.next(999) + 1) Rue de l\\u00c9glise\", "
        + "\"geo\": [\(lat), -\(lon)]}, "
        + "\"notes\": \"line one\\nline two\\ttabbed \\\\ path\\/to caf\\u00e9 \\u2603 é\", "
        + "\"manager\": \(manager), \"history\": [\(history.join(", "))]}"
}

fn generate(count: int) -> str {
    let rng = Rng(state: 42)
    "[\n" + [record(rng, i) for i in 0..count].join(",\n") + "\n]\n"
}

struct Parser {
    src: [str]
    var pos: int = 0

    fn parse(text: str) -> Result<J, str> {
        let p = Parser(src: text.chars())
        let value = p.value()?
        p.skip_ws()
        if p.pos < p.src.len() { return Err("trailing characters at \(p.pos)") }
        Ok(value)
    }

    fn skip_ws(self) {
        while self.pos < self.src.len() and self.src[self.pos].is_space() {
            self.pos += 1
        }
    }

    fn next_char(self) -> str {
        if self.pos >= self.src.len() { return "" }
        self.pos += 1
        self.src[self.pos - 1]
    }

    fn expect(self, c: str) -> Result<(), str> {
        self.skip_ws()
        let got = self.next_char()
        if got != c { return Err("expected `\(c)` at \(self.pos), got `\(got)`") }
        Ok(())
    }

    fn value(self) -> Result<J, str> {
        self.skip_ws()
        if self.pos >= self.src.len() { return Err("unexpected end of input") }
        match self.src[self.pos] {
            "{" => self.object()
            "[" => self.array()
            "\"" => Ok(J.Str(self.string()?))
            "t" => self.literal("true", J.Bool(true))
            "f" => self.literal("false", J.Bool(false))
            "n" => self.literal("null", J.Null)
            c if c == "-" or c.is_digit() => self.number()
            c => Err("unexpected `\(c)` at \(self.pos)")
        }
    }

    fn literal(self, word: str, value: J) -> Result<J, str> {
        let end = self.pos + word.len()
        if end > self.src.len() or self.src[self.pos..end].join() != word {
            return Err("invalid literal at \(self.pos)")
        }
        self.pos = end
        Ok(value)
    }

    fn number(self) -> Result<J, str> {
        let start = self.pos
        while self.pos < self.src.len() and is_number_char(self.src[self.pos]) {
            self.pos += 1
        }
        let text = self.src[start..self.pos].join()
        text.parse_float().map(n => J.Num(n)).ok_or("invalid number `\(text)`")
    }

    fn string(self) -> Result<str, str> {
        self.pos += 1
        let parts = []
        var start = self.pos
        while self.pos < self.src.len() {
            match self.src[self.pos] {
                "\"" => {
                    parts.push(self.src[start..self.pos].join())
                    self.pos += 1
                    return Ok(parts.join())
                }
                "\\" => {
                    parts.push(self.src[start..self.pos].join())
                    self.pos += 1
                    parts.push(self.escape()?)
                    start = self.pos
                }
                _ => { self.pos += 1 }
            }
        }
        Err("unterminated string")
    }

    fn escape(self) -> Result<str, str> {
        let c = self.next_char()
        match c {
            "\"" | "\\" | "/" => Ok(c)
            "b" => Ok("\u{8}")
            "f" => Ok("\u{c}")
            "n" => Ok("\n")
            "r" => Ok("\r")
            "t" => Ok("\t")
            "u" => {
                let end = self.pos + 4
                if end > self.src.len() { return Err("truncated \\u escape") }
                let hex = self.src[self.pos..end].join()
                self.pos = end
                hex.parse_int(radix: 16).and_then(n => n.to_char()).ok_or("bad \\u escape `\(hex)`")
            }
            _ => Err("bad escape `\\\(c)` at \(self.pos)")
        }
    }

    fn array(self) -> Result<J, str> {
        self.pos += 1
        let items = []
        self.skip_ws()
        if self.pos < self.src.len() and self.src[self.pos] == "]" {
            self.pos += 1
            return Ok(J.Arr(items))
        }
        loop {
            items.push(self.value()?)
            self.skip_ws()
            match self.next_char() {
                "," => {}
                "]" => return Ok(J.Arr(items))
                c => return Err("expected `,` or `]` at \(self.pos), got `\(c)`")
            }
        }
    }

    fn object(self) -> Result<J, str> {
        self.pos += 1
        let fields: [str: J] = [:]
        self.skip_ws()
        if self.pos < self.src.len() and self.src[self.pos] == "}" {
            self.pos += 1
            return Ok(J.Obj(fields))
        }
        loop {
            self.skip_ws()
            if self.pos >= self.src.len() or self.src[self.pos] != "\"" {
                return Err("expected a key at \(self.pos)")
            }
            let key = self.string()?
            self.expect(":")?
            fields[key] = self.value()?
            self.skip_ws()
            match self.next_char() {
                "," => {}
                "}" => return Ok(J.Obj(fields))
                c => return Err("expected `,` or `}` at \(self.pos), got `\(c)`")
            }
        }
    }
}

fn is_number_char(c: str) -> bool {
    match c {
        "-" | "+" | "." | "e" | "E" => true
        _ => c.is_digit()
    }
}

struct Stats {
    var nulls: int = 0
    var bools: int = 0
    var nums: int = 0
    var strs: int = 0
    var arrs: int = 0
    var objs: int = 0
    var num_sum: float = 0.0
    var str_chars: int = 0
    var max_depth: int = 0

    fn of(value: J) -> Stats {
        let stats = Stats()
        stats.walk(value, 1)
        stats
    }

    fn walk(self, value: J, depth: int) {
        self.max_depth = self.max_depth.max(depth)
        match value {
            Null => { self.nulls += 1 }
            Bool(_) => { self.bools += 1 }
            Num(n) => {
                self.nums += 1
                self.num_sum += n
            }
            Str(s) => {
                self.strs += 1
                self.str_chars += s.char_count()
            }
            Arr(items) => {
                self.arrs += 1
                for item in items { self.walk(item, depth + 1) }
            }
            Obj(fields) => {
                self.objs += 1
                for (key, item) in fields {
                    self.str_chars += key.char_count()
                    self.walk(item, depth + 1)
                }
            }
        }
    }

    fn describe(self) -> str {
        "nulls=\(self.nulls) bools=\(self.bools) nums=\(self.nums) strs=\(self.strs) "
            + "arrs=\(self.arrs) objs=\(self.objs) sum=\(self.num_sum.to_str_fixed(2)) "
            + "chars=\(self.str_chars) depth=\(self.max_depth)"
    }
}

fn encode(value: J) -> str {
    match value {
        Null => "null"
        Bool(b) => if b { "true" } else { "false" }
        Num(n) => encode_num(n)
        Str(s) => encode_str(s)
        Arr(items) => "[" + items.map(encode).join(",") + "]"
        Obj(fields) => "{" + [encode_str(k) + ":" + encode(v) for (k, v) in fields].join(",") + "}"
    }
}

fn encode_num(n: float) -> str {
    if n == n.floor() and n.abs() < 1e15 { n.to_int().to_str() } else { n.to_str_fixed(2) }
}

fn encode_str(s: str) -> str {
    "\"" + s.chars().map(escape_char).join() + "\""
}

fn escape_char(c: str) -> str {
    match c {
        "\"" => "\\\""
        "\\" => "\\\\"
        "\n" => "\\n"
        "\r" => "\\r"
        "\t" => "\\t"
        _ if c.ord() < 0x20 => "\\u\(c.ord():04x)"
        _ => c
    }
}

let text = generate(RECORDS)
print("document: \(text.char_count()) chars")

var total_chars = 0
for i in 0..ITERATIONS {
    let tree = Parser.parse(text)?
    let stats = Stats.of(tree)
    let out = encode(tree)
    let again = Parser.parse(out)?
    assert(encode(again) == out, "round trip changed the text")
    assert(Stats.of(again) == stats, "round trip changed the stats")
    total_chars += out.char_count()
    if i == 0 {
        print(stats.describe())
        let Arr(records) = tree else { fail("expected an array") }
        print(encode(records[0]))
    }
}
print("encoded \(ITERATIONS) times, \(total_chars) chars")
