// Sparse graph analytics over large integer node ids, as when processing an
// edge list exported from a database: connected components, degree histogram
// and a topological sort. Stresses int-keyed maps, sets and list-as-queue BFS.

let NODES = 200_000
let EDGES = 500_000
let CLUSTER = 25
let MOD = 1_000_000_007

struct Rng {
    var state: int

    fn next(self, bound: int) -> int {
        self.state = (self.state * 1103515245 + 12345) % 2147483648
        self.state * bound / 2147483648
    }
}

/// Sizes of the connected components, in order of their first node in `ids`.
fn component_sizes(ids: [int], adj: [int: [int]]) -> [int] {
    let visited: Set<int> = Set()
    let sizes = []
    for id in ids {
        if not visited.add(id) { continue }
        let queue = [id]
        var head = 0
        while head < queue.len() {
            let u = queue[head]
            head += 1
            for v in adj[u] {
                if visited.add(v) { queue.push(v) }
            }
        }
        sizes.push(queue.len())
    }
    sizes
}

fn degree_histogram(adj: [int: [int]]) -> [int: int] {
    let hist: [int: int] = [:]
    for (_, neighbors) in adj {
        hist[neighbors.len()] = hist.get_or(neighbors.len(), 0) + 1
    }
    hist
}

/// Kahn's algorithm on the DAG that orients every edge from the smaller id to
/// the larger; ties in the initial queue are broken by id.
fn topological_order(ids: [int], edges: [(int, int)]) -> [int] {
    let successors: [int: [int]] = [:]
    let in_degree: [int: int] = [id: 0 for id in ids]
    for (a, b) in edges {
        let (low, high) = if a < b { (a, b) } else { (b, a) }
        successors.get_or_insert(low, []).push(high)
        in_degree[high] += 1
    }
    let order = in_degree.entries().filter_map(e => if e.1 == 0 {
        Some(e.0)
    } else {
        None
    }).sorted()
    var head = 0
    while head < order.len() {
        let u = order[head]
        head += 1
        let Some(next) = successors.get(u) else { continue }
        for v in next {
            in_degree[v] -= 1
            if in_degree[v] == 0 { order.push(v) }
        }
    }
    order
}

let rng = Rng(state: 7)
let ids = [rng.next(1_000_000_000) for _ in 0..NODES]
let adj: [int: [int]] = [id: [] for id in ids]
let edges: [(int, int)] = []
for _ in 0..EDGES {
    let i = rng.next(NODES)
    let j = if rng.next(1000) < 5 {
        rng.next(NODES)
    } else {
        i / CLUSTER * CLUSTER + rng.next(CLUSTER)
    }
    let (a, b) = (ids[i], ids[j])
    if a == b { continue }
    adj[a].push(b)
    adj[b].push(a)
    edges.push((a, b))
}
print("nodes \(adj.len()), edges \(edges.len())")

let sizes = component_sizes(ids, adj)
let largest = sizes.sorted_by(s => -s).take(5).map(s => s.to_str()).join(" ")
print("components \(sizes.len()), largest \(largest)")

let hist = degree_histogram(adj)
for degree in 1..=10 {
    print("degree \(degree): \(hist.get_or(degree, 0))")
}

let order = topological_order(ids, edges)
var checksum = 0
for (position, id) in order.enumerate() {
    checksum = (checksum + position * id) % MOD
}
print("topological order \(order.len()), checksum \(checksum)")
